@page "/contracts"
@page "/contratos"
@attribute [Authorize]
@inject ISender Sender
@inject NavigationManager Navigation
@inject IMessageService MessageService

<div class="contracts-list-view step-fade-in">
    <!-- Hero Header -->
    <SoftHeroHeader Title="Gestión de Contratos y Pedidos"
                    Subtitle="Control de separación de mercancía (plan separe), reparaciones de taller y fabricación de joyas"
                    Icon="bi bi-file-earmark-text">
        <SoftButton Icon="reload" OnClick="LoadContracts">Actualizar</SoftButton>
        <SoftButton Type="@ButtonType.Primary" Icon="plus" OnClick="OpenCreateDrawer">Nuevo Contrato</SoftButton>
    </SoftHeroHeader>

    <!-- Metrics Summary -->
    <div class="metrics-grid mb-3">
        <div class="metric-card">
            <div class="metric-icon bg-blue-subtle">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <div class="metric-content">
                <span class="metric-label">Total Contratos</span>
                <span class="metric-value">@_contracts.Count</span>
                <span class="metric-subtext">Histórico registrado</span>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon bg-purple-subtle">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <div class="metric-content">
                <span class="metric-label">Total Contratado</span>
                <span class="metric-value tabular-nums">@_contracts.Sum(x => (long)x.Value).ToString("C0")</span>
                <span class="metric-subtext">Valor acumulado</span>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon bg-rose-subtle">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="metric-content">
                <span class="metric-label">Saldo Pendiente</span>
                <span class="metric-value tabular-nums text-danger">@_contracts.Sum(x => (long)x.Balance).ToString("C0")</span>
                <span class="metric-subtext">Por recaudar</span>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon bg-amber-subtle">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="metric-content">
                <span class="metric-label">Por Entregar</span>
                <span class="metric-value">@_contracts.Count(x => x.State != ContractState.Entregado)</span>
                <span class="metric-subtext">En taller o por reclamar</span>
            </div>
        </div>
    </div>

    <!-- Filters Card -->
    <SoftFilterCard>
        <div class="row g-3 align-items-center">
            <div class="col-12 col-lg-5">
                <div class="d-flex align-items-center gap-1">
                    <Input Placeholder="Buscar por número, titular, tipo o descripción..."
                           @bind-Value="_searchTerm"
                           AllowClear="true"
                           PrefixIcon="search" />
                    <SoftVoiceButton @bind-TargetText="_searchTerm"
                                     Append="false"
                                     TooltipText="Buscar contratos por voz"
                                     ButtonClass="btn-outline-secondary" />
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <RadioGroup @bind-Value="_stateFilter" ButtonStyle="@RadioButtonStyle.Solid">
                    <Radio RadioButton="true" Value="@("ALL")">Todos</Radio>
                    <Radio RadioButton="true" Value="@("Registrado")">Registrado</Radio>
                    <Radio RadioButton="true" Value="@("Asignado")">En Taller</Radio>
                    <Radio RadioButton="true" Value="@("Recibido")">Listo</Radio>
                    <Radio RadioButton="true" Value="@("Entregado")">Entregado</Radio>
                </RadioGroup>
            </div>
            <div class="col-12 col-lg-2 text-lg-end">
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                    <i class="bi bi-funnel me-1"></i> <b>@FilteredContracts.Count</b> contratos
                </span>
            </div>
        </div>
    </SoftFilterCard>

    <!-- Data Table / Loading / Empty -->
    @if (_isLoading)
    {
        <div class="soft-card p-5 text-center">
            <Spin Tip="Cargando contratos..." />
        </div>
    }
    else if (!FilteredContracts.Any())
    {
        <SoftResultView Status="@ResultStatus.Info"
                        Title="No se encontraron contratos"
                        Subtitle="No hay contratos que coincidan con los criterios de búsqueda.">
            <SoftButton Type="@ButtonType.Primary" Icon="plus" OnClick="OpenCreateDrawer">
                Registrar Primer Contrato
            </SoftButton>
        </SoftResultView>
    }
    else
    {
        <div class="soft-card overflow-hidden">
            <Table TItem="ContractDto"
                   DataSource="@FilteredContracts"
                   Responsive="true"
                   Size="@TableSize.Middle">
                <PropertyColumn Property="c => c.Number" Title="Nro. Contrato" Width="120px">
                    <span class="fw-bold text-dark">#@context.Number</span>
                </PropertyColumn>
                <PropertyColumn Property="c => c.Reference" Title="Modalidad / Ref." Width="160px">
                    @if (context.Reference.HasValue && context.Reference.Value > 0)
                    {
                        <span class="pill-badge badge-soft-primary">
                            <i class="bi bi-box-seam"></i> Separe #@context.Reference
                        </span>
                    }
                    else if (context.Weight > 0)
                    {
                        <span class="pill-badge badge-soft-warning">
                            <i class="bi bi-gem"></i> Hechura (@context.Weight g)
                        </span>
                    }
                    else
                    {
                        <span class="pill-badge badge-soft-purple">
                            <i class="bi bi-tools"></i> Reparación
                        </span>
                    }
                </PropertyColumn>
                <PropertyColumn Property="c => c.PersonId" Title="Titular / Cliente" Width="210px">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-circle avatar-blue">@GetInitials(GetCustomerName(context.PersonId))</div>
                        <div class="d-flex flex-column" style="min-width: 0;">
                            <span class="fw-semibold text-truncate text-dark" title="@GetCustomerName(context.PersonId)">
                                @GetCustomerName(context.PersonId)
                            </span>
                        </div>
                    </div>
                </PropertyColumn>
                <PropertyColumn Property="c => c.Description" Title="Descripción del Trabajo / Mercancía" Ellipsis="true">
                    <span class="text-secondary">@context.Description</span>
                </PropertyColumn>
                <PropertyColumn Property="c => c.Value" Title="Valor Total" Width="135px" Align="ColumnAlign.Right">
                    <span class="fw-bold tabular-nums text-dark">@context.Value.ToString("C0")</span>
                </PropertyColumn>
                <PropertyColumn Property="c => c.Balance" Title="Saldo Pendiente" Width="140px" Align="ColumnAlign.Right">
                    @if (context.Balance > 0)
                    {
                        <span class="tabular-nums text-danger fw-bold">@context.Balance.ToString("C0")</span>
                    }
                    else
                    {
                        <span class="pill-badge badge-soft-success">
                            <i class="bi bi-check2"></i> Al Día
                        </span>
                    }
                </PropertyColumn>
                <PropertyColumn Property="c => c.DeliveryDate" Title="Fecha Entrega" Width="120px" Align="ColumnAlign.Center">
                    <span class="tabular-nums small text-muted">
                        <i class="bi bi-calendar3 me-1"></i>@context.DeliveryDate.ToString("dd/MM/yyyy")
                    </span>
                </PropertyColumn>
                <PropertyColumn Property="c => c.State" Title="Estado" Width="130px" Align="ColumnAlign.Center">
                    @switch (context.State)
                    {
                        case ContractState.Registrado:
                            <span class="pill-badge badge-soft-primary"><i class="bi bi-clock"></i> Registrado</span>
                            break;
                        case ContractState.Asignado:
                            <span class="pill-badge badge-soft-warning"><i class="bi bi-gear"></i> En Taller</span>
                            break;
                        case ContractState.Recibido:
                            <span class="pill-badge badge-soft-success"><i class="bi bi-check2-circle"></i> Listo</span>
                            break;
                        case ContractState.Entregado:
                            <span class="pill-badge badge-soft-purple"><i class="bi bi-box2-fill"></i> Entregado</span>
                            break;
                        default:
                            <span class="pill-badge badge-soft-primary">@context.State</span>
                            break;
                    }
                </PropertyColumn>
                <ActionColumn Title="Acción" Width="80px" Align="ColumnAlign.Center">
                    <SoftActionButton Icon="eye"
                                      TooltipText="Ver Detalle y Abonos"
                                      OnClick="@(() => Navigation.NavigateTo($"/contracts/{context.Id}"))" />
                </ActionColumn>
            </Table>
        </div>
    }

    <!-- SoftDrawer: Registrar Nuevo Contrato -->
    <SoftDrawer Visible="@_drawerVisible"
                Title="Registrar Nuevo Contrato"
                Description="Plan separe de mercancía en inventario, reparación de taller o fabricación de joya"
                Width="720"
                OnClose="CloseDrawer">
        <ChildContent>
            <Form Model="@_formModel" Layout="@FormLayout.Vertical">
                <!-- Selector de Propósito del Contrato -->
                <SoftFormBox Title="Modalidad del Pedido o Contrato">
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-4">
                            <div class="quick-choice-card text-center @(_formModel.ContractKind == "SEPARE" ? "active" : "")"
                                 @onclick='() => _formModel.ContractKind = "SEPARE"'>
                                <div class="choice-icon bg-blue-subtle">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                                <div class="choice-title">Plan Separe</div>
                                <div class="choice-desc">Apartar una joya o reloj existente en inventario</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="quick-choice-card text-center @(_formModel.ContractKind == "REPARACION" ? "active" : "")"
                                 @onclick='() => _formModel.ContractKind = "REPARACION"'>
                                <div class="choice-icon bg-purple-subtle">
                                    <i class="bi bi-tools"></i>
                                </div>
                                <div class="choice-title">Reparación</div>
                                <div class="choice-desc">Ajuste, compostura o mantenimiento en taller</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="quick-choice-card text-center @(_formModel.ContractKind == "FABRICACION" ? "active" : "")"
                                 @onclick='() => _formModel.ContractKind = "FABRICACION"'>
                                <div class="choice-icon bg-amber-subtle">
                                    <i class="bi bi-gem"></i>
                                </div>
                                <div class="choice-title">Fabricación</div>
                                <div class="choice-desc">Hechura nueva en oro/plata sobre medida</div>
                            </div>
                        </div>
                    </div>
                </SoftFormBox>

                <!-- Step 1: Titular -->
                <StepLabel Number="1" Text="Información del Cliente / Titular" IsActive="true" />
                <SoftFormBox Title="Identificación del Titular">
                    @if (_formModel.CustomerId > 0)
                    {
                        <div class="p-2 mb-3 rounded-3 bg-success-subtle border border-success-subtle d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle avatar-emerald">@GetInitials(_formModel.CustomerFullName)</div>
                                <div>
                                    <span class="fw-bold text-success d-block"><i class="bi bi-patch-check-fill me-1"></i>Cliente en Directorio</span>
                                    <span class="small text-dark">@_formModel.CustomerFullName &bull; C.C. @_formModel.IdentificationNumber</span>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted" @onclick="ResetCustomerSearch">
                                <i class="bi bi-x-circle me-1"></i>Cambiar
                            </button>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <FormItem Label="Tipo Documento" Required="true">
                                <Select TItem="JewerlySystem.Modules.Customers.Application.DTOs.IdentificationTypeDto"
                                        TItemValue="int"
                                        @bind-Value="_formModel.IdentificationTypeId"
                                        DataSource="@_idTypes"
                                        LabelName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.IdentificationTypeDto.Name)"
                                        ValueName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.IdentificationTypeDto.Id)"
                                        EnableSearch="true" />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-5">
                            <FormItem Label="Número de Documento" Required="true">
                                <Input @bind-Value="_formModel.IdentificationNumber"
                                       Placeholder="Ingrese documento..." />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-3 d-flex align-items-end mb-4">
                            <SoftButton Icon="search" OnClick="SearchCustomerByIdentificationAsync">Buscar</SoftButton>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <FormItem Label="Nombre Completo" Required="true">
                                <Input @bind-Value="_formModel.CustomerFullName" Placeholder="Nombre y apellidos" />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-6">
                            <FormItem Label="Teléfono / Celular">
                                <Input @bind-Value="_formModel.CustomerCellPhone" Placeholder="Ej: 3001234567" />
                            </FormItem>
                        </div>
                    </div>
                </SoftFormBox>

                <!-- Step 2: Especificaciones del Pedido -->
                <StepLabel Number="2" Text="Especificaciones del Trabajo o Mercancía" IsActive="true" />
                <SoftFormBox Title="@(_formModel.ContractKind == "SEPARE" ? "Artículo Separado de Inventario" : "Detalles de la Joya y Trabajo")">
                    <div class="row g-3">
                        @if (_formModel.ContractKind == "SEPARE")
                        {
                            <div class="col-12 col-md-4">
                                <FormItem Label="Referencia en Inventario">
                                    <AntDesign.InputNumber @bind-Value="_formModel.Reference"
                                                           Placeholder="Ref. de vitrina"
                                                           Class="w-100" />
                                </FormItem>
                            </div>
                        }

                        @if (_formModel.ContractKind != "SEPARE")
                        {
                            <div class="col-12 col-md-4">
                                <FormItem Label="Peso en Oro/Metal (g)">
                                    <AntDesign.InputNumber @bind-Value="_formModel.Weight"
                                                           Min="0.0"
                                                           Step="0.1"
                                                           Class="w-100" />
                                </FormItem>
                            </div>
                            <div class="col-12 col-md-8">
                                <FormItem Label="Taller u Orfebre Asignado (Opcional)">
                                    <Select TItem="JewerlySystem.Modules.Customers.Application.DTOs.PersonDto"
                                            TItemValue="int?"
                                            DataSource="@_workshops"
                                            @bind-Value="_formModel.ProviderId"
                                            ValueName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.Id)"
                                            LabelName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.FullName)"
                                            EnableSearch="true"
                                            Placeholder="-- Seleccione Taller / Joyero --"
                                            AllowClear="true" />
                                </FormItem>
                            </div>
                        }

                        <div class="col-12">
                            <SoftVoiceTextArea @bind-Value="_formModel.Description"
                                               Label="Descripción del Trabajo o Joya"
                                               Required="true"
                                               Placeholder="@(_formModel.ContractKind == "SEPARE"
                                                   ? "Detalle de la joya separada de vitrina o pulse 'Dictar por Voz'..."
                                                   : (_formModel.ContractKind == "REPARACION"
                                                       ? "Describa el daño y reparación a realizar o pulse 'Dictar por Voz'..."
                                                       : "Especifique el diseño a fabricar o pulse 'Dictar por Voz'..."))" />
                        </div>
                    </div>
                </SoftFormBox>

                <!-- Step 3: Valores Económicos y Abono -->
                <StepLabel Number="3" Text="Valores Económicos y Liquidación" IsActive="true" />
                <SoftFormBox Title="Condiciones de Pago y Entrega">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <FormItem Label="Valor Total Contratado ($)" Required="true">
                                <AntDesign.InputNumber @bind-Value="_formModel.Value"
                                                       Min="1000"
                                                       Step="10000"
                                                       Class="w-100" />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-4">
                            <FormItem Label="Abono Inicial ($)">
                                <AntDesign.InputNumber @bind-Value="_formModel.InitialPayment"
                                                       Min="0"
                                                       Step="10000"
                                                       Class="w-100" />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-4">
                            <FormItem Label="Medio de Pago del Abono">
                                <Select TItem="PaymentMethodOption"
                                        TItemValue="PaymentMethod"
                                        DataSource="@_paymentMethodOptions"
                                        @bind-Value="_formModel.PaymentMethod"
                                        ValueName="@nameof(PaymentMethodOption.Value)"
                                        EnableSearch="true"
                                        LabelName="@nameof(PaymentMethodOption.Label)" />
                            </FormItem>
                        </div>
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-6">
                            <FormItem Label="Fecha Prometida de Entrega">
                                <DatePicker @bind-Value="_formModel.DeliveryDate" Format="dd/MM/yyyy" Class="w-100" />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-6 mb-4">
                            <span class="small text-muted fw-bold d-block mb-1">Plazo Rápido:</span>
                            <div class="d-flex gap-1 flex-wrap">
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-1" @onclick="() => SetDeliveryDays(15)">+15 días (Estándar)</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-1" @onclick="() => SetDeliveryDays(30)">+30 días</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-1" @onclick="() => SetDeliveryDays(45)">+45 días</button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <SoftDetailCard Title="Resumen de Liquidación del Contrato">
                            <div class="row g-2 text-center">
                                <div class="col-4">
                                    <SoftDetailItem Label="Valor Total" Value="@_formModel.Value.ToString("C0")" />
                                </div>
                                <div class="col-4">
                                    <SoftDetailItem Label="Abono Inicial" Value="@_formModel.InitialPayment.ToString("C0")" />
                                </div>
                                <div class="col-4">
                                    <SoftDetailItem Label="Saldo Pendiente"
                                                    Value="@Math.Max(0, _formModel.Value - _formModel.InitialPayment).ToString("C0")"
                                                    HighlightVariant="@(_formModel.Value - _formModel.InitialPayment > 0 ? SoftDetailItem.Variant.Danger : SoftDetailItem.Variant.Success)" />
                                </div>
                            </div>

                            @{
                                int percentPaid = _formModel.Value > 0 ? Math.Min(100, (int)((double)_formModel.InitialPayment / _formModel.Value * 100)) : 0;
                            }
                            <div class="mt-3 pt-2 border-top">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Porcentaje abonado: <b class="text-success">@percentPaid%</b></span>
                                    <span>Porcentaje pendiente: <b class="text-danger">@((100 - percentPaid))%</b></span>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 4px; background: #e2e8f0;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @percentPaid%; border-radius: 4px;" aria-valuenow="@percentPaid" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </SoftDetailCard>
                    </div>
                </SoftFormBox>
            </Form>
        </ChildContent>
        <FooterContent>
            <SoftButton OnClick="CloseDrawer">Cancelar</SoftButton>
            <SoftButton Type="@ButtonType.Primary"
                        Loading="@_isSubmitting"
                        OnClick="HandleCreateContractAsync">
                Guardar y Generar Contrato
            </SoftButton>
        </FooterContent>
    </SoftDrawer>
</div>

@code {
    private List<ContractDto> _contracts = new();
    private List<JewerlySystem.Modules.Customers.Application.DTOs.PersonDto> _customers = new();
    private List<JewerlySystem.Modules.Customers.Application.DTOs.PersonDto> _workshops = new();
    private List<JewerlySystem.Modules.Customers.Application.DTOs.IdentificationTypeDto> _idTypes = new();
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private string _stateFilter = "ALL";

    // Drawer state
    private bool _drawerVisible;
    private bool _isSubmitting;
    private CreateContractFormModel _formModel = new();

    public class PaymentMethodOption
    {
        public PaymentMethod Value { get; set; }
        public string Label { get; set; } = string.Empty;
    }

    private readonly List<PaymentMethodOption> _paymentMethodOptions = new()
    {
        new() { Value = PaymentMethod.EFECTIVO, Label = "Efectivo" },
        new() { Value = PaymentMethod.TRANSFERENCIA, Label = "Transferencia Bancaria" },
        new() { Value = PaymentMethod.TARJETA_DEBITO, Label = "Tarjeta Débito" },
        new() { Value = PaymentMethod.TARJETA_CREDITO, Label = "Tarjeta Crédito" },
        new() { Value = PaymentMethod.ORO, Label = "ORO (Canje / Metal)" }
    };

    private string GetCustomerName(int personId)
    {
        return _customers.FirstOrDefault(c => c.Id == personId)?.FullName ?? $"Cliente #{personId}";
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0][..1].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private void ResetCustomerSearch()
    {
        _formModel.CustomerId = 0;
        _formModel.CustomerFullName = string.Empty;
        _formModel.CustomerCellPhone = string.Empty;
        _formModel.IdentificationNumber = string.Empty;
    }

    private void SetDeliveryDays(int days)
    {
        _formModel.DeliveryDate = DateTime.Today.AddDays(days);
    }

    private List<ContractDto> FilteredContracts => _contracts
        .Where(c => _stateFilter == "ALL" || c.State.ToString() == _stateFilter)
        .Where(c => string.IsNullOrWhiteSpace(_searchTerm)
            || c.Number.ToString().Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || (c.Reference.HasValue && c.Reference.Value.ToString().Contains(_searchTerm))
            || c.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || GetCustomerName(c.PersonId).Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
        await LoadWorkshops();
        await LoadContracts();
        await LoadIdentificationTypes();
    }

    private async Task LoadCustomers()
    {
        var res = await Sender.Send(new JewerlySystem.Modules.Customers.Application.Queries.GetCustomersListQuery());
        if (res.IsSuccess)
        {
            _customers = res.Value;
        }
    }

    private async Task LoadWorkshops()
    {
        var res = await Sender.Send(new JewerlySystem.Modules.Customers.Application.Queries.GetCustomersListQuery(JewerlySystem.Modules.Customers.Domain.PersonType.Proveedor));
        if (res.IsSuccess)
        {
            _workshops = res.Value;
        }
    }

    private async Task LoadContracts()
    {
        _isLoading = true;
        try
        {
            var res = await Sender.Send(new GetContractsListQuery());
            if (res.IsSuccess)
            {
                _contracts = res.Value;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadIdentificationTypes()
    {
        var idRes = await Sender.Send(new JewerlySystem.Modules.Customers.Application.Queries.GetIdentificationTypesQuery());
        if (idRes.IsSuccess)
        {
            _idTypes = idRes.Value;
            if (_idTypes.Any() && _formModel.IdentificationTypeId == 0)
            {
                _formModel.IdentificationTypeId = _idTypes.First().Id;
            }
        }
    }

    private void OpenCreateDrawer()
    {
        _formModel = new CreateContractFormModel
        {
            IdentificationTypeId = _idTypes.FirstOrDefault()?.Id ?? 1,
            DeliveryDate = DateTime.Today.AddDays(15),
            ContractKind = "SEPARE"
        };
        _drawerVisible = true;
    }

    private void CloseDrawer()
    {
        _drawerVisible = false;
    }

    private async Task SearchCustomerByIdentificationAsync()
    {
        if (string.IsNullOrWhiteSpace(_formModel.IdentificationNumber))
        {
            MessageService.Warning("Ingrese un número de documento para buscar.");
            return;
        }

        var res = await Sender.Send(new JewerlySystem.Modules.Customers.Application.Queries.GetCustomerByIdentificationQuery(_formModel.IdentificationNumber.Trim()));
        if (res.IsSuccess && res.Value != null)
        {
            _formModel.CustomerId = res.Value.Id;
            _formModel.CustomerFullName = res.Value.FullName;
            _formModel.CustomerCellPhone = res.Value.CellPhone;
            _formModel.IdentificationTypeId = res.Value.IdentificationTypeId;
            MessageService.Success($"Cliente encontrado: {res.Value.FullName}");
        }
        else
        {
            _formModel.CustomerId = 0;
            MessageService.Info("Cliente nuevo. Complete los datos para crearlo automáticamente.");
        }
    }

    private async Task HandleCreateContractAsync()
    {
        if (string.IsNullOrWhiteSpace(_formModel.CustomerFullName))
        {
            MessageService.Error("El nombre del cliente es obligatorio.");
            return;
        }
        if (string.IsNullOrWhiteSpace(_formModel.IdentificationNumber))
        {
            MessageService.Error("El número de documento es obligatorio.");
            return;
        }
        if (string.IsNullOrWhiteSpace(_formModel.Description))
        {
            MessageService.Error("La descripción del trabajo o mercancía es obligatoria.");
            return;
        }
        if (_formModel.Value <= 0)
        {
            MessageService.Error("El valor total del contrato debe ser mayor a 0.");
            return;
        }

        _isSubmitting = true;
        try
        {
            int customerId = _formModel.CustomerId;
            if (customerId <= 0)
            {
                var createCustCmd = new JewerlySystem.Modules.Customers.Application.Commands.CreateCustomerCommand(
                    IdentificationTypeId: _formModel.IdentificationTypeId,
                    IdentificationNumber: _formModel.IdentificationNumber.Trim(),
                    FullName: _formModel.CustomerFullName.Trim(),
                    CellPhone: _formModel.CustomerCellPhone?.Trim() ?? string.Empty,
                    Email: string.Empty,
                    PersonType: JewerlySystem.Modules.Customers.Domain.PersonType.Cliente
                );
                var custResult = await Sender.Send(createCustCmd);
                if (!custResult.IsSuccess)
                {
                    MessageService.Error(custResult.Error.Message);
                    return;
                }
                customerId = custResult.Value;
            }

            var cmd = new CreateContractCommand(
                Reference: _formModel.ContractKind == "SEPARE" ? _formModel.Reference : null,
                Date: DateTime.Today,
                DeliveryDate: _formModel.DeliveryDate,
                Value: _formModel.Value,
                Weight: _formModel.Weight,
                Description: _formModel.Description.Trim(),
                PersonId: customerId,
                ProviderId: _formModel.ProviderId,
                FatherId: null,
                InitialPayment: _formModel.InitialPayment > 0 ? _formModel.InitialPayment : null,
                PaymentMethod: _formModel.PaymentMethod
            );

            var result = await Sender.Send(cmd);
            if (result.IsSuccess)
            {
                MessageService.Success($"¡Contrato #{result.Value} registrado exitosamente!");
                _drawerVisible = false;
                await LoadCustomers();
                await LoadContracts();
            }
            else
            {
                MessageService.Error(result.Error.Message);
            }
        }
        catch (Exception ex)
        {
            MessageService.Error($"Ocurrió un error: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class CreateContractFormModel
    {
        public string ContractKind { get; set; } = "SEPARE"; // SEPARE, REPARACION, FABRICACION
        public int CustomerId { get; set; }
        public int IdentificationTypeId { get; set; }
        public string IdentificationNumber { get; set; } = string.Empty;
        public string CustomerFullName { get; set; } = string.Empty;
        public string? CustomerCellPhone { get; set; }

        public int? Reference { get; set; }
        public double Weight { get; set; } = 0.0;
        public int? ProviderId { get; set; }
        public string Description { get; set; } = string.Empty;

        public int Value { get; set; } = 250000;
        public int InitialPayment { get; set; } = 50000;
        public PaymentMethod PaymentMethod { get; set; } = PaymentMethod.EFECTIVO;
        public DateTime DeliveryDate { get; set; } = DateTime.Today.AddDays(15);
    }
}

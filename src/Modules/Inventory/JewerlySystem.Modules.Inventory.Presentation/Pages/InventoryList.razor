@page "/inventory"
@page "/jewelry"
@page "/watches"
@attribute [Authorize]
@inject ISender Sender
@inject NavigationManager Navigation
@inject IMessageService Message
@inject ModalService ModalService

<div class="inventory-container step-fade-in">
    <!-- Hero Header con Selector de Grupos Unificado -->
    <SoftHeroHeader Title="@(_activeGroup == "JEWELRY" ? "Catálogo de Joyería" : "Catálogo de Relojería")"
                    Subtitle="@(_activeGroup == "JEWELRY" ? "Control de metales preciosos, pesajes y stock activo" : "Control de alta gama, marcas y seriales")"
                    Icon="@(_activeGroup == "JEWELRY" ? "bi bi-gem" : "bi bi-watch")">
        <div class="header-group-switcher me-1 me-lg-2">
            <RadioGroup @bind-Value="_activeGroup" ButtonStyle="@RadioButtonStyle.Solid">
                <Radio RadioButton="true" Value="@("JEWELRY")">
                    <span><i class="bi bi-gem me-1 text-warning"></i> <b>Joyería</b> (@_jewelryItems.Count(x => x.Active)/@_jewelryItems.Count)</span>
                </Radio>
                <Radio RadioButton="true" Value="@("WATCHES")">
                    <span><i class="bi bi-watch me-1 text-primary"></i> <b>Relojes</b> (@_watchItems.Count(x => x.Active)/@_watchItems.Count)</span>
                </Radio>
            </RadioGroup>
        </div>

        <SoftButton Text="Consolidado"
                    Icon="pie-chart"
                    Type="ButtonType.Dashed"
                    OnClick="@(() => Navigation.NavigateTo("/inventory/consolidated"))" />
        <SoftButton Text="Descargar"
                    Icon="export"
                    Danger="true"
                    Type="ButtonType.Default"
                    OnClick="@(() => Navigation.NavigateTo("/inventory/discharge"))" />
    </SoftHeroHeader>

    @if (_activeGroup == "JEWELRY")
    {
        <!-- Métricas del Grupo Joyería -->
        <div class="metrics-grid mb-2">
            <div class="metric-card">
                <div class="metric-icon bg-warning-subtle text-warning">
                    <i class="bi bi-gem"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Joyas Disponibles</span>
                    <span class="metric-value">@_jewelryItems.Count(x => x.Active)</span>
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-icon bg-blue-subtle text-primary">
                    <i class="bi bi-speedometer2"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Peso Total en Stock</span>
                    <span class="metric-value">@(_jewelryItems.Where(x => x.Active).Sum(x => x.Weight).ToString("F1")) g</span>
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-icon bg-secondary-subtle text-danger">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Inversión Costo Joyas</span>
                    <span class="metric-value">@_jewelryItems.Where(x => x.Active).Sum(x => (long)x.CostValue).ToString("C0")</span>
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-icon bg-info-subtle text-success">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Venta Sugerida Total</span>
                    <span class="metric-value">@_jewelryItems.Where(x => x.Active).Sum(x => (long)(x.SaleValue ?? (int)(x.CostValue * 1.3))).ToString("C0")</span>
                </div>
            </div>
        </div>

        <!-- Barra de Búsqueda y Filtros Joyería -->
        <SoftFilterCard>
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="d-flex align-items-center gap-1">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="Buscar joya por ref (#), tipo (anillo, cadena) o descripción..."
                                   value="@_searchJewelryTerm"
                                   @oninput="OnJewelrySearchInput" />
                            @if (!string.IsNullOrWhiteSpace(_searchJewelryTerm))
                            {
                                <button class="btn btn-outline-secondary border-start-0 bg-white text-muted"
                                        type="button"
                                        title="Limpiar búsqueda"
                                        @onclick="ClearJewelrySearch">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            }
                        </div>
                        <SoftVoiceButton @bind-TargetText="_searchJewelryTerm"
                                         Append="false"
                                         TooltipText="Buscar por voz"
                                         ButtonClass="btn-outline-secondary" />
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                    <Select TItemValue="int"
                            TItem="ItemTypeDto"
                            DataSource="@_jewelryTypeOptions"
                            @bind-Value="_selectedJewelryTypeFilter"
                            ValueName="@nameof(ItemTypeDto.Id)"
                            LabelName="@nameof(ItemTypeDto.Name)"
                            EnableSearch="true"
                            Placeholder="Tipo de joya..." />
                </div>
                <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                    <Select TItemValue="string"
                            TItem="StatusFilterOption"
                            DataSource="@_statusFilterOptions"
                            @bind-Value="_selectedJewelryStatusFilter"
                            ValueName="@nameof(StatusFilterOption.Value)"
                            LabelName="@nameof(StatusFilterOption.Label)"
                            EnableSearch="true"
                            Placeholder="Estado..." />
                </div>
                <div class="col-12 col-md-12 col-lg-3">
                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <Tooltip Title="Restablecer todos los filtros" Placement="Placement.Top">
                            <button class="btn @(HasJewelryFilters ? "btn-outline-danger" : "btn-outline-secondary text-muted") flex-grow-1 flex-lg-grow-0 d-flex align-items-center justify-content-center gap-1 filter-action-btn"
                                    type="button"
                                    style="height: 38px; min-width: 85px;"
                                    disabled="@(!HasJewelryFilters)"
                                    @onclick="ResetJewelryFilters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span class="fw-medium small">Limpiar</span>
                            </button>
                        </Tooltip>

                        <Tooltip Title="Actualizar catálogo" Placement="Placement.Top">
                            <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center filter-icon-btn"
                                    type="button"
                                    @onclick="LoadInventoryCatalogAsync">
                                <i class="bi bi-arrow-clockwise fs-5"></i>
                            </button>
                        </Tooltip>

                        <Tooltip Title="Registrar Nueva Joya" Placement="Placement.Top">
                            <button class="btn btn-primary d-flex align-items-center justify-content-center filter-icon-btn btn-create-accent"
                                    type="button"
                                    @onclick="OpenCreateJewelDrawer">
                                <i class="bi bi-plus-lg fs-5"></i>
                            </button>
                        </Tooltip>
                    </div>
                </div>
            </div>
        </SoftFilterCard>

        <!-- Tabla de Joyería -->
        <div class="table-container shadow-sm rounded-3">
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <Spin Size="SpinSize.Large" Tip="Cargando catálogo de joyería..." />
                </div>
            }
            else if (!FilteredJewelry.Any())
            {
                <div class="py-5">
                    <SoftResultView Status="ResultStatus.Info"
                                    Title="No se encontraron joyas"
                                    Subtitle="No hay piezas de joyería que coincidan con los filtros seleccionados.">
                        <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                            @if (HasJewelryFilters)
                            {
                                <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-1"
                                        type="button"
                                        @onclick="ResetJewelryFilters">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    <span>Limpiar Filtros</span>
                                </button>
                            }
                            <SoftButton Type="@ButtonType.Primary"
                                        Icon="plus-circle"
                                        OnClick="OpenCreateJewelDrawer">
                                Registrar Nueva Joya
                            </SoftButton>
                        </div>
                    </SoftResultView>
                </div>
            }
            else
            {
                <Table TItem="JewelListItemDto"
                       DataSource="@FilteredJewelry"
                       Responsive="true"
                       Size="TableSize.Middle"
                       RowKey="@(x => x.Id.ToString())">
                    <PropertyColumn Property="c => c.ImageUrl" Title="Foto" Width="60px">
                        @if (!string.IsNullOrEmpty(context.ImageUrl))
                        {
                            <div class="table-img-thumb" @onclick="@(() => OpenImagePreview(context.ImageUrl, context.Description))" title="Ver foto">
                                <img src="@context.ImageUrl" alt="@context.Description" loading="lazy" />
                            </div>
                        }
                        else
                        {
                            <div class="table-img-placeholder" title="Sin foto">
                                <i class="bi bi-gem"></i>
                            </div>
                        }
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Reference" Title="Referencia" Width="110px">
                        <span class="ref-badge">#@context.Reference.ToString("D4")</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.ItemTypeName" Title="Tipo" Width="130px">
                        <SoftTag Color="gold">
                            <i class="bi bi-gem me-1"></i>
                            @context.ItemTypeName
                        </SoftTag>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Description" Title="Descripción" Ellipsis="true">
                        <span class="fw-medium text-dark">@context.Description</span>
                        @if (context.Length.HasValue && context.Length.Value > 0)
                        {
                            <span class="badge bg-light text-muted ms-1">@context.Length cm</span>
                        }
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Weight" Title="Peso (g)" Align="ColumnAlign.Right" Width="100px">
                        <span class="fw-bold">@context.Weight.ToString("F2") g</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.CostValue" Title="Costo Total" Align="ColumnAlign.Right" Width="130px">
                        <span class="cost-text">@context.CostValue.ToString("C0")</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.SaleValue" Title="Venta Sugerida" Align="ColumnAlign.Right" Width="135px">
                        <span class="sale-text">@((context.SaleValue ?? (int)(context.CostValue * 1.3)).ToString("C0"))</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.DateOfEntry" Title="Ingreso" Width="110px">
                        <span class="date-text">@context.DateOfEntry.ToString("dd/MM/yyyy")</span>
                    </PropertyColumn>
                    <ActionColumn Title="Activo / Estado" Width="165px" Align="ColumnAlign.Center">
                        <div class="d-inline-flex align-items-center justify-content-center gap-2">
                            <Switch Checked="@context.Active"
                                    Loading="@(_togglingRef == context.Reference)"
                                    Disabled="@(_togglingRef == context.Reference)"
                                    OnChange="@((bool val) => ToggleItemActiveAsync(context.Reference, val))" />
                            @if (context.Active)
                            {
                                <SoftTag Color="green">Activo</SoftTag>
                            }
                            else
                            {
                                <SoftTag Color="default">Inactivo</SoftTag>
                            }
                        </div>
                    </ActionColumn>
                    <ActionColumn Title="Acciones" Align="ColumnAlign.Center" Width="175px">
                        <div class="d-flex align-items-center justify-content-center gap-1">
                            <SoftActionButton Icon="history"
                                              TooltipText="Historial del Artículo"
                                              OnClick="@(() => OpenItemHistory(context.Reference))" />

                            <SoftActionButton Icon="eye"
                                              TooltipText="Ver Detalle"
                                              OnClick="@(() => OpenViewJewelDrawer(context))" />

                            <SoftActionButton Icon="edit"
                                              TooltipText="Editar Joya"
                                              OnClick="@(() => OpenEditJewelDrawer(context))" />

                            @if (context.Active)
                            {
                                <SoftActionButton Icon="export"
                                                  TooltipText="Descargar / Vender"
                                                  OnClick="@(() => Navigation.NavigateTo($"/inventory/discharge?ref={context.Reference}"))" />
                            }
                        </div>
                    </ActionColumn>
                </Table>
            }
        </div>
    }
    else
    {
        <!-- Métricas del Grupo Relojes -->
        <div class="metrics-grid mb-2">
            <div class="metric-card">
                <div class="metric-icon bg-info-subtle text-info">
                    <i class="bi bi-watch"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Relojes Disponibles</span>
                    <span class="metric-value">@_watchItems.Count(x => x.Active)</span>
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-icon bg-blue-subtle text-primary">
                    <i class="bi bi-tag"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Marcas Representadas</span>
                    <span class="metric-value">@_watchItems.Where(x => x.Active).Select(x => x.BrandName).Distinct().Count()</span>
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-icon bg-secondary-subtle text-danger">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Inversión Costo Relojes</span>
                    <span class="metric-value">@_watchItems.Where(x => x.Active).Sum(x => (long)x.CostValue).ToString("C0")</span>
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-icon bg-warning-subtle text-success">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Venta Sugerida Total</span>
                    <span class="metric-value">@_watchItems.Where(x => x.Active).Sum(x => (long)(x.SaleValue ?? (int)(x.CostValue * 1.3))).ToString("C0")</span>
                </div>
            </div>
        </div>

        <!-- Barra de Búsqueda y Filtros Relojes -->
        <SoftFilterCard>
            <div class="row g-2 align-items-center">
                <div class="col-12 col-lg-3 col-xl-3">
                    <div class="d-flex align-items-center gap-1">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="Buscar por ref (#), serial, marca o detalle..."
                                   value="@_searchWatchTerm"
                                   @oninput="OnWatchSearchInput" />
                            @if (!string.IsNullOrWhiteSpace(_searchWatchTerm))
                            {
                                <button class="btn btn-outline-secondary border-start-0 bg-white text-muted"
                                        type="button"
                                        title="Limpiar búsqueda"
                                        @onclick="ClearWatchSearch">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            }
                        </div>
                        <SoftVoiceButton @bind-TargetText="_searchWatchTerm"
                                         Append="false"
                                         TooltipText="Buscar por voz"
                                         ButtonClass="btn-outline-secondary" />
                    </div>
                </div>
                <div class="col-6 col-sm-6 col-md-3 col-lg-2 col-xl-2">
                    <Select TItemValue="int"
                            TItem="BrandFilterOption"
                            DataSource="@_brandFilterOptions"
                            @bind-Value="_selectedWatchBrandFilter"
                            ValueName="@nameof(BrandFilterOption.Id)"
                            LabelName="@nameof(BrandFilterOption.Name)"
                            EnableSearch="true"
                            Placeholder="Marca..." />
                </div>
                <div class="col-6 col-sm-6 col-md-3 col-lg-2 col-xl-2">
                    <Select TItemValue="string"
                            TItem="GenderFilterOption"
                            DataSource="@_genderFilterOptions"
                            @bind-Value="_selectedWatchGenderFilter"
                            ValueName="@nameof(GenderFilterOption.Value)"
                            LabelName="@nameof(GenderFilterOption.Label)"
                            EnableSearch="true"
                            Placeholder="Género..." />
                </div>
                <div class="col-6 col-sm-6 col-md-3 col-lg-2 col-xl-2">
                    <Select TItemValue="string"
                            TItem="StatusFilterOption"
                            DataSource="@_statusFilterOptions"
                            @bind-Value="_selectedWatchStatusFilter"
                            ValueName="@nameof(StatusFilterOption.Value)"
                            LabelName="@nameof(StatusFilterOption.Label)"
                            EnableSearch="true"
                            Placeholder="Estado..." />
                </div>
                <div class="col-12 col-sm-6 col-md-3 col-lg-3 col-xl-3">
                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <Tooltip Title="Restablecer todos los filtros" Placement="Placement.Top">
                            <button class="btn @(HasWatchFilters ? "btn-outline-danger" : "btn-outline-secondary text-muted") flex-grow-1 flex-lg-grow-0 d-flex align-items-center justify-content-center gap-1 filter-action-btn"
                                    type="button"
                                    style="height: 38px; min-width: 85px;"
                                    disabled="@(!HasWatchFilters)"
                                    @onclick="ResetWatchFilters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span class="fw-medium small">Limpiar</span>
                            </button>
                        </Tooltip>

                        <Tooltip Title="Actualizar catálogo" Placement="Placement.Top">
                            <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center filter-icon-btn"
                                    type="button"
                                    @onclick="LoadInventoryCatalogAsync">
                                <i class="bi bi-arrow-clockwise fs-5"></i>
                            </button>
                        </Tooltip>

                        <Tooltip Title="Registrar Nuevo Reloj" Placement="Placement.Top">
                            <button class="btn btn-primary d-flex align-items-center justify-content-center filter-icon-btn btn-create-accent"
                                    type="button"
                                    @onclick="OpenCreateWatchDrawer">
                                <i class="bi bi-plus-lg fs-5"></i>
                            </button>
                        </Tooltip>
                    </div>
                </div>
            </div>
        </SoftFilterCard>

        <!-- Tabla de Relojes -->
        <div class="table-container shadow-sm rounded-3">
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <Spin Size="SpinSize.Large" Tip="Cargando catálogo de relojes..." />
                </div>
            }
            else if (!FilteredWatches.Any())
            {
                <div class="py-5">
                    <SoftResultView Status="ResultStatus.Info"
                                    Title="No se encontraron relojes"
                                    Subtitle="No hay relojes que coincidan con los filtros seleccionados.">
                        <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                            @if (HasWatchFilters)
                            {
                                <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-1"
                                        type="button"
                                        @onclick="ResetWatchFilters">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    <span>Limpiar Filtros</span>
                                </button>
                            }
                            <SoftButton Type="@ButtonType.Primary"
                                        Icon="plus-circle"
                                        OnClick="OpenCreateWatchDrawer">
                                Registrar Nuevo Reloj
                            </SoftButton>
                        </div>
                    </SoftResultView>
                </div>
            }
            else
            {
                <Table TItem="WatchListItemDto"
                       DataSource="@FilteredWatches"
                       Responsive="true"
                       Size="TableSize.Middle"
                       RowKey="@(x => x.Id.ToString())">
                    <PropertyColumn Property="c => c.ImageUrl" Title="Foto" Width="60px">
                        @if (!string.IsNullOrEmpty(context.ImageUrl))
                        {
                            <div class="table-img-thumb" @onclick="@(() => OpenImagePreview(context.ImageUrl, $"{context.BrandName} {context.Model}"))" title="Ver foto">
                                <img src="@context.ImageUrl" alt="@context.Description" loading="lazy" />
                            </div>
                        }
                        else
                        {
                            <div class="table-img-placeholder" title="Sin foto">
                                <i class="bi bi-watch"></i>
                            </div>
                        }
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Reference" Title="Referencia" Width="110px">
                        <span class="ref-badge">#@context.Reference.ToString("D4")</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.BrandName" Title="Marca" Width="120px">
                        <SoftTag Color="cyan">
                            <i class="bi bi-watch me-1"></i>
                            @context.BrandName
                        </SoftTag>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Model" Title="Modelo" Width="130px">
                        <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(context.Model) ? "-" : context.Model)</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.CaseNumber" Title="Caja / Serial" Width="130px">
                        <span class="fw-semibold text-dark">@context.CaseNumber</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.GenderType" Title="Género" Width="110px">
                        <span class="badge bg-light text-dark">@context.GenderType</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Description" Title="Descripción" Ellipsis="true">
                        <span class="text-muted">@context.Description</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.CostValue" Title="Costo" Align="ColumnAlign.Right" Width="120px">
                        <span class="cost-text">@context.CostValue.ToString("C0")</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.SaleValue" Title="Venta Sugerida" Align="ColumnAlign.Right" Width="135px">
                        <span class="sale-text">@((context.SaleValue ?? (int)(context.CostValue * 1.3)).ToString("C0"))</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.DateOfEntry" Title="Ingreso" Width="110px">
                        <span class="date-text">@context.DateOfEntry.ToString("dd/MM/yyyy")</span>
                    </PropertyColumn>
                    <ActionColumn Title="Activo / Estado" Width="165px" Align="ColumnAlign.Center">
                        <div class="d-inline-flex align-items-center justify-content-center gap-2">
                            <Switch Checked="@context.Active"
                                    Loading="@(_togglingRef == context.Reference)"
                                    Disabled="@(_togglingRef == context.Reference)"
                                    OnChange="@((bool val) => ToggleItemActiveAsync(context.Reference, val))" />
                            @if (context.Active)
                            {
                                <SoftTag Color="green">Activo</SoftTag>
                            }
                            else
                            {
                                <SoftTag Color="default">Inactivo</SoftTag>
                            }
                        </div>
                    </ActionColumn>
                    <ActionColumn Title="Acciones" Align="ColumnAlign.Center" Width="175px">
                        <div class="d-flex align-items-center justify-content-center gap-1">
                            <SoftActionButton Icon="history"
                                              TooltipText="Historial del Artículo"
                                              OnClick="@(() => OpenItemHistory(context.Reference))" />

                            <SoftActionButton Icon="eye"
                                              TooltipText="Ver Detalle"
                                              OnClick="@(() => OpenViewWatchDrawer(context))" />

                            <SoftActionButton Icon="edit"
                                              TooltipText="Editar Reloj"
                                              OnClick="@(() => OpenEditWatchDrawer(context))" />

                            @if (context.Active)
                            {
                                <SoftActionButton Icon="export"
                                                  TooltipText="Descargar / Vender"
                                                  OnClick="@(() => Navigation.NavigateTo($"/inventory/discharge?ref={context.Reference}"))" />
                            }
                        </div>
                    </ActionColumn>
                </Table>
            }
        </div>
    }

    <!-- SoftDrawer: Registrar Nueva Joya -->
    <SoftDrawer Visible="@_drawerJewelVisible"
                Title="Registrar Nueva Joya"
                Description="Ingrese especificaciones de la joya, peso, gramaje y valorización comercial"
                Width="720"
                OnClose="CloseJewelDrawer">
        <ChildContent>
            <Form Model="@_jewelFormModel" Layout="@FormLayout.Vertical">
                <!-- 1. Clasificación y Proveedor -->
                <SoftFormBox Title="1. Referencia, Tipo de Joya y Origen"
                             InfoTooltip="Número de referencia física/marquilla y procedencia de la pieza">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <FormItem Label="N° de Referencia">
                                <div class="form-control bg-light d-flex align-items-center justify-content-between text-muted fw-bold" style="height: 38px;">
                                    <span><i class="bi bi-shield-lock-fill text-primary me-2"></i>Automática</span>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Secuencial</span>
                                </div>
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-4">
                            <FormItem Label="Tipo de Joya" Required="true">
                                <Select TItem="ItemTypeDto"
                                        TItemValue="int"
                                        DataSource="@_itemTypes.Where(t => t.Id != 5).ToList()"
                                        @bind-Value="_jewelFormModel.ItemTypeId"
                                        ValueName="@nameof(ItemTypeDto.Id)"
                                        LabelName="@nameof(ItemTypeDto.Name)"
                                        EnableSearch="true"
                                        Placeholder="Seleccione tipo de joya..." />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-4">
                            <FormItem Label="Proveedor / Origen">
                                <Select TItem="JewerlySystem.Modules.Customers.Application.DTOs.PersonDto"
                                        TItemValue="int?"
                                        DataSource="@_providers"
                                        @bind-Value="_jewelFormModel.ProviderId"
                                        ValueName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.Id)"
                                        LabelName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.FullName)"
                                        EnableSearch="true"
                                        Placeholder="-- Proveedor General / Stock Interno --"
                                        AllowClear="true" />
                            </FormItem>
                        </div>
                    </div>
                </SoftFormBox>

                <!-- 2. Pesaje y Tarifas -->
                <SoftFormBox Title="2. Pesaje y Tarifas por Gramo"
                             InfoTooltip="Peso neto verificado en balanza y tarifas pactadas por gramo">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <FormItem Label="Peso en Gramos (g)" Required="true">
                                <AntDesign.InputNumber TValue="double"
                                                       @bind-Value="_jewelFormModel.Weight"
                                                       Step="0.01"
                                                       Min="0.01"
                                                       Style="width: 100%; font-weight: bold;"
                                                       OnChange="@(_ => RecalculateJewelValues())" />
                            </FormItem>
                        </div>

                        <div class="col-12 col-md-4">
                            <FormItem Label="Valor Gr. Costo ($)" Required="true">
                                <AntDesign.InputNumber TValue="int"
                                                       @bind-Value="_jewelFormModel.GramValue"
                                                       Step="1000"
                                                       Min="0"
                                                       Placeholder="0"
                                                       Style="width: 100%;"
                                                       OnChange="@(_ => RecalculateJewelValues())" />
                            </FormItem>
                        </div>

                        <div class="col-12 col-md-4">
                            <FormItem Label="Valor Gr. Venta ($)">
                                <AntDesign.InputNumber TValue="int"
                                                       @bind-Value="_jewelFormModel.GramSaleValue"
                                                       Step="1000"
                                                       Min="0"
                                                       Placeholder="0"
                                                       Style="width: 100%; font-weight: bold; color: var(--soft-success, #52c41a);"
                                                       OnChange="@(_ => RecalculateJewelValues())" />
                            </FormItem>
                        </div>

                        @if (_jewelFormModel.ItemTypeId is 3 or 4)
                        {
                            <div class="col-12 col-md-4">
                                <FormItem Label="Largo (cm)">
                                    <AntDesign.InputNumber TValue="int?"
                                                           @bind-Value="_jewelFormModel.Length"
                                                           Min="1"
                                                           Style="width: 100%;" />
                                </FormItem>
                            </div>
                        }
                    </div>

                    <!-- Botones de margen sugerido joya drawer -->
                    <div class="p-2 mb-3 rounded bg-light border d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-muted fw-bold"><i class="bi bi-magic me-1 text-primary"></i>Fijar Margen Rápido:</span>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerJewelMarkup(20)">+20%</button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerJewelMarkup(25)">+25%</button>
                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerJewelMarkup(30)">+30% (Estándar)</button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerJewelMarkup(40)">+40%</button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerJewelMarkup(50)">+50%</button>
                    </div>
                </SoftFormBox>

                <!-- 3. Descripción -->
                <SoftFormBox Title="3. Descripción del Artículo"
                             InfoTooltip="Detalle de metal (oro 18k, 14k, plata), piedras preciosas, tallas, grabado...">
                    <SoftVoiceTextArea @bind-Value="_jewelFormModel.Description"
                                       Label="Descripción Detallada"
                                       Required="true"
                                       Placeholder="Describa el diseño de la joya, ley del metal o pulse 'Dictar por Voz'..."
                                       MaxLength="500" />
                </SoftFormBox>
            </Form>
        </ChildContent>
        <FooterContent>
            <SoftButton OnClick="CloseJewelDrawer">Cancelar</SoftButton>
            <SoftButton Type="@ButtonType.Primary"
                        Loading="@_isSavingJewel"
                        OnClick="SaveJewelAsync">
                Guardar Joya en Stock
            </SoftButton>
        </FooterContent>
    </SoftDrawer>

    <!-- SoftDrawer: Registrar Nuevo Reloj -->
    <SoftDrawer Visible="@_drawerWatchVisible"
                Title="Registrar Reloj en Inventario"
                Description="Ingrese la información del fabricante, serial de caja, género y valor comercial"
                Width="720"
                OnClose="CloseWatchDrawer">
        <ChildContent>
            <Form Model="@_watchFormModel" Layout="@FormLayout.Vertical">
                <!-- 1. Marca, Origen y Clasificación -->
                <SoftFormBox Title="1. Referencia, Marca y Origen"
                             InfoTooltip="Referencia de inventario, fabricante, género objetivo y procedencia">
                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <FormItem Label="N° de Referencia">
                                <div class="form-control bg-light d-flex align-items-center justify-content-between text-muted fw-bold" style="height: 38px;">
                                    <span><i class="bi bi-shield-lock-fill text-primary me-2"></i>Automática</span>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Secuencial</span>
                                </div>
                            </FormItem>
                        </div>

                        <div class="col-12 col-md-3">
                            <FormItem Label="Marca del Reloj" Required="true">
                                <Select TItem="BrandDto"
                                        TItemValue="int"
                                        DataSource="@_brands"
                                        @bind-Value="_watchFormModel.BrandId"
                                        ValueName="@nameof(BrandDto.Id)"
                                        LabelName="@nameof(BrandDto.Name)"
                                        EnableSearch="true"
                                        Placeholder="Seleccione marca..." />
                            </FormItem>
                        </div>

                        <div class="col-12 col-md-3">
                            <FormItem Label="Género / Segmento" Required="true">
                                <Select TItem="GenderTypeOption"
                                        TItemValue="GenderType"
                                        DataSource="@_genderOptions"
                                        @bind-Value="_watchFormModel.GenderType"
                                        ValueName="@nameof(GenderTypeOption.Value)"
                                        LabelName="@nameof(GenderTypeOption.Label)"
                                        EnableSearch="true"
                                        Placeholder="Seleccione género..." />
                            </FormItem>
                        </div>

                        <div class="col-12 col-md-3">
                            <FormItem Label="Proveedor / Origen">
                                <Select TItem="JewerlySystem.Modules.Customers.Application.DTOs.PersonDto"
                                        TItemValue="int?"
                                        DataSource="@_providers"
                                        @bind-Value="_watchFormModel.ProviderId"
                                        ValueName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.Id)"
                                        LabelName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.FullName)"
                                        EnableSearch="true"
                                        Placeholder="-- Stock Interno --"
                                        AllowClear="true" />
                            </FormItem>
                        </div>
                    </div>
                </SoftFormBox>

                <!-- 2. Seriales y Valores -->
                <SoftFormBox Title="2. Identificación y Precios"
                             InfoTooltip="Serial de tapa o caja y valores de costo y venta de vitrina">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <FormItem Label="Nro. de Caja / Serial" Required="true">
                                <Input Placeholder="Ej. W-984210"
                                       @bind-Value="_watchFormModel.CaseNumber" />
                            </FormItem>
                        </div>

                        <div class="col-12 col-md-3">
                            <FormItem Label="Modelo del Reloj" Required="true">
                                <Input Placeholder="Ej. Submariner Date"
                                       @bind-Value="_watchFormModel.Model" />
                            </FormItem>
                        </div>

                        <div class="col-12 col-md-3">
                            <FormItem Label="Valor Costo ($)" Required="true">
                                <AntDesign.InputNumber TValue="int"
                                                       @bind-Value="_watchFormModel.CostValue"
                                                       Step="10000"
                                                       Min="0"
                                                       Placeholder="0"
                                                       Style="width: 100%; font-weight: bold; color: var(--soft-danger, #ff4d4f);"
                                                       OnChange="@(_ => StateHasChanged())" />
                            </FormItem>
                        </div>

                        <div class="col-12 col-md-3">
                            <FormItem Label="Valor Venta Sugerido ($)">
                                <AntDesign.InputNumber TValue="int"
                                                       @bind-Value="_watchFormModel.SaleValue"
                                                       Step="10000"
                                                       Min="0"
                                                       Placeholder="0"
                                                       Style="width: 100%; font-weight: bold; color: var(--soft-success, #52c41a);"
                                                       OnChange="@(_ => StateHasChanged())" />
                            </FormItem>
                        </div>
                    </div>

                    <!-- Botones de margen sugerido reloj drawer -->
                    <div class="p-2 mb-3 rounded bg-light border d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-muted fw-bold"><i class="bi bi-calculator me-1 text-primary"></i>Margen Sugerido:</span>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerWatchMarkup(30)">+30%</button>
                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerWatchMarkup(40)">+40% (Recomendado)</button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerWatchMarkup(50)">+50%</button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerWatchMarkup(75)">+75%</button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyDrawerWatchMarkup(100)">+100% (2x)</button>
                    </div>
                </SoftFormBox>

                <!-- 3. Fotografía de Vitrina & Catálogo -->
                <SoftFormBox Title="3. Fotografía de Vitrina & Catálogo"
                             InfoTooltip="Fotografía estandarizada a fondo blanco puro (#FFFFFF) y sello genérico de autenticidad">
                    @if (!string.IsNullOrEmpty(_watchFormModel.ImageUrl))
                    {
                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded border">
                            <div style="width: 70px; height: 70px; background: #fff; border-radius: 6px; border: 1px solid #e8e8e8; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                <img src="@_watchFormModel.ImageUrl" alt="Reloj" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                            </div>
                            <div class="flex-grow-1">
                                <span class="badge bg-success-subtle text-success border border-success-subtle mb-1">
                                    <i class="bi bi-check2-circle me-1"></i> Imagen Estandarizada (&lt; 60 KB WebP)
                                </span>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2" @onclick="OpenSearchForNewWatch">Cambiar Foto</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2" @onclick="OpenCameraForNewWatch">Cámara Celular</button>
                                    <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2" @onclick="() => _watchFormModel.ImageUrl = null">Quitar</button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="OpenSearchForNewWatch">
                                <i class="bi bi-search me-1"></i> Buscar Foto por Marca y Modelo
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="OpenCameraForNewWatch">
                                <i class="bi bi-camera me-1"></i> Tomar con Celular
                            </button>
                        </div>
                    }
                </SoftFormBox>

                <!-- 4. Descripción -->
                <SoftFormBox Title="4. Descripción del Reloj"
                             InfoTooltip="Modelo, movimiento automático, cuarzo, pulso, cristal, estado estético...">
                    <SoftVoiceTextArea @bind-Value="_watchFormModel.Description"
                                       Label="Descripción Detallada"
                                       Required="true"
                                       Placeholder="Detalle características: maquinaria, bisel, pulso o pulse 'Dictar por Voz'..."
                                       MaxLength="500" />
                </SoftFormBox>
            </Form>
        </ChildContent>
        <FooterContent>
            <SoftButton OnClick="CloseWatchDrawer">Cancelar</SoftButton>
            <SoftButton Type="@ButtonType.Primary"
                        Loading="@_isSavingWatch"
                        OnClick="SaveWatchAsync">
                Guardar Reloj en Stock
            </SoftButton>
        </FooterContent>
    </SoftDrawer>

    <!-- SoftDrawer: Visualización de Artículo (Joya / Reloj) -->
    <SoftDrawer Visible="@_drawerDetailVisible"
                Title="@($"Detalle del Artículo #{_detailReference.ToString("D4")}")"
                Description="@_detailCategory"
                Width="680"
                OnClose="@(() => _drawerDetailVisible = false)">
        <ChildContent>
            <div class="p-3 mb-3 rounded-3 bg-light border d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle @(_detailIsJewel ? "bg-warning bg-opacity-10 text-warning" : "bg-info bg-opacity-10 text-info") fs-2">
                        <i class="bi @(_detailIsJewel ? "bi-gem" : "bi-watch")"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">Ref #@_detailReference.ToString("D4")</h4>
                        <span class="text-muted small">@_detailCategory &bull; Registrado el @_detailDateOfEntry.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
                <div>
                    @if (_detailActive)
                    {
                        <span class="badge bg-success px-3 py-2 fs-6 rounded-pill">
                            <i class="bi bi-check-circle me-1"></i>Activo en Stock
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">
                            <i class="bi bi-bag-check me-1"></i>Descargado / Vendido
                        </span>
                    }
                </div>
            </div>

            <!-- Fotografía de Vitrina & Catálogo -->
            <SoftFormBox Title="Fotografía de Vitrina & Catálogo">
                @if (!string.IsNullOrEmpty(_detailImageUrl))
                {
                    <div class="detail-photo-hero text-center">
                        <div class="detail-photo-frame" @onclick="@(() => OpenImagePreview(_detailImageUrl, _detailDescription))">
                            <img src="@_detailImageUrl" alt="@_detailDescription" />
                            <span class="photo-overlay-zoom">
                                <i class="bi bi-zoom-in me-1"></i> Ampliar
                            </span>
                        </div>
                        <div class="d-flex justify-content-center align-items-center gap-2 mt-2 flex-wrap">
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                <i class="bi bi-check2-circle me-1"></i> Fondo Blanco Vitrina (#FFFFFF)
                            </span>
                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1 small">
                                <i class="bi bi-shield-check me-1"></i> Sello Universal de Calidad
                            </span>
                        </div>
                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="OpenPhotoPickerForDetail">
                                <i class="bi bi-arrow-repeat me-1"></i> Actualizar Fotografía
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-3 bg-light rounded-3 border text-center">
                        <p class="text-muted small mb-2">Este artículo aún no cuenta con fotografía estandarizada en el catálogo.</p>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            @if (!_detailIsJewel)
                            {
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenSearchForDetail">
                                    <i class="bi bi-search me-1"></i> Buscar Foto por Marca y Modelo
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="OpenCameraForDetail">
                                <i class="bi bi-camera me-1"></i> Tomar con Celular (Fondo Blanco)
                            </button>
                        </div>
                    </div>
                }
            </SoftFormBox>

            <SoftFormBox Title="Descripción y Características">
                <p class="fs-6 text-dark mb-0 fw-medium">@_detailDescription</p>
            </SoftFormBox>

            <SoftFormBox Title="Especificaciones Técnicas">
                <div class="row g-3">
                    @if (_detailIsJewel)
                    {
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Tipo de Joya</span>
                            <strong class="text-dark">@_detailCategory</strong>
                        </div>
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Peso Neto</span>
                            <strong class="text-dark fs-5">@_detailWeight.ToString("N2") g</strong>
                        </div>
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Valor por Gramo</span>
                            <strong class="text-dark">@_detailGramValue.ToString("C0")</strong>
                        </div>
                        @if (_detailLength.HasValue && _detailLength > 0)
                        {
                            <div class="col-6 col-md-4">
                                <span class="text-muted small d-block">Longitud</span>
                                <strong class="text-dark">@_detailLength cm</strong>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Marca</span>
                            <strong class="text-dark">@_detailTitle</strong>
                        </div>
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Modelo</span>
                            <strong class="text-dark">@(string.IsNullOrEmpty(_detailModel) ? "-" : _detailModel)</strong>
                        </div>
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Número de Caja / Serial</span>
                            <strong class="text-dark fs-6">@_detailCaseNumber</strong>
                        </div>
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Género</span>
                            <strong class="text-dark">@_detailGender</strong>
                        </div>
                    }
                    <div class="col-6 col-md-4">
                        <span class="text-muted small d-block">Proveedor / Procedencia</span>
                        <strong class="text-dark">@_detailProviderName</strong>
                    </div>
                </div>
            </SoftFormBox>

            <SoftFormBox Title="Valorización Comercial">
                <div class="row g-3">
                    <div class="col-6 col-md-4">
                        <span class="text-muted small d-block">Valor de Costo</span>
                        <strong class="text-primary fs-5">@_detailCostValue.ToString("C0")</strong>
                    </div>
                    @if (_detailIsJewel)
                    {
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Precio Estimado Venta</span>
                            <strong class="text-success fs-5">@((_detailGramValue * _detailWeight).ToString("C0"))</strong>
                        </div>
                    }
                    @if (!_detailActive && _detailDateOfSale.HasValue)
                    {
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Fecha de Venta</span>
                            <strong class="text-dark">@_detailDateOfSale.Value.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="col-6 col-md-4">
                            <span class="text-muted small d-block">Valor de Venta Real</span>
                            <strong class="text-success fs-5">@(_detailSaleValue?.ToString("C0") ?? "-")</strong>
                        </div>
                    }
                </div>
            </SoftFormBox>
        </ChildContent>
        <FooterContent>
            <SoftButton OnClick="@(() => _drawerDetailVisible = false)">Cerrar</SoftButton>
            <SoftButton Type="@ButtonType.Dashed" Icon="history" OnClick="@(() => OpenItemHistory(_detailReference))">Historial</SoftButton>
            <SoftButton Type="@ButtonType.Default" Icon="edit" OnClick="SwitchFromDetailToEdit">Editar Artículo</SoftButton>
            @if (_detailActive)
            {
                <SoftButton Type="@ButtonType.Primary" Icon="export" OnClick="@(() => Navigation.NavigateTo($"/inventory/discharge?ref={_detailReference}"))">
                    Descargar / Vender
                </SoftButton>
            }
        </FooterContent>
    </SoftDrawer>

    <!-- SoftDrawer: Editar Joya -->
    <SoftDrawer Visible="@_drawerEditJewelVisible"
                Title="@($"Editar Joya #{_editJewelModel.Reference.ToString("D4")}")"
                Description="Modifique las especificaciones, pesaje o descripción de la joya"
                Width="720"
                OnClose="@(() => _drawerEditJewelVisible = false)">
        <ChildContent>
            <Form Model="@_editJewelModel" Layout="@FormLayout.Vertical">
                <SoftFormBox Title="1. Tipo de Joya y Origen">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <FormItem Label="N° de Referencia">
                                <Input Value="@_editJewelModel.Reference.ToString("D4")" Disabled="true" />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-4">
                            <FormItem Label="Tipo de Joya" Required="true">
                                <Select TItem="ItemTypeDto"
                                        TItemValue="int"
                                        DataSource="@_itemTypes.Where(t => t.Id != 5).ToList()"
                                        @bind-Value="_editJewelModel.ItemTypeId"
                                        ValueName="@nameof(ItemTypeDto.Id)"
                                        LabelName="@nameof(ItemTypeDto.Name)"
                                        EnableSearch="true" />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-4">
                            <FormItem Label="Proveedor">
                                <Select TItem="JewerlySystem.Modules.Customers.Application.DTOs.PersonDto"
                                        TItemValue="int?"
                                        DataSource="@_providers"
                                        @bind-Value="_editJewelModel.ProviderId"
                                        ValueName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.Id)"
                                        LabelName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.FullName)"
                                        EnableSearch="true"
                                        AllowClear="true" />
                            </FormItem>
                        </div>
                    </div>
                </SoftFormBox>

                <SoftFormBox Title="2. Pesaje y Valores">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <FormItem Label="Peso (g)" Required="true">
                                <AntDesign.InputNumber TValue="double"
                                                       @bind-Value="_editJewelModel.Weight"
                                                       Step="0.01"
                                                       Min="0.01"
                                                       OnChange="@(_ => RecalculateEditJewelCost())" />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-4">
                            <FormItem Label="Valor por Gramo ($)" Required="true">
                                <AntDesign.InputNumber TValue="int"
                                                       @bind-Value="_editJewelModel.GramValue"
                                                       Step="1000"
                                                       Min="0"
                                                       OnChange="@(_ => RecalculateEditJewelCost())" />
                            </FormItem>
                        </div>
                        <div class="col-12 col-md-4">
                            <FormItem Label="Valor Costo ($)" Required="true">
                                <AntDesign.InputNumber TValue="int"
                                                       @bind-Value="_editJewelModel.CostValue"
                                                       Step="10000"
                                                       Min="0" />

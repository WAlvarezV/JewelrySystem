    private void SwitchFromDetailToEdit()
    {
        _drawerDetailVisible = false;
        if (_detailIsJewel)
        {
            var jewel = _jewelryItems.FirstOrDefault(j => j.Reference == _detailReference);
            if (jewel != null) OpenEditJewelDrawer(jewel);
        }
        else
        {
            var watch = _watchItems.FirstOrDefault(w => w.Reference == _detailReference);
            if (watch != null) OpenEditWatchDrawer(watch);
        }
    }

    private async Task SaveEditJewelAsync()
    {
        if (string.IsNullOrWhiteSpace(_editJewelModel.Description))
        {
            Message.Error("La descripción es obligatoria.");
            return;
        }
        if (_editJewelModel.Weight <= 0)
        {
            Message.Error("El peso debe ser mayor a 0 gramos.");
            return;
        }

        _isSavingEditJewel = true;
        try
        {
            var cmd = new UpdateJewelItemCommand(
                _editJewelModel.Reference,
                _editJewelModel.ItemTypeId,
                _editJewelModel.Description.Trim(),
                _editJewelModel.Weight,
                _editJewelModel.GramValue,
                _editJewelModel.CostValue,
                _editJewelModel.Length,
                _editJewelModel.ProviderId,
                _editJewelModel.ImageUrl
            );

            var res = await Sender.Send(cmd);
            if (res.IsSuccess)
            {
                Message.Success($"Joya ref #{_editJewelModel.Reference} actualizada exitosamente.");

    private void OpenCreateJewelDrawer()
    {
        _jewelFormModel = new JewelFormModel
        {
            ItemTypeId = _itemTypes.FirstOrDefault(t => t.Id != 5)?.Id ?? 1,
            GramValue = 0,
            GramSaleValue = 0,
            Weight = 0,
            Description = string.Empty
        };
        RecalculateJewelValues();
        _drawerJewelVisible = true;
    }

    private void CloseJewelDrawer()
    {
        _drawerJewelVisible = false;
    }

    private void RecalculateJewelValues()
    {
        _calculatedJewelCost = (int)Math.Round(_jewelFormModel.Weight * _jewelFormModel.GramValue);
        _calculatedJewelSale = (int)Math.Round(_jewelFormModel.Weight * _jewelFormModel.GramSaleValue);
    }

    private void ApplyDrawerJewelMarkup(double percent)
    {
        if (_jewelFormModel.GramValue <= 0) return;
        _jewelFormModel.GramSaleValue = (int)Math.Round(_jewelFormModel.GramValue * (1.0 + (percent / 100.0)));
        RecalculateJewelValues();
    }

    private void ApplyDrawerWatchMarkup(double percent)
    {
        if (_watchFormModel.CostValue <= 0) return;
        _watchFormModel.SaleValue = (int)Math.Round(_watchFormModel.CostValue * (1.0 + (percent / 100.0)));
        StateHasChanged();
    }

    private async Task SaveJewelAsync()
    {
        if (_jewelFormModel.ItemTypeId <= 0)
        {
            Message.Warning("Debe seleccionar un tipo de joya válido.");
            return;
        }

        if (_jewelFormModel.Weight <= 0)
        {
            Message.Warning("El peso de la joya debe ser mayor a 0 gramos.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_jewelFormModel.Description))
        {
            Message.Warning("La descripción de la joya es requerida.");
            return;
        }

        RecalculateJewelValues();
        if (_calculatedJewelCost <= 0)
        {
            Message.Warning("El costo total calculado debe ser mayor a 0.");
            return;
        }

        _isSavingJewel = true;
        try
        {
            var cmd = new CreateJewelItemCommand(
                CostValue: _calculatedJewelCost,
                DateOfEntry: DateTime.UtcNow,
                Description: _jewelFormModel.Description.Trim(),
                ItemTypeId: _jewelFormModel.ItemTypeId,
                Weight: _jewelFormModel.Weight,
                GramValue: _jewelFormModel.GramValue,
                Length: _jewelFormModel.Length,
                ProviderId: _jewelFormModel.ProviderId,
                ImageUrl: _jewelFormModel.ImageUrl
            );

            var result = await Sender.Send(cmd);
            if (result.IsSuccess)
            {
                await ModalService.SuccessAsync(new ConfirmOptions
                {
                    Title = "¡Joya Registrada Exitosamente!",
                    Content = $"Se ha asignado la Referencia #{result.Value.FormattedReference} al nuevo artículo en inventario.",
                    OkText = "Aceptar"
                });
                _drawerJewelVisible = false;
                await LoadInventoryCatalogAsync();
            }
            else
            {
                Message.Error(result.Error.Message);
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al guardar joya: {ex.Message}");
        }
        finally
        {
            _isSavingJewel = false;
        }
    }


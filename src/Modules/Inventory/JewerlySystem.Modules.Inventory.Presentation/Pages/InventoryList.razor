            if (provResult.IsSuccess)
            {
                _providers = provResult.Value;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading providers: {ex.Message}");
        }
    }

    private async Task LoadInventoryCatalogAsync()
    {
        _isLoading = true;
        try
        {
            var result = await Sender.Send(new GetInventoryCatalogQuery());
            if (result.IsSuccess)
            {
                _jewelryItems = result.Value.Jewelry
                    .Select(j => j with { SearchIndex = NormalizeSearchText($"{j.Reference} {j.ItemTypeName} {j.Description}") })
                    .ToList();

                _watchItems = result.Value.Watches
                    .Select(w => w with { SearchIndex = NormalizeSearchText($"{w.Reference} {w.BrandName} {w.Model} {w.CaseNumber} {w.GenderType} {w.Description}") })
                    .ToList();

                _itemTypes = result.Value.ItemTypes;
                _brands = result.Value.Brands;

                _jewelryTypeOptions = new List<ItemTypeDto> { new(0, "Todos los Tipos de Joya") };
                _jewelryTypeOptions.AddRange(_itemTypes.Where(t => t.Id != 5));

                _brandFilterOptions = new List<BrandFilterOption> { new() { Id = 0, Name = "Todas las Marcas" } };
                _brandFilterOptions.AddRange(_brands.Select(b => new BrandFilterOption { Id = b.Id, Name = b.Name }));
            }
            else
            {
                Message.Error($"Error al consultar catálogo: {result.Error.Message}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al cargar inventario: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }


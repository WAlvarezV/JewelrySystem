    // Filtered lists
    private List<JewelListItemDto> FilteredJewelry
    {
        get
        {
            try
            {
                var list = _jewelryItems.AsEnumerable();

                if (!string.IsNullOrWhiteSpace(_searchJewelryTerm))
                {
                    var rawTerm = _searchJewelryTerm.Trim();
                    var normTerm = NormalizeSearchText(rawTerm);
                    var digitsOnly = new string(rawTerm.Where(char.IsDigit).ToArray());
                    var words = normTerm.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                    list = list.Where(i =>
                    {
                        var refStr = i.Reference.ToString();
                        // 1. Coincidencia directa con referencia numérica (#9493, 9493, etc.)
                        if (!string.IsNullOrEmpty(digitsOnly) && refStr.Contains(digitsOnly))
                        {
                            return true;
                        }

                        if (words.Length == 0) return true;

                        // 2. Búsqueda de texto en índice precalculado ultra-rápido
                        var searchable = !string.IsNullOrEmpty(i.SearchIndex)
                            ? i.SearchIndex
                            : NormalizeSearchText($"{refStr} {i.ItemTypeName} {i.Description}");

                        return words.All(w => searchable.Contains(w, StringComparison.OrdinalIgnoreCase));
                    });
                }

                if (_selectedJewelryTypeFilter > 0)
                {
                    list = list.Where(i => i.ItemTypeId == _selectedJewelryTypeFilter);
                }

                if (_selectedJewelryStatusFilter == "active")
                {
                    list = list.Where(i => i.Active);
                }
                else if (_selectedJewelryStatusFilter == "inactive" || _selectedJewelryStatusFilter == "sold")
                {
                    list = list.Where(i => !i.Active);
                }

                return list.ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[InventoryList] FilteredJewelry error: {ex.Message}");
                return _jewelryItems;
            }
        }
    }

    private List<WatchListItemDto> FilteredWatches
    {
        get
        {
            try
            {
                var list = _watchItems.AsEnumerable();

                if (!string.IsNullOrWhiteSpace(_searchWatchTerm))
                {
                    var rawTerm = _searchWatchTerm.Trim();
                    var normTerm = NormalizeSearchText(rawTerm);
                    var digitsOnly = new string(rawTerm.Where(char.IsDigit).ToArray());
                    var words = normTerm.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                    list = list.Where(i =>
                    {
                        var refStr = i.Reference.ToString();
                        // 1. Coincidencia directa con referencia numérica (#3363, 3363, etc.)
                        if (!string.IsNullOrEmpty(digitsOnly) && refStr.Contains(digitsOnly))
                        {
                            return true;
                        }

                        if (words.Length == 0) return true;

                        // 2. Búsqueda de texto en índice precalculado ultra-rápido
                        var searchable = !string.IsNullOrEmpty(i.SearchIndex)
                            ? i.SearchIndex
                            : NormalizeSearchText($"{refStr} {i.BrandName} {i.CaseNumber} {i.GenderType} {i.Description}");

                        return words.All(w => searchable.Contains(w, StringComparison.OrdinalIgnoreCase));
                    });
                }

                if (_selectedWatchBrandFilter > 0)
                {
                    list = list.Where(i => i.BrandId == _selectedWatchBrandFilter);
                }

                if (!string.IsNullOrWhiteSpace(_selectedWatchGenderFilter))
                {
                    list = list.Where(i => i.GenderType.ToString().Equals(_selectedWatchGenderFilter, StringComparison.OrdinalIgnoreCase));
                }

                if (_selectedWatchStatusFilter == "active")
                {
                    list = list.Where(i => i.Active);
                }
                else if (_selectedWatchStatusFilter == "inactive" || _selectedWatchStatusFilter == "sold")
                {
                    list = list.Where(i => !i.Active);
                }

                return list.ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[InventoryList] FilteredWatches error: {ex.Message}");
                return _watchItems;
            }
        }

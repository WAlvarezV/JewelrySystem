    private int? _togglingRef;

    private async Task ToggleItemActiveAsync(int reference, bool isActive)
    {
        _togglingRef = reference;
        try
        {
            var cmd = new ToggleItemActiveCommand(reference, isActive);
            var result = await Sender.Send(cmd);
            if (result.IsSuccess)
            {
                var jIdx = _jewelryItems.FindIndex(j => j.Reference == reference);
                if (jIdx >= 0)
                {
                    _jewelryItems[jIdx] = _jewelryItems[jIdx] with { Active = isActive };
                }

                var wIdx = _watchItems.FindIndex(w => w.Reference == reference);
                if (wIdx >= 0)
                {
                    _watchItems[wIdx] = _watchItems[wIdx] with { Active = isActive };
                }

                Message.Success(isActive
                    ? $"Artículo #{reference} activado en inventario."
                    : $"Artículo #{reference} desactivado de inventario.");
            }
            else
            {
                Message.Error(result.Error.Message);
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al actualizar estado del artículo #{reference}: {ex.Message}");
        }
        finally
        {
            _togglingRef = null;
            StateHasChanged();
        }
    }


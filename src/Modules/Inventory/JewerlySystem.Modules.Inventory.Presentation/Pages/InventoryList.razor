    private void ApplyRouteOrQueryGroup()
    {
        var uri = Navigation.Uri.ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(GroupQuery))
        {
            if (GroupQuery.Equals("watches", StringComparison.OrdinalIgnoreCase) || GroupQuery.Equals("relojes", StringComparison.OrdinalIgnoreCase))
            {
                _activeGroup = "WATCHES";
                return;
            }
            if (GroupQuery.Equals("jewelry", StringComparison.OrdinalIgnoreCase) || GroupQuery.Equals("joyeria", StringComparison.OrdinalIgnoreCase))
            {
                _activeGroup = "JEWELRY";
                return;
            }
        }

        if (uri.Contains("/watches"))
        {
            _activeGroup = "WATCHES";
        }
        else if (uri.Contains("/jewelry"))
        {
            _activeGroup = "JEWELRY";
        }
    }

    private async Task LoadProvidersAsync()

@page "/inventory/jewels/new"
@page "/new/jewel/{ItemTypeId:int?}"
@attribute [Authorize]
@inject ISender Sender
@inject NavigationManager Navigation
@inject IMessageService Message
@inject ModalService ModalService

<div class="create-jewel-container">
    <SoftHeroHeader Title="Registrar Nueva Joya"
                    Subtitle="Ingrese especificaciones de la joya, peso, gramaje y valorización comercial"
                    Icon="bi bi-gem">
        <SoftButton Text="Volver al Catálogo"
                    Icon="arrow-left"
                    Type="ButtonType.Dashed"
                    OnClick="@(() => Navigation.NavigateTo("/inventory"))" />
    </SoftHeroHeader>

    @if (!string.IsNullOrEmpty(_lastRegisteredReference))
    {
        <div class="row justify-content-center mb-3">
            <div class="col-12 col-xl-10">
                <div class="alert alert-success d-flex align-items-center justify-content-between shadow-sm rounded-3 py-2 px-3 border-success-subtle mb-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                        <span>Joya registrada exitosamente: <strong>Referencia #@_lastRegisteredReference</strong>. Formulario listo para la siguiente joya (conservando valor/gramo y proveedor).</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-link text-success p-0 text-decoration-none" @onclick="() => _lastRegisteredReference = null">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <!-- 1. Clasificación y Proveedor -->
            <SoftFormBox Title="1. Tipo de Joya y Origen"
                         InfoTooltip="Categoría de joyería y procedencia de la pieza">
                <div class="mb-3">
                    <span class="small text-muted fw-bold d-block mb-2 text-uppercase">Categorías Frecuentes:</span>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var type in _itemTypes.Where(t => t.Id != 5))
                        {
                            bool isSelected = _formModel.ItemTypeId == type.Id;
                            <button type="button"
                                    class="btn btn-sm @(isSelected ? "btn-primary shadow-sm" : "btn-outline-secondary") d-inline-flex align-items-center gap-1 rounded-pill px-3 py-1"
                                    @onclick="() => SelectItemType(type.Id)">
                                <i class="bi @GetItemTypeIcon(type.Id)"></i>
                                <span>@type.Name</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <SoftTooltipLabel Label="N° de Referencia" Required="false" TooltipText="Asignación automática y correlativa por el sistema al registrar (inicia en 0001)" />
                        <div class="form-control bg-light d-flex align-items-center justify-content-between text-muted fw-bold" style="height: 38px;">
                            <span><i class="bi bi-shield-lock-fill text-primary me-2"></i>Automática</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Secuencial</span>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <SoftTooltipLabel Label="Tipo de Joya (Catálogo)" Required="true" TooltipText="Categoría física del artículo a ingresar" />
                        <Select TItem="ItemTypeDto"
                                TItemValue="int"
                                DataSource="@_itemTypes.Where(t => t.Id != 5).ToList()"
                                @bind-Value="_formModel.ItemTypeId"
                                ValueName="@nameof(ItemTypeDto.Id)"
                                LabelName="@nameof(ItemTypeDto.Name)"
                                EnableSearch="true"
                                Placeholder="Seleccione tipo de joya..." />
                    </div>

                    <div class="col-12 col-md-4">
                        <SoftTooltipLabel Label="Proveedor / Origen" TooltipText="Tercero proveedor o stock interno de la joyería" />
                        <Select TItem="JewerlySystem.Modules.Customers.Application.DTOs.PersonDto"
                                TItemValue="int?"
                                DataSource="@_providers"
                                @bind-Value="_formModel.ProviderId"
                                ValueName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.Id)"
                                LabelName="@nameof(JewerlySystem.Modules.Customers.Application.DTOs.PersonDto.FullName)"
                                EnableSearch="true"
                                Placeholder="-- Proveedor General / Stock Interno --"
                                AllowClear="true" />
                    </div>
                </div>
            </SoftFormBox>

            <!-- 2. Pesaje y Tarifas -->
            <SoftFormBox Title="2. Pesaje y Tarifas por Gramo"
                         InfoTooltip="Peso neto verificado en balanza y tarifas pactadas por gramo">
                <div class="row g-3 align-items-end mb-2">
                    <div class="col-12 col-md-3">
                        <SoftTooltipLabel Label="Peso en Gramos (g)" Required="true" TooltipText="Peso neto verificado en balanza de precisión" />
                        <AntDesign.InputNumber TValue="double"
                                               @bind-Value="_formModel.Weight"
                                               Step="0.01"
                                               Min="0.01"
                                               Style="width: 100%; font-weight: bold;"
                                               OnChange="@(_ => RecalculateValues())" />
                    </div>

                    <div class="col-12 col-md-3">
                        <SoftTooltipLabel Label="Valor Gr. Costo ($)" Required="true" TooltipText="Costo por gramo pactado de compra o fundición" />
                        <AntDesign.InputNumber TValue="int"
                                               @bind-Value="_formModel.GramValue"
                                               Step="1000"
                                               Min="0"
                                               Placeholder="0"
                                               Style="width: 100%;"
                                               OnChange="@(_ => RecalculateValues())" />
                    </div>

                    <div class="col-12 col-md-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <SoftTooltipLabel Label="Valor Gr. Venta ($)" TooltipText="Tarifa sugerida por gramo para venta al público" />
                        </div>
                        <AntDesign.InputNumber TValue="int"
                                               @bind-Value="_formModel.GramSaleValue"
                                               Step="1000"
                                               Min="0"
                                               Placeholder="0"
                                               Style="width: 100%; font-weight: bold; color: var(--soft-success, #52c41a);"
                                               OnChange="@(_ => RecalculateValues())" />
                    </div>

                    @if (NeedLengthField)
                    {
                        <div class="col-12 col-md-3">
                            <SoftTooltipLabel Label="Largo de la Pieza (cm)" TooltipText="Longitud en centímetros para cadenas o pulseras" />
                            <AntDesign.InputNumber TValue="int?"
                                                   @bind-Value="_formModel.Length"
                                                   Min="1"
                                                   Placeholder="Ej: 50 cm"
                                                   Style="width: 100%;" />
                        </div>
                    }
                </div>

                <!-- Botones de margen sugerido -->
                <div class="p-2 rounded bg-light border d-flex flex-wrap align-items-center gap-2">
                    <span class="small text-muted fw-bold"><i class="bi bi-magic me-1 text-primary"></i>Fijar Margen Rápido:</span>
                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyMarkupPercent(20)">+20%</button>
                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyMarkupPercent(25)">+25%</button>
                    <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0" @onclick="() => ApplyMarkupPercent(30)">+30% (Estándar)</button>
                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyMarkupPercent(40)">+40%</button>
                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" @onclick="() => ApplyMarkupPercent(50)">+50%</button>
                </div>
            </SoftFormBox>

            <!-- 3. Fotografía de Vitrina & Catálogo -->
            <SoftFormBox Title="3. Fotografía de Vitrina & Catálogo"
                         InfoTooltip="Captura con celular normalizada a fondo blanco puro (#FFFFFF) y sello de autenticidad">
                @if (!string.IsNullOrEmpty(_formModel.ImageUrl))
                {
                    <div class="d-flex align-items-center gap-3 p-3 bg-white rounded border">
                        <div style="width: 90px; height: 90px; background: #fff; border-radius: 8px; border: 1px solid #e8e8e8; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                            <img src="@_formModel.ImageUrl" alt="Joya" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                        </div>
                        <div class="flex-grow-1">
                            <span class="badge bg-success-subtle text-success border border-success-subtle mb-1">
                                <i class="bi bi-check-circle-fill me-1"></i> Fotografía Estandarizada (&lt; 80 KB WebP)
                            </span>
                            <p class="small text-muted mb-2">Fondo blanco puro vitrina (#FFFFFF) y sello genérico de alta gama aplicado.</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => _photoStudioModalVisible = true">
                                    <i class="bi bi-camera me-1"></i> Repetir / Cambiar Foto
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" @onclick="() => _formModel.ImageUrl = null">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-3 bg-white rounded border text-center">
                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2" @onclick="() => _photoStudioModalVisible = true">
                            <i class="bi bi-camera-fill me-1 fs-5"></i> Tomar Foto con Cámara / Celular (Estudio Blanco)
                        </button>
                        <p class="small text-muted mt-2 mb-0">
                            <i class="bi bi-magic me-1 text-warning"></i> La fotografía capturada con la cámara de su celular será estandarizada automáticamente a fondo blanco puro de vitrina con sello de autenticidad.
                        </p>
                    </div>
                }
            </SoftFormBox>

            <!-- 4. Descripción -->
            <SoftFormBox Title="4. Descripción del Artículo"
                         InfoTooltip="Detalle de metal (oro 18k, 14k, plata), piedras preciosas, tallas, grabado...">
                <SoftVoiceTextArea @bind-Value="_formModel.Description"
                                   Label="Descripción de la Joya"
                                   Required="true"
                                   Placeholder="Describa el diseño de la joya, ley del metal o use 'Dictar por Voz'..."
                                   MaxLength="500" />
            </SoftFormBox>

            <!-- Acciones -->
            <div class="d-flex justify-content-between align-items-center pt-3 pb-4">
                <SoftButton Text="Cancelar y Volver"
                            Icon="arrow-left"
                            Type="ButtonType.Dashed"
                            OnClick="@(() => Navigation.NavigateTo("/inventory"))" />

                <div class="d-flex gap-2">
                    <SoftButton Text="Limpiar"
                                Icon="clear"
                                Type="ButtonType.Default"
                                Danger="true"
                                OnClick="ClearForm" />
                    <SoftButton Text="Guardar Joya en Stock"
                                Icon="check"
                                Type="ButtonType.Primary"
                                Loading="@_isSubmitting"
                                OnClick="HandleSubmitAsync" />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Estudio Fotográfico con Celular -->
<ItemPhotoStudioModal @bind-Visible="_photoStudioModalVisible"
                      Title="Fotografiar Joya con Celular"
                      Subtitle="Capture la joya con la cámara trasera de su celular. Se estandarizará automáticamente a fondo blanco puro de vitrina (#FFFFFF) y sello genérico oficial."
                      Prefix="jewel"
                      OnImageSaved="@(url => { _formModel.ImageUrl = url; StateHasChanged(); })" />

@code {
    [Parameter] public int? ItemTypeId { get; set; }

    private JewelFormModel _formModel = new();
    private List<ItemTypeDto> _itemTypes = new();
    private List<JewerlySystem.Modules.Customers.Application.DTOs.PersonDto> _providers = new();

    private int _costValue = 0;
    private int _saleValue = 0;
    private bool _isSubmitting = false;
    private string? _lastRegisteredReference;
    private bool _photoStudioModalVisible = false;

    private bool NeedLengthField => _formModel.ItemTypeId is 3 or 4; // Cadenas (3) o Pulseras (4)

    protected override async Task OnInitializedAsync()
    {
        await LoadMasterDataAsync();
        ClearForm();

        if (ItemTypeId.HasValue && ItemTypeId.Value > 0)
        {
            _formModel.ItemTypeId = ItemTypeId.Value;
        }
    }

    private async Task LoadMasterDataAsync()
    {
        try
        {
            var typesResult = await Sender.Send(new GetItemTypesQuery());
            if (typesResult.IsSuccess)
            {
                _itemTypes = typesResult.Value;
            }

            var provResult = await Sender.Send(new JewerlySystem.Modules.Customers.Application.Queries.GetCustomersListQuery(JewerlySystem.Modules.Customers.Domain.PersonType.Proveedor));
            if (provResult.IsSuccess)
            {
                _providers = provResult.Value;
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al cargar datos maestros: {ex.Message}");
        }
    }

    private void ClearForm()
    {
        _formModel = new JewelFormModel
        {
            ItemTypeId = ItemTypeId ?? 1,
            GramValue = 0,
            GramSaleValue = 0,
            Weight = 0,
            Description = string.Empty,
            ImageUrl = null
        };
        RecalculateValues();
    }

    private void PrepareFormForNextJewel()
    {
        var prevGramValue = _formModel.GramValue;
        var prevGramSaleValue = _formModel.GramSaleValue;
        var prevProviderId = _formModel.ProviderId;
        var prevItemTypeId = _formModel.ItemTypeId;

        _formModel = new JewelFormModel
        {
            ItemTypeId = prevItemTypeId,
            ProviderId = prevProviderId,
            GramValue = prevGramValue,
            GramSaleValue = prevGramSaleValue,
            Weight = 0,
            Length = null,
            Description = string.Empty,
            ImageUrl = null
        };
        RecalculateValues();
    }

    private void RecalculateValues()
    {
        _costValue = (int)Math.Round(_formModel.Weight * _formModel.GramValue);
        _saleValue = (int)Math.Round(_formModel.Weight * _formModel.GramSaleValue);
    }

    private void SelectItemType(int typeId)
    {
        _formModel.ItemTypeId = typeId;
    }

    private void ApplyMarkupPercent(double percent)
    {
        if (_formModel.GramValue <= 0) return;
        _formModel.GramSaleValue = (int)Math.Round(_formModel.GramValue * (1.0 + (percent / 100.0)));
        RecalculateValues();
    }

    private static string GetItemTypeIcon(int typeId) => typeId switch
    {
        1 => "bi-gem",               // Anillo
        2 => "bi-circle",            // Aretes
        3 => "bi-link-45deg",        // Cadena
        4 => "bi-infinity",          // Pulsera
        _ => "bi-star"               // Dije u otro
    };

    private async Task HandleSubmitAsync()
    {
        if (_formModel.ItemTypeId <= 0)
        {
            Message.Warning("Debe seleccionar un tipo de joya válido.");
            return;
        }

        if (_formModel.Weight <= 0)
        {
            Message.Warning("El peso de la joya debe ser mayor a 0 gramos.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_formModel.Description))
        {
            Message.Warning("La descripción de la joya es requerida.");
            return;
        }

        RecalculateValues();
        if (_costValue <= 0)
        {
            Message.Warning("El costo total calculado debe ser mayor a 0.");
            return;
        }

        _isSubmitting = true;

        try
        {
            var cmd = new CreateJewelItemCommand(
                CostValue: _costValue,
                DateOfEntry: DateTime.UtcNow,
                Description: _formModel.Description,
                ItemTypeId: _formModel.ItemTypeId,
                Weight: _formModel.Weight,
                GramValue: _formModel.GramValue,
                Length: _formModel.Length,
                ProviderId: _formModel.ProviderId,
                ImageUrl: _formModel.ImageUrl
            );

            var result = await Sender.Send(cmd);
            if (!result.IsSuccess)
            {
                Message.Error(result.Error.Message);
                return;
            }

            var refText = result.Value.FormattedReference;
            _lastRegisteredReference = refText;
            var savedGramVal = _formModel.GramValue;
            PrepareFormForNextJewel();

            await ModalService.SuccessAsync(new ConfirmOptions
            {
                Title = "¡Joya Registrada Exitosamente!",
                Content = $"Se ha asignado la Referencia #{refText} al nuevo artículo. El formulario queda listo para la siguiente joya conservando el valor por gramo (${savedGramVal:N0}) y el proveedor seleccionado.",
                OkText = "Registrar Siguiente Joya",
                OnOk = (e) =>
                {
                    StateHasChanged();
                    return Task.CompletedTask;
                }
            });
        }
        catch (Exception ex)
        {
            Message.Error($"Ocurrió un error: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class JewelFormModel
    {
        public int ItemTypeId { get; set; } = 1;
        public int? ProviderId { get; set; }
        public double Weight { get; set; }
        public int GramValue { get; set; } = 0;
        public int GramSaleValue { get; set; } = 0;
        public int? Length { get; set; }
        public string Description { get; set; } = string.Empty;
        public string? ImageUrl { get; set; }
    }
}

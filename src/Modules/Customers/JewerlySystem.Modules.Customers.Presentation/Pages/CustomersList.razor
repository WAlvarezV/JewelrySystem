@page "/customers"
@inject ISender Sender

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="bi bi-people me-2"></i>Clientes</h3>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_customers == null || !_customers.Any())
    {
        <div class="card p-4 text-center text-muted">
            <p class="mb-0">No hay clientes registrados.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Documento</th>
                            <th>Nombre Completo</th>
                            <th>Celular</th>
                            <th>Correo</th>
                            <th>Tipo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _customers)
                        {
                            <tr>
                                <td class="fw-semibold">@c.IdentificationNumber</td>
                                <td>@c.FullName</td>
                                <td>@c.CellPhone</td>
                                <td>@c.Email</td>
                                <td><span class="badge bg-secondary">@c.PersonType</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<PersonDto>? _customers;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetCustomersListQuery());
        if (result.IsSuccess)
        {
            _customers = result.Value;
        }
        _isLoading = false;
    }
}

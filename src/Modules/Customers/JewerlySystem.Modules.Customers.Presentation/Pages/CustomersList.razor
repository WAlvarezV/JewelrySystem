@page "/customers"
@page "/clientes"
@page "/proveedores"
@attribute [Authorize]
@inject ISender Sender
@inject NavigationManager Navigation
@inject IMessageService MessageService

<div class="customers-view step-fade-in">
    <!-- Hero Header -->
    <SoftHeroHeader Title="Directorio de Clientes y Proveedores"
                    Subtitle="Gestión unificada de clientes prendarios, compradores y proveedores"
                    Icon="bi bi-people">
        <SoftButton Icon="reload" OnClick="LoadCustomers">Actualizar</SoftButton>
        <SoftButton Type="@ButtonType.Primary" Icon="user-add" OnClick="OpenCreateDrawer">Nuevo Registro</SoftButton>
    </SoftHeroHeader>

    <!-- Metrics Summary -->
    <div class="metrics-grid my-4">
        <div class="metric-card">
            <div class="metric-icon bg-blue-subtle">
                <i class="bi bi-people"></i>
            </div>
            <div class="metric-content">
                <span class="metric-label">Total Directorio</span>
                <span class="metric-value">@_allCustomers.Count</span>
                <span class="metric-subtext">Contactos registrados</span>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon bg-emerald-subtle">
                <i class="bi bi-person-badge"></i>
            </div>
            <div class="metric-content">
                <span class="metric-label">Clientes</span>
                <span class="metric-value">@_allCustomers.Count(x => x.PersonType == PersonType.Cliente)</span>
                <span class="metric-subtext">Compradores y empeñantes</span>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon bg-purple-subtle">
                <i class="bi bi-truck"></i>
            </div>
            <div class="metric-content">
                <span class="metric-label">Proveedores y Talleres</span>
                <span class="metric-value">@_allCustomers.Count(x => x.PersonType == PersonType.Proveedor)</span>
                <span class="metric-subtext">Orfebres y mayoristas</span>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon bg-amber-subtle">
                <i class="bi bi-telephone"></i>
            </div>
            <div class="metric-content">
                <span class="metric-label">Con Celular Activo</span>
                <span class="metric-value">@_allCustomers.Count(x => !string.IsNullOrWhiteSpace(x.CellPhone))</span>
                <span class="metric-subtext">Contactabilidad directa</span>
            </div>
        </div>
    </div>

    <!-- Filters Card -->
    <SoftFilterCard>
        <div class="row g-3 align-items-center">
            <div class="col-12 col-lg-5">
                <div class="d-flex align-items-center gap-1">
                    <Input Placeholder="Buscar por documento, nombre o celular..."
                           @bind-Value="_searchTerm"
                           AllowClear="true"
                           PrefixIcon="search" />
                    <SoftVoiceButton @bind-TargetText="_searchTerm"
                                     Append="false"
                                     TooltipText="Buscar clientes por voz"
                                     ButtonClass="btn-outline-secondary" />
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <RadioGroup @bind-Value="_filterTab" ButtonStyle="@RadioButtonStyle.Solid">
                    <Radio RadioButton="true" Value="@("ALL")">Todos</Radio>
                    <Radio RadioButton="true" Value="@("CLIENT")">Clientes</Radio>
                    <Radio RadioButton="true" Value="@("PROVIDER")">Proveedores</Radio>
                </RadioGroup>
            </div>
            <div class="col-12 col-lg-2 text-lg-end d-flex align-items-center justify-content-lg-end gap-2 flex-wrap">
                @if (HasFilters)
                {
                    <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 py-1"
                            type="button"
                            title="Limpiar filtros"
                            @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Limpiar</span>
                    </button>
                }
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                    <i class="bi bi-funnel me-1"></i> <b>@FilteredCustomers.Count</b> registros
                </span>
            </div>
        </div>
    </SoftFilterCard>

    <!-- Data Table / Empty / Loading -->
    @if (_isLoading)
    {
        <div class="soft-card p-5 text-center">
            <Spin Tip="Cargando directorio de clientes..." />
        </div>
    }
    else if (!FilteredCustomers.Any())
    {
        <SoftResultView Status="@ResultStatus.Info"
                        Title="No se encontraron registros"
                        Subtitle="No hay clientes ni proveedores que coincidan con los criterios de búsqueda.">
            <SoftButton Type="@ButtonType.Primary" Icon="user-add" OnClick="OpenCreateDrawer">Registrar Primero</SoftButton>
        </SoftResultView>
    }
    else
    {
        <div class="soft-card overflow-hidden">
            <Table TItem="PersonDto"
                   DataSource="@FilteredCustomers"
                   Responsive="true"
                   Size="@TableSize.Middle">
                <PropertyColumn Property="c => c.PersonType" Title="Rol" Width="140px">
                    @{
                        bool isCustomer = context.PersonType == PersonType.Cliente;
                    }
                    @if (isCustomer)
                    {
                        <span class="pill-badge badge-soft-primary">
                            <i class="bi bi-person"></i> Cliente
                        </span>
                    }
                    else
                    {
                        <span class="pill-badge badge-soft-purple">
                            <i class="bi bi-truck"></i> Proveedor
                        </span>
                    }
                </PropertyColumn>
                <PropertyColumn Property="c => c.IdentificationNumber" Title="Nro. Documento" Width="160px">
                    <span class="fw-semibold text-dark">
                        <i class="bi bi-card-heading text-muted me-1"></i>@context.IdentificationNumber
                    </span>
                </PropertyColumn>
                <PropertyColumn Property="c => c.FullName" Title="Nombre Completo / Razón Social">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-circle @(context.PersonType == PersonType.Cliente ? "avatar-blue" : "avatar-purple")">
                            @GetInitials(context.FullName)
                        </div>
                        <div class="d-flex flex-column" style="min-width: 0;">
                            <span class="fw-bold text-dark text-truncate">@context.FullName</span>
                            @if (!string.IsNullOrEmpty(context.Email))
                            {
                                <span class="small text-muted text-truncate">
                                    <i class="bi bi-envelope me-1"></i>@context.Email
                                </span>
                            }
                        </div>
                    </div>
                </PropertyColumn>
                <PropertyColumn Property="c => c.CellPhone" Title="Teléfono / Celular" Width="160px">
                    @if (!string.IsNullOrEmpty(context.CellPhone))
                    {
                        <span class="tabular-nums fw-medium text-dark">
                            <i class="bi bi-telephone text-primary me-1"></i>@context.CellPhone
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small">Sin registrar</span>
                    }
                </PropertyColumn>
                <ActionColumn Title="Acción" Width="80px" Align="ColumnAlign.Center">
                    <SoftActionButton Icon="edit"
                                      Tooltip="Editar registro"
                                      OnClick="() => OpenEditDrawer(context)" />
                </ActionColumn>
            </Table>
        </div>
    }

    <!-- SoftDrawer: Create / Edit Form -->
    <SoftDrawer Visible="@_drawerVisible"
                Title="@(_isEditing ? "Editar Registro" : "Nuevo Cliente / Proveedor")"
                Description="Complete los datos del contacto o empresa asociada"
                Width="720"
                OnClose="CloseDrawer">
        <ChildContent>
            <Form Model="@_formModel" Layout="@FormLayout.Vertical">
                <SoftFormBox Title="Tipo de Registro">
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-6">
                            <div class="quick-choice-card text-center @(_formModel.PersonType == PersonType.Cliente ? "active" : "")"
                                 @onclick='() => _formModel.PersonType = PersonType.Cliente'>
                                <div class="choice-icon bg-blue-subtle">
                                    <i class="bi bi-person-badge"></i>
                                </div>
                                <div class="choice-title">Cliente</div>
                                <div class="choice-desc">Empeñante prendario, comprador o mandante</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="quick-choice-card text-center @(_formModel.PersonType == PersonType.Proveedor ? "active" : "")"
                                 @onclick='() => _formModel.PersonType = PersonType.Proveedor'>
                                <div class="choice-icon bg-purple-subtle">
                                    <i class="bi bi-truck"></i>
                                </div>
                                <div class="choice-title">Proveedor / Taller</div>
                                <div class="choice-desc">Mayorista de mercancía u orfebre de taller</div>
                            </div>
                        </div>
                    </div>
                </SoftFormBox>

                <SoftFormBox Title="Identificación y Datos Básicos">
                    <Row Gutter="16">
                        <Col Span="12">
                            <FormItem Label="Tipo de Documento" Required="true">
                                <Select TItem="IdentificationTypeDto"
                                        TItemValue="int"
                                        @bind-Value="_formModel.IdentificationTypeId"
                                        DataSource="@_idTypes"
                                        LabelName="@nameof(IdentificationTypeDto.Name)"
                                        ValueName="@nameof(IdentificationTypeDto.Id)"
                                        EnableSearch="true"
                                        Placeholder="Seleccione tipo..." />
                            </FormItem>
                        </Col>
                        <Col Span="12">
                            <FormItem Label="Número de Documento" Required="true">
                                <Input @bind-Value="_formModel.IdentificationNumber" Placeholder="Ej: 1020304050" />
                            </FormItem>
                        </Col>
                    </Row>

                    <FormItem Label="Nombre Completo / Razón Social" Required="true">
                        <Input @bind-Value="_formModel.FullName" Placeholder="Ej: Juan Pérez o Inversiones Oro S.A.S." />
                    </FormItem>
                </SoftFormBox>

                <SoftFormBox Title="Datos de Contacto">
                    <Row Gutter="16">
                        <Col Span="12">
                            <FormItem Label="Teléfono / Celular">
                                <Input @bind-Value="_formModel.CellPhone" Placeholder="Ej: 3001234567" />
                            </FormItem>
                        </Col>
                        <Col Span="12">
                            <FormItem Label="Correo Electrónico">
                                <Input @bind-Value="_formModel.Email" Placeholder="contacto@ejemplo.com" />
                            </FormItem>
                        </Col>
                    </Row>
                </SoftFormBox>
            </Form>
        </ChildContent>
        <FooterContent>
            <SoftButton OnClick="CloseDrawer">Cancelar</SoftButton>
            <SoftButton Type="@ButtonType.Primary"
                        Loading="@_isSaving"
                        OnClick="SaveCustomer">
                @(_isEditing ? "Actualizar Registro" : "Guardar Registro")
            </SoftButton>
        </FooterContent>
    </SoftDrawer>
</div>

@code {
    private List<PersonDto> _allCustomers = new();
    private List<IdentificationTypeDto> _idTypes = new();
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private string _filterTab = "ALL";

    private bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || _filterTab != "ALL";

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        _filterTab = "ALL";
    }

    // Drawer state
    private bool _drawerVisible;
    private bool _isEditing;
    private bool _isSaving;
    private int _editingId;
    private CustomerFormModel _formModel = new();

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0][..1].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private List<PersonDto> FilteredCustomers => _allCustomers
        .Where(c => _filterTab == "ALL"
            || (_filterTab == "CLIENT" && c.PersonType == PersonType.Cliente)
            || (_filterTab == "PROVIDER" && c.PersonType == PersonType.Proveedor))
        .Where(c => string.IsNullOrWhiteSpace(_searchTerm)
            || c.IdentificationNumber.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || c.FullName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || (c.CellPhone != null && c.CellPhone.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadIdentificationTypes();
        await LoadCustomers();
    }

    private async Task LoadIdentificationTypes()
    {
        var res = await Sender.Send(new GetIdentificationTypesQuery());
        if (res.IsSuccess)
        {
            _idTypes = res.Value;
        }
    }

    private async Task LoadCustomers()
    {
        _isLoading = true;
        try
        {
            var res = await Sender.Send(new GetCustomersListQuery());
            if (res.IsSuccess)
            {
                _allCustomers = res.Value;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateDrawer()
    {
        _isEditing = false;
        _editingId = 0;
        _formModel = new CustomerFormModel
        {
            IdentificationTypeId = _idTypes.FirstOrDefault()?.Id ?? 1,
            PersonType = PersonType.Cliente
        };
        _drawerVisible = true;
    }

    private void OpenEditDrawer(PersonDto dto)
    {
        _isEditing = true;
        _editingId = dto.Id;
        _formModel = new CustomerFormModel
        {
            IdentificationTypeId = dto.IdentificationTypeId,
            IdentificationNumber = dto.IdentificationNumber,
            FullName = dto.FullName,
            CellPhone = dto.CellPhone,
            Email = dto.Email,
            PersonType = dto.PersonType
        };
        _drawerVisible = true;
    }

    private void CloseDrawer()
    {
        _drawerVisible = false;
    }

    private async Task SaveCustomer()
    {
        if (string.IsNullOrWhiteSpace(_formModel.FullName))
        {
            MessageService.Error("El nombre completo es requerido.");
            return;
        }
        if (string.IsNullOrWhiteSpace(_formModel.IdentificationNumber))
        {
            MessageService.Error("El número de documento es requerido.");
            return;
        }

        _isSaving = true;
        try
        {
            if (_isEditing)
            {
                var cmd = new UpdateCustomerCommand(
                    _editingId,
                    _formModel.IdentificationTypeId,
                    _formModel.IdentificationNumber.Trim(),
                    _formModel.FullName.Trim(),
                    _formModel.CellPhone?.Trim() ?? string.Empty,
                    _formModel.Email?.Trim() ?? string.Empty,
                    _formModel.PersonType
                );
                var res = await Sender.Send(cmd);
                if (res.IsSuccess)
                {
                    MessageService.Success("Registro actualizado correctamente.");
                    _drawerVisible = false;
                    await LoadCustomers();
                }
                else
                {
                    MessageService.Error(res.Error.Message);
                }
            }
            else
            {
                var cmd = new CreateCustomerCommand(
                    _formModel.IdentificationTypeId,
                    _formModel.IdentificationNumber.Trim(),
                    _formModel.FullName.Trim(),
                    _formModel.CellPhone?.Trim() ?? string.Empty,
                    _formModel.Email?.Trim() ?? string.Empty,
                    _formModel.PersonType
                );
                var res = await Sender.Send(cmd);
                if (res.IsSuccess)
                {
                    MessageService.Success("Registro creado correctamente.");
                    _drawerVisible = false;
                    await LoadCustomers();
                }
                else
                {
                    MessageService.Error(res.Error.Message);
                }
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    public class CustomerFormModel
    {
        public int IdentificationTypeId { get; set; }
        public string IdentificationNumber { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? CellPhone { get; set; }
        public string? Email { get; set; }
        public PersonType PersonType { get; set; } = PersonType.Cliente;
    }
}

@page "/cash"
@page "/daily"
@attribute [Authorize]
@inject ISender Sender
@inject NavigationManager Navigation
@inject IMessageService MessageService

<div class="cash-daily-view step-fade-in">
    <!-- Hero Header -->
    <SoftHeroHeader Title="Caja y Arqueo Diario"
                    Subtitle="Control de ingresos, egresos y cuadre de caja por fecha"
                    Icon="bi bi-cash-stack">
        <SoftButton Icon="calendar" OnClick="@(() => Navigation.NavigateTo("/cash/consolidated"))">Consolidado de Caja</SoftButton>
        <SoftButton Type="@ButtonType.Primary" Icon="plus" OnClick="OpenDrawer">Nuevo Movimiento</SoftButton>
    </SoftHeroHeader>

    <!-- Date selector & Arqueo Overview -->
    <div class="row g-2 g-md-3 my-2 my-md-3">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="soft-card p-3 h-100 d-flex flex-column justify-content-center">
                <span class="text-muted small text-uppercase fw-bold mb-2">
                    <i class="bi bi-calendar3 me-1 text-primary"></i>Fecha de Arqueo
                </span>
                <DatePicker @bind-Value="_selectedDate"
                            @bind-Value:after="LoadDayRecordsAsync"
                            Format="dd/MM/yyyy"
                            Class="w-100" />
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="metric-card h-100">
                <div class="metric-icon bg-emerald-subtle">
                    <i class="bi bi-arrow-down-left-circle"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Total Ingresos</span>
                    <span class="metric-value tabular-nums text-success">+@TotalIncome.ToString("C0")</span>
                    <span class="metric-subtext">Entradas registradas</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="metric-card h-100">
                <div class="metric-icon bg-rose-subtle">
                    <i class="bi bi-arrow-up-right-circle"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Total Egresos</span>
                    <span class="metric-value tabular-nums text-danger">-@TotalExpense.ToString("C0")</span>
                    <span class="metric-subtext">Salidas y gastos</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="metric-card h-100">
                <div class="metric-icon @(CashBalance >= 0 ? "bg-blue-subtle" : "bg-rose-subtle")">
                    <i class="bi bi-safe2"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Cuadre Efectivo en Caja</span>
                    <span class="metric-value tabular-nums @(CashBalance >= 0 ? "text-primary" : "text-danger")">
                        @CashBalance.ToString("C0")
                    </span>
                    <span class="metric-subtext">Disponible físico</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Detail Card: Arqueo Breakdown -->
    <SoftDetailCard Title="Desglose por Medios de Pago (Arqueo)">
        <SoftDetailItem Label="Efectivo (Ingresos)"><span class="tabular-nums">@IncomeCash.ToString("C0")</span></SoftDetailItem>
        <SoftDetailItem Label="Efectivo (Salidas)"><span class="tabular-nums">@ExpenseCash.ToString("C0")</span></SoftDetailItem>
        <SoftDetailItem Label="Bancos / Transferencias"><span class="tabular-nums">@TotalTransfers.ToString("C0")</span></SoftDetailItem>
        <SoftDetailItem Label="Tarjetas Débito / Crédito"><span class="tabular-nums">@TotalCards.ToString("C0")</span></SoftDetailItem>
        <SoftDetailItem Label="Flujo Neto del Día" Highlight="true">
            <span class="tabular-nums fw-bold">@((TotalIncome - TotalExpense).ToString("C0"))</span>
        </SoftDetailItem>
    </SoftDetailCard>

    <!-- Filters Card -->
    <SoftFilterCard>
        <div class="row g-3 align-items-center">
            <div class="col-12 col-lg-5">
                <div class="d-flex align-items-center gap-1">
                    <Input Placeholder="Buscar por concepto o comprobante..."
                           @bind-Value="_searchTerm"
                           AllowClear="true"
                           PrefixIcon="search" />
                    <SoftVoiceButton @bind-TargetText="_searchTerm"
                                     Append="false"
                                     TooltipText="Buscar movimientos por voz"
                                     ButtonClass="btn-outline-secondary" />
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <RadioGroup @bind-Value="_typeFilter" ButtonStyle="@RadioButtonStyle.Solid">
                    <Radio RadioButton="true" Value="@("ALL")">Todos</Radio>
                    <Radio RadioButton="true" Value="@("INGRESO")">Ingresos</Radio>
                    <Radio RadioButton="true" Value="@("EGRESO")">Egresos</Radio>
                </RadioGroup>
            </div>
            <div class="col-12 col-lg-2 text-lg-end">
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                    <i class="bi bi-funnel me-1"></i> <b>@FilteredRecords.Count</b> movimientos
                </span>
            </div>
        </div>
    </SoftFilterCard>

    <!-- Data Table / Loading / Empty -->
    @if (_isLoading)
    {
        <div class="soft-card p-5 text-center">
            <Spin Tip="Cargando arqueo de caja..." />
        </div>
    }
    else if (!FilteredRecords.Any())
    {
        <SoftResultView Status="@ResultStatus.Info"
                        Title="Sin movimientos registrados"
                        Subtitle="@($"No se encontraron registros de caja para la fecha {_selectedDate:dd/MM/yyyy}.")">
            <SoftButton Type="@ButtonType.Primary" Icon="plus" OnClick="OpenDrawer">Registrar Primer Movimiento</SoftButton>
        </SoftResultView>
    }
    else
    {
        <div class="soft-card overflow-hidden">
            <Table TItem="DailyRecordDto"
                   DataSource="@FilteredRecords"
                   Responsive="true"
                   Size="@TableSize.Middle">
                <PropertyColumn Property="r => r.Date" Title="Hora" Width="95px" Align="ColumnAlign.Center">
                    <span class="tabular-nums small text-muted">
                        <i class="bi bi-clock me-1"></i>@context.Date.ToString("HH:mm")
                    </span>
                </PropertyColumn>
                <PropertyColumn Property="r => r.RecordType" Title="Tipo" Width="130px" Align="ColumnAlign.Center">
                    @{
                        bool isIngreso = context.RecordType == RecordType.INGRESO;
                    }
                    @if (isIngreso)
                    {
                        <span class="pill-badge badge-soft-success">
                            <i class="bi bi-arrow-down-left"></i> Ingreso
                        </span>
                    }
                    else
                    {
                        <span class="pill-badge badge-soft-danger">
                            <i class="bi bi-arrow-up-right"></i> Egreso
                        </span>
                    }
                </PropertyColumn>
                <PropertyColumn Property="r => r.PaymentMethod" Title="Medio Pago" Width="160px">
                    <span class="pill-badge badge-soft-primary">
                        <i class="bi bi-credit-card me-1"></i>@context.PaymentMethod
                    </span>
                </PropertyColumn>
                <PropertyColumn Property="r => r.Description" Title="Concepto / Descripción">
                    <span class="fw-semibold text-dark">@context.Description</span>
                    @if (!string.IsNullOrEmpty(context.Number))
                    {
                        <span class="badge bg-light text-secondary border ms-1 small">Ref: @context.Number</span>
                    }
                </PropertyColumn>
                <PropertyColumn Property="r => r.Value" Title="Valor" Width="145px" Align="ColumnAlign.Right">
                    <span class="fw-bold tabular-nums @(context.RecordType == RecordType.INGRESO ? "text-success" : "text-danger")">
                        @(context.RecordType == RecordType.INGRESO ? "+" : "-")@context.Value.ToString("C0")
                    </span>
                </PropertyColumn>
            </Table>
        </div>
    }

    <!-- SoftDrawer: Registrar Movimiento de Caja -->
    <SoftDrawer Visible="@_drawerVisible"
                Title="Registrar Movimiento de Caja"
                Description="@($"Fecha de registro: {_selectedDate:dd/MM/yyyy}")"
                Width="720"
                OnClose="CloseDrawer">
        <ChildContent>
            <Form Model="@_formModel" Layout="@FormLayout.Vertical">
                <SoftFormBox Title="Tipo y Medio de Pago">
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6">
                            <div class="quick-choice-card text-center @(_formModel.RecordType == RecordType.INGRESO ? "active" : "")"
                                 @onclick='() => _formModel.RecordType = RecordType.INGRESO'>
                                <div class="choice-icon bg-emerald-subtle">
                                    <i class="bi bi-arrow-down-left-circle"></i>
                                </div>
                                <div class="choice-title">Ingreso (Entrada)</div>
                                <div class="choice-desc">Ventas, abonos de clientes, cobro de intereses</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="quick-choice-card text-center @(_formModel.RecordType == RecordType.EGRESO ? "active" : "")"
                                 @onclick='() => _formModel.RecordType = RecordType.EGRESO'>
                                <div class="choice-icon bg-rose-subtle">
                                    <i class="bi bi-arrow-up-right-circle"></i>
                                </div>
                                <div class="choice-title">Egreso (Salida)</div>
                                <div class="choice-desc">Pago a proveedores, gastos o desembolsos</div>
                            </div>
                        </div>
                    </div>

                    <FormItem Label="Medio de Pago" Required="true">
                        <Select TItem="PaymentMethod"
                                TItemValue="PaymentMethod"
                                @bind-Value="_formModel.PaymentMethod"
                                EnableSearch="true"
                                DataSource="@_paymentMethodOptions" />
                    </FormItem>
                </SoftFormBox>

                @if (_formModel.RecordType == RecordType.INGRESO)
                {
                    <SoftFormBox Title="Venta y Descargo de Inventario (Opcional)" InfoTooltip="Si este ingreso corresponde a la venta de una joya o reloj, digite su referencia para descargarlo automáticamente del inventario.">
                        <FormItem Label="Referencia del Artículo a Descargar">
                            <div class="d-flex gap-2 align-items-center">
                                <AntDesign.InputNumber TValue="int?"
                                                       @bind-Value="_formModel.ItemReference"
                                                       Min="1"
                                                       Placeholder="Ej. 9493"
                                                       Style="width: 150px; font-weight: bold; font-size: 1.05rem;" />
                                <Button Type="@ButtonType.Dashed"
                                        Icon="search"
                                        Loading="@_isSearchingItem"
                                        OnClick="SearchInventoryItemAsync">
                                    Verificar Artículo
                                </Button>
                            </div>
                            <div class="form-text small text-muted mt-1">
                                Opcional. Al guardar el ingreso, el artículo quedará marcado como vendido/descargado con esta fecha y valor.
                            </div>
                        </FormItem>

                        @if (_foundItem != null)
                        {
                            <div class="alert alert-info py-2 px-3 small d-flex align-items-center justify-content-between my-2 rounded-3 border">
                                <div>
                                    <i class="bi bi-gem text-primary me-2 fs-5"></i>
                                    <strong>Ref #@_foundItem.Reference</strong>: @_foundItem.Description
                                    <span class="badge bg-secondary ms-2">@_foundItem.ItemTypeName</span>
                                    <span class="ms-2 text-muted">Costo: @_foundItem.CostValue.ToString("C0")</span>
                                    @if (!_foundItem.Active)
                                    {
                                        <span class="badge bg-danger ms-2">Ya fue vendido</span>
                                    }
                                </div>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" @onclick="ClearFoundItem">
                                    <i class="bi bi-x-circle"></i> Quitar
                                </button>
                            </div>
                        }
                    </SoftFormBox>
                }

                <SoftFormBox Title="Concepto y Valor del Movimiento">
                    <FormItem Label="Descripción o Concepto" Required="true">
                        <Input @bind-Value="_formModel.Description"
                               Placeholder="Ej: Pago de intereses contrato #104, Abono joya ref #52, Compra insumos oficina..." />
                    </FormItem>

                    <Row Gutter="16">
                        <Col Span="12">
                            <FormItem Label="Valor ($)" Required="true">
                                <AntDesign.InputNumber @bind-Value="_formModel.Value"
                                                       Min="0"
                                                       Step="10000"
                                                       Placeholder="0"
                                                       Class="w-100" />
                            </FormItem>
                        </Col>
                        <Col Span="12">
                            <FormItem Label="Nro. Comprobante / Contrato (Opcional)">
                                <Input @bind-Value="_formModel.Number" Placeholder="Ej: CTR-104 o REC-098" />
                            </FormItem>
                        </Col>
                    </Row>
                </SoftFormBox>
            </Form>
        </ChildContent>
        <FooterContent>
            <SoftButton OnClick="CloseDrawer">Cancelar</SoftButton>
            <SoftButton Type="@ButtonType.Primary"
                        Loading="@_isSaving"
                        OnClick="HandleRegisterRecordAsync">
                Guardar Movimiento
            </SoftButton>
        </FooterContent>
    </SoftDrawer>
</div>

@code {
    private DateTime _selectedDate = DateTime.Today;
    private List<DailyRecordDto> _dayRecords = new();
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private string _typeFilter = "ALL";

    // Drawer state
    private bool _drawerVisible;
    private bool _isSaving;
    private CashFormModel _formModel = new();
    private readonly List<PaymentMethod> _paymentMethodOptions = Enum.GetValues<PaymentMethod>().ToList();

    // Inventory Item Lookup & Discharge State
    private bool _isSearchingItem;
    private ItemDetailDto? _foundItem;

    private List<DailyRecordDto> FilteredRecords => _dayRecords
        .Where(r => _typeFilter == "ALL"
            || (_typeFilter == "INGRESO" && r.RecordType == RecordType.INGRESO)
            || (_typeFilter == "EGRESO" && r.RecordType == RecordType.EGRESO))
        .Where(r => string.IsNullOrWhiteSpace(_searchTerm)
            || r.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || (r.Number != null && r.Number.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private long TotalIncome => _dayRecords.Where(r => r.RecordType == RecordType.INGRESO).Sum(r => (long)r.Value);
    private long TotalExpense => _dayRecords.Where(r => r.RecordType == RecordType.EGRESO).Sum(r => (long)r.Value);
    private long IncomeCash => _dayRecords.Where(r => r.RecordType == RecordType.INGRESO && r.PaymentMethod == PaymentMethod.EFECTIVO).Sum(r => (long)r.Value);
    private long ExpenseCash => _dayRecords.Where(r => r.RecordType == RecordType.EGRESO && r.PaymentMethod == PaymentMethod.EFECTIVO).Sum(r => (long)r.Value);
    private long CashBalance => IncomeCash - ExpenseCash;
    private long TotalTransfers => _dayRecords.Where(r => r.PaymentMethod == PaymentMethod.TRANSFERENCIA).Sum(r => (long)r.Value);
    private long TotalCards => _dayRecords.Where(r => r.PaymentMethod is PaymentMethod.TARJETA_CREDITO or PaymentMethod.TARJETA_DEBITO).Sum(r => (long)r.Value);

    protected override async Task OnInitializedAsync()
    {
        await LoadDayRecordsAsync();
    }

    private async Task LoadDayRecordsAsync()
    {
        _isLoading = true;
        try
        {
            var res = await Sender.Send(new GetDailyRecordsListQuery(_selectedDate));
            if (res.IsSuccess)
            {
                _dayRecords = res.Value;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenDrawer()
    {
        _formModel = new CashFormModel
        {
            RecordType = RecordType.INGRESO,
            PaymentMethod = PaymentMethod.EFECTIVO,
            Value = 0
        };
        _foundItem = null;
        _drawerVisible = true;
    }

    private void CloseDrawer()
    {
        _drawerVisible = false;
        _foundItem = null;
    }

    private async Task SearchInventoryItemAsync()
    {
        if (!_formModel.ItemReference.HasValue || _formModel.ItemReference.Value <= 0)
        {
            MessageService.Warning("Ingrese un número de referencia para verificar.");
            return;
        }

        _isSearchingItem = true;
        try
        {
            var res = await Sender.Send(new GetItemByReferenceQuery(_formModel.ItemReference.Value));
            if (res.IsSuccess && res.Value != null)
            {
                _foundItem = res.Value;
                if (!_foundItem.Active)
                {
                    MessageService.Warning($"El artículo Ref #{_formModel.ItemReference.Value} ya se encuentra inactivo/descargado previamente ({_foundItem.DateOfSale:dd/MM/yyyy}).");
                }
                else
                {
                    if (string.IsNullOrWhiteSpace(_formModel.Description))
                    {
                        _formModel.Description = $"Venta {_foundItem.ItemTypeName} Ref #{_foundItem.Reference} - {_foundItem.Description}";
                    }
                    if (_formModel.Value <= 0)
                    {
                        _formModel.Value = (int)Math.Round(_foundItem.CostValue * 1.3);
                    }
                    MessageService.Success($"Artículo encontrado: {_foundItem.Description}");
                }
            }
            else
            {
                _foundItem = null;
                MessageService.Error($"No se encontró ningún artículo con la referencia #{_formModel.ItemReference.Value}.");
            }
        }
        catch (Exception ex)
        {
            MessageService.Error($"Error al consultar inventario: {ex.Message}");
        }
        finally
        {
            _isSearchingItem = false;
        }
    }

    private void ClearFoundItem()
    {
        _foundItem = null;
        _formModel.ItemReference = null;
    }

    private async Task HandleRegisterRecordAsync()
    {
        if (string.IsNullOrWhiteSpace(_formModel.Description))
        {
            MessageService.Error("La descripción del movimiento es obligatoria.");
            return;
        }
        if (_formModel.Value <= 0)
        {
            MessageService.Error("El valor debe ser mayor a 0.");
            return;
        }

        _isSaving = true;
        try
        {
            // Si indicó referencia para descargo de inventario, validar y ejecutar descargo
            if (_formModel.ItemReference.HasValue && _formModel.RecordType == RecordType.INGRESO)
            {
                var dischargeCmd = new DischargeItemByReferenceCommand(
                    _formModel.ItemReference.Value,
                    _selectedDate,
                    _formModel.Value
                );
                var dischargeRes = await Sender.Send(dischargeCmd);
                if (!dischargeRes.IsSuccess)
                {
                    MessageService.Error($"Error al descargar el artículo de inventario: {dischargeRes.Error.Message}");
                    return;
                }
            }

            var cmd = new CreateDailyRecordCommand(
                Date: _selectedDate,
                Reference: _formModel.ItemReference,
                Description: _formModel.Description.Trim(),
                Value: _formModel.Value,
                RecordType: _formModel.RecordType,
                PaymentMethod: _formModel.PaymentMethod,
                Number: _formModel.Number?.Trim()
            );

            var res = await Sender.Send(cmd);
            if (res.IsSuccess)
            {
                if (_formModel.ItemReference.HasValue)
                {
                    MessageService.Success($"¡Ingreso registrado y artículo Ref #{_formModel.ItemReference.Value} descargado del inventario exitosamente!");
                }
                else
                {
                    MessageService.Success("Movimiento registrado correctamente.");
                }
                _drawerVisible = false;
                await LoadDayRecordsAsync();
            }
            else
            {
                MessageService.Error(res.Error.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    public class CashFormModel
    {
        public string Description { get; set; } = string.Empty;
        public int Value { get; set; } = 0;
        public RecordType RecordType { get; set; } = RecordType.INGRESO;
        public PaymentMethod PaymentMethod { get; set; } = PaymentMethod.EFECTIVO;
        public string? Number { get; set; }
        public int? ItemReference { get; set; }
    }
}

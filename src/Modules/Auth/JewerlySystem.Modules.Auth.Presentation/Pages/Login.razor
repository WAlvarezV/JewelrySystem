@page "/"
@page "/login"
@attribute [AllowAnonymous]
@inject ISender Sender
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-2">
                            <i class="bi bi-gem fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark mt-2">JewerlySystem</h3>
                        <p class="text-muted small">Acceso seguro con Contraseña, MFA y Passkeys</p>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorFromQuery) || !string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@(ErrorFromQuery ?? _errorMessage)</span>
                        </div>
                    }

                    @if (MfaFromQuery == true)
                    {
                        @if (MethodFromQuery == "authenticator")
                        {
                            <div class="text-center mb-4">
                                <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-2">
                                    <i class="bi bi-phone-vibrate-fill fs-2"></i>
                                </div>
                                <h4 class="fw-bold text-dark mt-2">Código de Aplicación Móvil</h4>
                                <p class="text-muted small mb-0">
                                    Abre <strong>Google Authenticator</strong> o <strong>Microsoft Authenticator</strong> en tu celular e ingresa el código temporal de 6 dígitos.
                                </p>
                                <div class="mt-2">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                        <i class="bi bi-shield-check me-1"></i>Acceso directo sin correos
                                    </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center mb-4">
                                <div class="d-inline-flex p-3 rounded-circle bg-warning bg-opacity-10 text-warning mb-2">
                                    <i class="bi bi-shield-lock-fill fs-2"></i>
                                </div>
                                <h4 class="fw-bold text-dark mt-2">Segundo Factor (MFA)</h4>
                                <p class="text-muted small mb-0">
                                    Hemos enviado un código de 6 dígitos a:
                                    <br />
                                    <strong class="text-dark">@(EmailFromQuery ?? "tu correo registrado")</strong>
                                </p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(MessageFromQuery))
                        {
                            <div class="alert alert-success py-2 small d-flex align-items-center gap-2 mb-3" role="alert">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@MessageFromQuery</span>
                            </div>
                        }

                        <form method="post" action="/api/auth/verify-otp">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Código de Verificación</label>
                                <input name="otpCode" type="text" class="form-control form-control-lg text-center fw-bold fs-3 letter-spacing" placeholder="000000" maxlength="10" inputmode="numeric" autocomplete="one-time-code" autofocus required />
                                <div class="form-text text-center small">
                                    @(MethodFromQuery == "authenticator" ? "Código de 6 dígitos de tu app (o código de recuperación)." : "Válido durante 10 minutos. Revisa tu bandeja de entrada o spam.")
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold mb-3 shadow-sm">
                                Verificar y Acceder
                            </button>
                        </form>

                        <div class="position-relative text-center my-3">
                            <hr class="text-muted" />
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">o verifica con</span>
                        </div>

                        <button @onclick="HandlePasskeyLogin" type="button" class="btn btn-outline-dark btn-lg w-100 fw-semibold d-flex align-items-center justify-content-center gap-2 mb-3" disabled="@_isLoading">
                            <i class="bi bi-fingerprint fs-4 text-primary"></i>
                            <span>Passkey / Biometría</span>
                        </button>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            @if (MethodFromQuery != "authenticator")
                            {
                                <form method="post" action="/api/auth/resend-otp">
                                    <button type="submit" class="btn btn-link text-decoration-none p-0 small fw-semibold">
                                        <i class="bi bi-arrow-clockwise me-1"></i>Reenviar código
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Código rotativo (30s)</span>
                            }
                            <a href="/" class="btn btn-link text-secondary text-decoration-none p-0 small">
                                <i class="bi bi-arrow-left me-1"></i>Volver
                            </a>
                        </div>
                    }
                    else
                    {
                        <form method="post" action="/api/auth/login">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Usuario o Correo</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-muted"><i class="bi bi-person"></i></span>
                                    <input name="username" type="text" class="form-control" placeholder="walvarez@ingnova.team" autofocus required />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-muted"><i class="bi bi-lock"></i></span>
                                    <input name="password" type="password" class="form-control" placeholder="••••••••" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold mb-3 shadow-sm">
                                Continuar
                            </button>
                        </form>

                        <div class="position-relative text-center my-3">
                            <hr class="text-muted" />
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">o ingresa con</span>
                        </div>

                        <button @onclick="HandlePasskeyLogin" type="button" class="btn btn-outline-dark btn-lg w-100 fw-semibold d-flex align-items-center justify-content-center gap-2" disabled="@_isLoading">
                            <i class="bi bi-fingerprint fs-4 text-primary"></i>
                            <span>Passkey / Biometría</span>
                        </button>
                    }
                </div>
            </div>
            <div class="text-center text-muted small mt-3">
                &copy; 2026 JewerlySystem &bull; Todos los derechos reservados
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "message")]
    public string? MessageFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "mfa")]
    public bool? MfaFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? EmailFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "method")]
    public string? MethodFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "user")]
    public string? UserFromQuery { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/dashboard");
            }
        }
    }

    private async Task HandlePasskeyLogin()
    {
        _errorMessage = null;
        _isLoading = true;
        try
        {
            var query = new GetPasskeyAssertionOptionsQuery(null);
            var optResult = await Sender.Send(query);

            if (optResult.IsFailure)
            {
                _errorMessage = optResult.Error.Message;
                return;
            }

            var assertionJson = await JS.InvokeAsync<string>("webauthn.getAssertion", optResult.Value);
            var verifyCommand = new VerifyPasskeyAssertionCommand(assertionJson);
            var verifyResult = await Sender.Send(verifyCommand);

            if (verifyResult.IsFailure)
            {
                _errorMessage = verifyResult.Error.Message;
                return;
            }

            Navigation.NavigateTo("/dashboard", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = "Error de autenticación con Passkey: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}

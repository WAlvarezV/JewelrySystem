@page "/admin/permissions"
@attribute [Authorize(Roles = "Admin,Administrador")]
@inject ISender Sender
@inject NavigationManager Navigation

<div class="container-fluid mt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-shield-check text-primary me-2"></i>Matriz de Permisos por Rol</h3>
            <p class="text-muted small mb-0">Asigne granularmente qué acciones (Ver, Crear, Editar, Eliminar, Administrar) puede realizar cada rol en cada módulo y menú.</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="SavePermissionsAsync" disabled="@_isSaving">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <i class="bi bi-floppy2-fill"></i>
            }
            <span>Guardar Permisos</span>
        </button>
    </div>

    <!-- Role Selector & Quick Actions -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label fw-semibold small text-muted mb-1">Rol a Configurar</label>
                    <select class="form-select fw-semibold" value="@_selectedRole" @onchange="OnRoleChanged">
                        @foreach (var role in _roles)
                        {
                            <option value="@role.Name">@role.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-7 text-md-end pt-3 pt-md-0">
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary" @onclick="GrantAllPermissions">
                            <i class="bi bi-check-all me-1"></i> Conceder Todo
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="RevokeAllPermissions">
                            <i class="bi bi-x-circle me-1"></i> Revocar Todo
                        </button>
                        <button type="button" class="btn btn-outline-primary" @onclick="GrantViewOnly">
                            <i class="bi bi-eye me-1"></i> Solo Lectura
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    <!-- Permissions Matrix Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Módulo</th>
                        <th>Menú / Ruta</th>
                        <th class="text-center" style="width: 110px;">Ver</th>
                        <th class="text-center" style="width: 110px;">Crear</th>
                        <th class="text-center" style="width: 110px;">Editar</th>
                        <th class="text-center" style="width: 110px;">Eliminar</th>
                        <th class="text-center" style="width: 120px;">Administrar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="7" class="text-center p-5">
                                <div class="spinner-border text-primary" role="status"></div>
                            </td>
                        </tr>
                    }
                    else if (!_permissions.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center p-4 text-muted">
                                No hay opciones de menú disponibles para configurar.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var perm in _permissions)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-secondary-subtle text-secondary border font-monospace">@perm.ModuleKey</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@perm.MenuRoute</div>
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" checked="@perm.CanView"
                                           @onchange="(e) => perm.CanView = (bool)(e.Value ?? false)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" checked="@perm.CanCreate"
                                           @onchange="(e) => perm.CanCreate = (bool)(e.Value ?? false)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" checked="@perm.CanEdit"
                                           @onchange="(e) => perm.CanEdit = (bool)(e.Value ?? false)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" checked="@perm.CanDelete"
                                           @onchange="(e) => perm.CanDelete = (bool)(e.Value ?? false)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" checked="@perm.CanAdmin"
                                           @onchange="(e) => perm.CanAdmin = (bool)(e.Value ?? false)" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "role")]
    public string? RoleFromQuery { get; set; }

    private List<RoleItemDto> _roles = [];
    private string _selectedRole = "Administrador";
    private List<PermissionMatrixItem> _permissions = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _message;
    private string? _errorMessage;

    private class PermissionMatrixItem
    {
        public Guid Id { get; set; }
        public string RoleName { get; set; } = string.Empty;
        public string ModuleKey { get; set; } = string.Empty;
        public string MenuRoute { get; set; } = string.Empty;
        public bool CanView { get; set; }
        public bool CanCreate { get; set; }
        public bool CanEdit { get; set; }
        public bool CanDelete { get; set; }
        public bool CanAdmin { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        _isLoading = true;
        try
        {
            var roleRes = await Sender.Send(new GetAllRolesQuery());
            if (roleRes.IsSuccess)
            {
                _roles = roleRes.Value.ToList();
                if (!string.IsNullOrWhiteSpace(RoleFromQuery) && _roles.Any(r => r.Name == RoleFromQuery))
                {
                    _selectedRole = RoleFromQuery;
                }
                else if (_roles.Any())
                {
                    _selectedRole = _roles.First().Name;
                }
            }

            await LoadPermissionsForRoleAsync(_selectedRole);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _isLoading = false;
        }
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        _selectedRole = e.Value?.ToString() ?? "Administrador";
        await LoadPermissionsForRoleAsync(_selectedRole);
    }

    private async Task LoadPermissionsForRoleAsync(string roleName)
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var res = await Sender.Send(new GetPermissionsByRoleQuery(roleName));
            if (res.IsSuccess)
            {
                _permissions = res.Value.Select(p => new PermissionMatrixItem
                {
                    Id = p.Id,
                    RoleName = p.RoleName,
                    ModuleKey = p.ModuleKey,
                    MenuRoute = p.MenuRoute,
                    CanView = p.CanView,
                    CanCreate = p.CanCreate,
                    CanEdit = p.CanEdit,
                    CanDelete = p.CanDelete,
                    CanAdmin = p.CanAdmin
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GrantAllPermissions()
    {
        foreach (var p in _permissions)
        {
            p.CanView = true;
            p.CanCreate = true;
            p.CanEdit = true;
            p.CanDelete = true;
            p.CanAdmin = true;
        }
    }

    private void RevokeAllPermissions()
    {
        foreach (var p in _permissions)
        {
            p.CanView = false;
            p.CanCreate = false;
            p.CanEdit = false;
            p.CanDelete = false;
            p.CanAdmin = false;
        }
    }

    private void GrantViewOnly()
    {
        foreach (var p in _permissions)
        {
            p.CanView = true;
            p.CanCreate = false;
            p.CanEdit = false;
            p.CanDelete = false;
            p.CanAdmin = false;
        }
    }

    private async Task SavePermissionsAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _message = null;

        try
        {
            var dtoList = _permissions.Select(p => new PermissionItemDto(
                p.Id,
                _selectedRole,
                p.ModuleKey,
                p.MenuRoute,
                p.CanView,
                p.CanCreate,
                p.CanEdit,
                p.CanDelete,
                p.CanAdmin)).ToList();

            var res = await Sender.Send(new SavePermissionsCommand(_selectedRole, dtoList));
            if (res.IsSuccess)
            {
                _message = $"Permisos actualizados correctamente para el rol '{_selectedRole}'.";
            }
            else
            {
                _errorMessage = res.Error.Message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}

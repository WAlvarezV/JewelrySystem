@using AntDesign
@using JewerlySystem.Modules.Auth.Application
@using JewerlySystem.Web.Services
@implements IDisposable
@inject ISender Sender
@inject NavigationManager Navigation
@inject IUserPreferencesStateService PreferencesService

<div class="nav-menu-container d-flex flex-column h-100 border-end @(IsCollapsed ? "is-collapsed" : "")">
    <!-- Active Module Title & Action -->
    <div class="nav-menu-header p-3 border-bottom d-flex align-items-center @(IsCollapsed ? "justify-content-center px-1 py-3" : "justify-content-between")">
        @if (IsCollapsed)
        {
            <Tooltip Title="@ActiveModuleTitle" Placement="@Placement.Right">
                <span class="badge bg-primary-subtle text-primary p-2 rounded-3" style="cursor: pointer;" @onclick="OnToggleCollapse">
                    <i class="bi @ActiveModuleIcon fs-5"></i>
                </span>
            </Tooltip>
        }
        else
        {
            <div class="d-flex align-items-center gap-2 overflow-hidden">
                <span class="badge bg-primary-subtle text-primary p-2 rounded-3">
                    <i class="bi @ActiveModuleIcon fs-6"></i>
                </span>
                <div class="fw-bold text-truncate text-dark" style="font-size: 0.95rem;">
                    @ActiveModuleTitle
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-outline-warning border-0 p-1" title="Gestionar y Ordenar Favoritos" @onclick="() => _showFavDrawer = true">
                    <i class="bi bi-star-fill text-warning fs-5"></i>
                </button>
                @if (OnToggleCollapse.HasDelegate)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0 p-1 text-muted" title="Colapsar menú lateral" @onclick="OnToggleCollapse">
                        <i class="bi bi-chevron-left fs-5"></i>
                    </button>
                }
            </div>
        }
    </div>

    <!-- Scrollable Menu Content -->
    <div class="nav-menu-body flex-grow-1 overflow-auto @(IsCollapsed ? "px-1 py-2" : "p-2")">
        <!-- Favoritos Section (SI.SIOT Style) -->
        @{
            var currentFavorites = GetFavoriteMenus();
        }
        @if (currentFavorites.Count > 0)
        {
            <div class="nav-favorites-section mb-3">
                @if (!IsCollapsed)
                {
                    <div class="d-flex align-items-center justify-content-between px-2 py-1 text-muted small fw-semibold">
                        <span><i class="bi bi-star-fill text-warning me-1"></i>FAVORITOS</span>
                        <button type="button" class="btn btn-link p-0 text-decoration-none small text-muted" style="font-size: 0.75rem;" @onclick="() => _showFavDrawer = true">
                            Ordenar
                        </button>
                    </div>
                }
                <ul class="nav flex-column gap-1 @(IsCollapsed ? "align-items-center" : "") mt-1">
                    @foreach (var fav in currentFavorites)
                    {
                        <li class="nav-item w-100">
                            @if (IsCollapsed)
                            {
                                <Tooltip Title="@fav.Name" Placement="@Placement.Right">
                                    <NavLink class="@GetFavoriteItemClass()" href="@fav.Route" Match="NavLinkMatch.All">
                                        <i class="bi @(string.IsNullOrEmpty(fav.Icon) ? "bi-arrow-right-short" : fav.Icon) text-warning fs-5"></i>
                                    </NavLink>
                                </Tooltip>
                            }
                            else
                            {
                                <NavLink class="@GetFavoriteItemClass()" href="@fav.Route" Match="NavLinkMatch.All">
                                    <i class="bi @(string.IsNullOrEmpty(fav.Icon) ? "bi-arrow-right-short" : fav.Icon) text-warning"></i>
                                    <span class="text-truncate">@fav.Name</span>
                                </NavLink>
                            }
                        </li>
                    }
                </ul>
                <hr class="my-2 text-muted opacity-25" />
            </div>
        }

        <!-- Module Menus Section -->
        <div class="nav-module-menus">
            @if (!IsCollapsed)
            {
                <div class="px-2 py-1 text-muted small fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    OPCIONES DE @ActiveModuleKey
                </div>
            }

            @if (_isLoading)
            {
                <div class="text-center p-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>
            }
            else if (!_moduleMenus.Any())
            {
                @if (!IsCollapsed)
                {
                    <div class="text-muted small p-3 text-center">
                        No hay menús registrados para este módulo.
                    </div>
                }
            }
            else
            {
                <ul class="nav flex-column gap-1 @(IsCollapsed ? "align-items-center" : "") mt-1">
                    @foreach (var item in _moduleMenus)
                    {
                        bool isFav = PreferencesService.IsFavorite(item.Id);
                        <li class="nav-item w-100">
                            @if (IsCollapsed)
                            {
                                <Tooltip Title="@item.Name" Placement="@Placement.Right">
                                    <NavLink class="@GetMenuItemClass()" href="@item.Route" Match="NavLinkMatch.Prefix">
                                        <i class="bi @item.Icon text-secondary fs-5"></i>
                                    </NavLink>
                                </Tooltip>
                            }
                            else
                            {
                                <div class="menu-node-item-row">
                                    <NavLink class="@GetMenuItemClass()" href="@item.Route" Match="NavLinkMatch.Prefix">
                                        <i class="bi @item.Icon text-secondary fs-6"></i>
                                        <span class="menu-node-item-label">@item.Name</span>
                                    </NavLink>
                                    <button type="button"
                                            class="menu-favorite-btn @(isFav ? "active" : "")"
                                            title="@(isFav ? "Quitar de favoritos" : "Agregar a favoritos")"
                                            aria-label="@(isFav ? $"Quitar {item.Name} de favoritos" : $"Agregar {item.Name} a favoritos")"
                                            aria-pressed="@isFav.ToString().ToLowerInvariant()"
                                            @onclick="() => ToggleFavoriteAsync(item.Id)"
                                            @onclick:stopPropagation="true">
                                        <i class="bi @(isFav ? "bi-star-fill" : "bi-star")"></i>
                                    </button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <!-- Acceso Directo Fijo al Manual de Usuario y Ayuda -->
    <div class="nav-menu-help-footer p-2 border-top bg-light bg-opacity-25 mt-auto">
        @if (IsCollapsed)
        {
            <Tooltip Title="Manual de Usuario y Ayuda" Placement="@Placement.Right">
                <a href="manual" class="nav-link nav-item-link d-flex align-items-center justify-content-center py-2 rounded-2 text-secondary" title="Manual de Usuario y Ayuda">
                    <i class="bi bi-question-circle-fill text-primary fs-5"></i>
                </a>
            </Tooltip>
        }
        else
        {
            <a href="manual" class="nav-link nav-item-link d-flex align-items-center justify-content-between px-3 py-2 rounded-2 text-dark shadow-2xs" style="background: rgba(255,255,255,0.85); border: 1px solid rgba(112, 28, 44, 0.2);">
                <div class="d-flex align-items-center gap-2 text-truncate">
                    <i class="bi bi-book-half text-primary fs-6"></i>
                    <span class="fw-semibold text-truncate" style="font-size: 0.85rem;">Manual & Ayuda</span>
                </div>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Guía</span>
            </a>
        }
    </div>
</div>

<!-- Drawer: Administrador y Ordenador de Favoritos y Módulos (SI.SIOT Style) -->
<FavoriteManagerDrawer @bind-Visible="_showFavDrawer" AllMenus="_allMenus" Modules="PreferencesService.Modules" />

<style>
    .menu-node-item-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        gap: 4px;
        position: relative;
        border-radius: var(--soft-border-radius-md, 8px);
    }
    .menu-node-item-row .nav-item-link {
        flex: 1 1 auto;
        min-width: 0;
    }
    .menu-node-item-label {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .menu-favorite-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border: none;
        background: transparent;
        color: #94a3b8;
        border-radius: 4px;
        cursor: pointer;
        opacity: 0.35;
        transition: opacity 0.15s ease, color 0.15s ease, transform 0.15s ease;
        flex-shrink: 0;
        padding: 0;
        margin-right: 4px;
    }
    .menu-node-item-row:hover .menu-favorite-btn,
    .menu-favorite-btn:focus-visible,
    .menu-favorite-btn.active {
        opacity: 1;
    }
    .menu-favorite-btn.active {
        color: #f59e0b;
        opacity: 1;
    }
    .menu-favorite-btn:hover {
        color: #f59e0b;
        opacity: 1;
        transform: scale(1.2);
    }
    .nav-item-link {
        color: var(--soft-text-body, #374151);
        transition: all 0.15s ease-in-out;
        border-radius: var(--soft-border-radius-md, 8px) !important;
    }
    .nav-item-link:hover {
        background-color: var(--nav-hover-bg, #f3f4f6);
        color: var(--soft-text-title, #111827);
        border-radius: var(--soft-border-radius-md, 8px) !important;
    }
    .nav-item-link.active {
        background-color: var(--brand-primary-light, #FBF0F2) !important;
        color: var(--nav-active-text, var(--brand-primary, #701C2C)) !important;
        font-weight: 600;
        border-radius: var(--soft-border-radius-md, 8px) !important;
    }
    .nav-item-link.active i {
        color: var(--nav-active-text, var(--brand-primary, #701C2C)) !important;
    }
    .nav-favorite-link {
        transition: background-color 0.15s;
        border-radius: var(--soft-border-radius-md, 8px) !important;
    }
    .nav-favorite-link:hover {
        background-color: #fef3c7;
        border-radius: var(--soft-border-radius-md, 8px) !important;
    }
    .nav-favorite-link.active {
        background-color: #fef3c7;
        color: #92400e !important;
        font-weight: 600;
        border-radius: var(--soft-border-radius-md, 8px) !important;
    }
    .nav-menu-body {
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
    }
    .nav-menu-body::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
    }
</style>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    [Parameter]
    public string ActiveModuleKey { get; set; } = "CONTRACTS";

    [Parameter]
    public string ActiveModuleTitle { get; set; } = "Contratos";

    [Parameter]
    public string ActiveModuleIcon { get; set; } = "bi-file-earmark-text";

    [Parameter]
    public string UserId { get; set; } = "system-user";

    private List<MenuDto> _moduleMenus = [];
    private List<MenuDto> _allMenus = [];
    private bool _isLoading = true;
    private bool _showFavDrawer;
    private string _lastModuleKey = "";

    private string GetFavoriteItemClass() =>
        IsCollapsed 
            ? "nav-link nav-favorite-link d-flex align-items-center justify-content-center px-1 py-2 rounded-2 text-dark small"
            : "nav-link nav-favorite-link d-flex align-items-center gap-2 px-2 py-1 rounded-2 text-dark small";

    private string GetMenuItemClass() =>
        IsCollapsed 
            ? "nav-link nav-item-link d-flex align-items-center justify-content-center px-1 py-2 rounded-2 text-dark"
            : "nav-link nav-item-link d-flex align-items-center gap-2 px-3 py-2 rounded-2 text-dark";

    protected override void OnInitialized()
    {
        PreferencesService.OnChange += HandlePreferencesChanged;
    }

    protected override void OnParametersSet()
    {
        if (_lastModuleKey != ActiveModuleKey)
        {
            _lastModuleKey = ActiveModuleKey;
            FilterMenus();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _lastModuleKey = ActiveModuleKey;
        await LoadAllMenusAsync();
    }

    private void HandlePreferencesChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadAllMenusAsync()
    {
        try
        {
            var allRes = await Sender.Send(new GetNavigationMenusQuery(UserId: UserId));
            if (allRes.IsSuccess)
            {
                _allMenus = allRes.Value.ToList();
            }

            FilterMenus();
        }
        catch
        {
            // fallback
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterMenus()
    {
        if (string.IsNullOrWhiteSpace(ActiveModuleKey) || ActiveModuleKey.Equals("ALL", StringComparison.OrdinalIgnoreCase))
        {
            _moduleMenus = _allMenus.Where(m => m.ParentId == null).ToList();
        }
        else
        {
            _moduleMenus = _allMenus
                .Where(m => string.Equals(m.ModuleKey, ActiveModuleKey, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private List<MenuDto> GetFavoriteMenus()
    {
        var map = _allMenus.ToDictionary(m => m.Id);
        var list = new List<MenuDto>();
        foreach (var id in PreferencesService.FavoriteMenuIds)
        {
            if (map.TryGetValue(id, out var item))
            {
                list.Add(item);
            }
        }
        return list;
    }

    private async Task ToggleFavoriteAsync(Guid menuId)
    {
        await PreferencesService.ToggleFavoriteAsync(menuId);
    }

    public void Dispose()
    {
        PreferencesService.OnChange -= HandlePreferencesChanged;
    }
}

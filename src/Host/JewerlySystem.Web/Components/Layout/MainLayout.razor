@inherits LayoutComponentBase
@inject ISender Sender
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="app-container d-flex" style="height: 100vh; overflow: hidden;">
            <!-- 1. PRIMARY RAIL (SI.SIOT Style Module Bar) -->
            <aside class="app-primary-rail d-flex flex-column align-items-center py-2 bg-dark text-white border-end" style="width: 74px; min-width: 74px; z-index: 1020; background-color: #111827 !important;">
                <!-- Brand / Logo -->
                <div class="rail-logo my-2 text-center">
                    <a href="dashboard" class="text-decoration-none">
                        <div class="d-inline-flex p-2 rounded-3 bg-primary text-white shadow-sm">
                            <i class="bi bi-gem fs-4"></i>
                        </div>
                    </a>
                    <div class="text-white-50" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.5px;">JS 2.0</div>
                </div>

                <hr class="w-75 my-2 border-secondary opacity-25" />

                <!-- Module Navigation Buttons -->
                <nav class="rail-modules-nav d-flex flex-column align-items-center gap-2 w-100 px-1 overflow-auto flex-grow-1">
                    @foreach (var mod in _modules)
                    {
                        bool isActive = string.Equals(_activeModuleKey, mod.Key, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="rail-module-btn w-100 d-flex flex-column align-items-center justify-content-center py-2 px-1 border-0 rounded-3 text-decoration-none @(isActive ? "active" : "")"
                                title="@mod.Name: @mod.Description"
                                @onclick="() => SelectModule(mod)">
                            <i class="bi @mod.Icon fs-4 mb-1"></i>
                            <span class="rail-module-label text-truncate w-100 text-center" style="font-size: 0.68rem; font-weight: 500;">
                                @mod.Name
                            </span>
                        </button>
                    }
                </nav>

                <!-- Bottom User Avatar -->
                <div class="mt-auto py-2 text-center w-100 border-top border-secondary border-opacity-25">
                    <a href="profile" class="text-decoration-none" title="Mi Perfil (@(context.User.Identity?.Name ?? "Usuario"))">
                        <div class="avatar-small mx-auto rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center shadow-sm"
                             style="width: 36px; height: 36px; font-size: 0.85rem; cursor: pointer;">
                            @(context.User.Identity?.Name?.Length > 0 ? context.User.Identity.Name[0].ToString().ToUpper() : "U")
                        </div>
                    </a>
                </div>
            </aside>

            <!-- 2. SIDER WITH NAVMENU (Filtered by Active Module + Favorites) -->
            <aside class="soft-sider h-100 bg-white @(_isSiderCollapsed ? "collapsed" : "")">
                <NavMenu ActiveModuleKey="@_activeModuleKey"
                         ActiveModuleTitle="@_activeModuleTitle"
                         ActiveModuleIcon="@_activeModuleIcon"
                         UserId="@(context.User.Identity?.Name ?? "system-user")"
                         IsCollapsed="@_isSiderCollapsed"
                         OnToggleCollapse="ToggleSider" />
            </aside>

            <!-- 3. MAIN CONTENT WORKSPACE -->
            <div class="app-main-workspace flex-grow-1 d-flex flex-column h-100 bg-light" style="overflow-y: auto;">
                <!-- Header Topbar -->
                <header class="navbar navbar-white bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center sticky-top shadow-sm">
                    <div class="d-flex align-items-center gap-2">
                        <!-- Botón para Colapsar/Expandir Menú Lateral (SI.SIOT Style) -->
                        <button type="button"
                                class="btn btn-sm btn-light border rounded-2 d-flex align-items-center justify-content-center p-2 text-secondary sider-toggle-btn"
                                @onclick="ToggleSider"
                                title="@(_isSiderCollapsed ? "Expandir menú de navegación" : "Ocultar menú lateral")">
                            <i class="bi @(_isSiderCollapsed ? "bi-layout-sidebar text-primary" : "bi-layout-sidebar-inset text-secondary") fs-5"></i>
                        </button>

                        <span class="text-muted small d-none d-sm-inline">Módulo actual:</span>
                        <span class="badge bg-primary text-white px-2 py-1 fw-semibold d-flex align-items-center gap-1">
                            <i class="bi @_activeModuleIcon"></i> @_activeModuleTitle
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Botón Asistente de Operaciones por Voz con IA -->
                        <button type="button"
                                class="btn btn-sm d-flex align-items-center gap-2 px-3 py-1 shadow-sm rounded-pill fw-semibold text-white border-0 voice-header-btn"
                                @onclick="() => _showVoiceModal = true"
                                title="Dictar cualquier operación (Ventas, Contratos, Clientes, Gastos) de la forma más simple">
                            <i class="bi bi-stars text-warning fs-6"></i>
                            <i class="bi bi-mic-fill fs-6"></i>
                            <span class="small">Dictar con IA</span>
                        </button>

                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                            <i class="bi bi-shield-check me-1"></i> MFA & Passkeys Activo
                        </span>

                        <div class="vr my-1 text-muted"></div>

                        <div class="d-flex align-items-center gap-2">
                            <a href="profile" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 py-1 px-2 text-decoration-none" title="Mi Perfil y Contraseña">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-md-inline fw-medium">Mi Perfil</span>
                            </a>
                            <span class="small fw-semibold text-dark">
                                @(context.User.Identity?.Name ?? "Usuario Conectado")
                            </span>
                            <form method="post" action="/logout" class="d-inline">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1 py-1 px-2" title="Cerrar sesión">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Salir</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </header>

                <!-- Page Body -->
                <main class="p-4 flex-grow-1">
                    @Body
                </main>
            </div>
            <AntContainer />
            <SoftVoiceAssistantModal @bind-Visible="_showVoiceModal" />

            <!-- Floating Action Button: Acceso Inmediato al Asistente de Voz IA -->
            <button type="button"
                    class="soft-voice-fab shadow-lg"
                    @onclick="() => _showVoiceModal = true"
                    title="Dictado Rápido con IA">
                <i class="bi bi-mic-fill text-white fs-4"></i>
                <span class="soft-voice-fab-badge">IA</span>
            </button>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Unauthenticated View: Fullscreen Centered Login, Zero Menu -->
        <div class="min-vh-100 d-flex flex-column bg-light align-items-center justify-content-center p-3">
            @Body
            <AntContainer />
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    /* SI.SIOT Collapsible Sider Animation & Specs */
    .soft-sider {
        width: 250px;
        min-width: 250px;
        max-width: 250px;
        transition: width 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                    min-width 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                    max-width 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.18s ease-in-out;
        overflow: hidden;
        white-space: nowrap;
    }

    .soft-sider.collapsed {
        width: 68px !important;
        min-width: 68px !important;
        max-width: 68px !important;
        opacity: 1 !important;
        pointer-events: auto !important;
    }

    /* Ocultar barras de desplazamiento laterales en el menú de módulos */
    .rail-modules-nav {
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
    }
    .rail-modules-nav::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
    }

    .rail-module-btn {
        background-color: transparent;
        color: #9ca3af;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        border-radius: var(--soft-border-radius-lg, 12px) !important;
    }
    .rail-module-btn:hover {
        background-color: #1f2937;
        color: #ffffff;
        border-radius: var(--soft-border-radius-lg, 12px) !important;
    }
    .rail-module-btn.active {
        background-color: #2563eb !important;
        color: #ffffff !important;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.45);
        border-radius: var(--soft-border-radius-lg, 12px) !important;
    }
    .rail-module-btn.active i {
        color: #ffffff;
    }

    /* Sider Toggle Button */
    .sider-toggle-btn {
        transition: all 0.15s ease-in-out;
    }
    .sider-toggle-btn:hover {
        background-color: #f3f4f6;
        color: #111827;
    }

    /* Voice Header Button */
    .voice-header-btn {
        background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%) !important;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .voice-header-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35) !important;
    }

    /* Floating Action Button for Voice Assistant */
    .soft-voice-fab {
        position: fixed;
        bottom: 24px;
        right: 28px;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 1040;
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.4);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .soft-voice-fab:hover {
        transform: translateY(-3px) scale(1.06);
        box-shadow: 0 12px 28px rgba(124, 58, 237, 0.5);
    }
    .soft-voice-fab-badge {
        position: absolute;
        top: -2px;
        right: -2px;
        background: #f59e0b;
        color: #111827;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 1px 5px;
        border-radius: 9999px;
        border: 2px solid #ffffff;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _showVoiceModal;
    private bool _isSiderCollapsed;
    private List<AppModuleDto> _modules = [];
    private string _activeModuleKey = "CONTRACTS";
    private string _activeModuleTitle = "Contratos";
    private string _activeModuleIcon = "bi-file-earmark-text";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string? currentUserName = null;
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                currentUserName = auth.User.Identity?.Name;
            }

            var res = await Sender.Send(new GetNavigationModulesQuery(currentUserName));
            if (res.IsSuccess && res.Value.Any())
            {
                _modules = res.Value.ToList();
                var first = _modules.First();
                _activeModuleKey = first.Key;
                _activeModuleTitle = first.Name;
                _activeModuleIcon = first.Icon;
            }
        }
        catch
        {
            // fallback
        }
    }

    private void ToggleSider()
    {
        _isSiderCollapsed = !_isSiderCollapsed;
    }

    private void SelectModule(AppModuleDto module)
    {
        if (string.Equals(_activeModuleKey, module.Key, StringComparison.OrdinalIgnoreCase) && !_isSiderCollapsed)
        {
            // Si hace clic en el mismo módulo ya abierto, colapsa el menú
            _isSiderCollapsed = true;
        }
        else
        {
            _activeModuleKey = module.Key;
            _activeModuleTitle = module.Name;
            _activeModuleIcon = module.Icon;
            _isSiderCollapsed = false; // Despliega siempre al cambiar de módulo
        }
    }
}

@inherits LayoutComponentBase
@implements IDisposable
@inject ISender Sender
@inject NavigationManager Navigation
@inject ITenantContext TenantContext
@inject IJSRuntime JS
@inject JewerlySystem.Web.Services.IUserPreferencesStateService PreferencesService

<PageTitle>@TenantContext.CurrentTenant.Name</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="app-container d-flex" style="height: 100vh; height: 100dvh; overflow: hidden;">
            <!-- 1. PRIMARY RAIL (Luxury Module Bar - Desktop & Laptop ≥ 768px) -->
            <aside class="app-primary-rail d-none d-md-flex flex-column align-items-center py-2 text-white border-end"
                   style="width: 76px; min-width: 76px; z-index: 1020; background-color: var(--brand-rail-bg, #1B050A) !important; border-color: var(--brand-rail-border, #380C16) !important;">
                <!-- Brand / Logo -->
                <div class="rail-logo my-2 text-center">
                    <a href="dashboard" class="text-decoration-none d-flex flex-column align-items-center" title="@TenantContext.CurrentTenant.Name">
                        <div class="d-inline-flex p-1 rounded-3 align-items-center justify-content-center shadow-sm"
                             style="width: 44px; height: 44px; background: var(--brand-primary-gradient); border: 1.5px solid rgba(212, 175, 55, 0.45); box-shadow: 0 4px 10px rgba(0,0,0,0.35);">
                            <img src="@TenantContext.CurrentTenant.SymbolUrl" alt="@TenantContext.CurrentTenant.ShortName" style="width: 32px; height: 32px; object-fit: contain;" />
                        </div>
                        <div class="text-white mt-1 text-truncate" style="font-family: 'Cinzel', 'Playfair Display', Georgia, serif; font-size: 0.65rem; font-weight: 700; letter-spacing: 1.2px; max-width: 72px;">
                            @TenantContext.CurrentTenant.ShortName
                        </div>
                    </a>
                </div>

                <hr class="w-75 my-2 border-secondary opacity-25" />

                <!-- Module Navigation Buttons -->
                <nav class="rail-modules-nav d-flex flex-column align-items-center gap-2 w-100 px-1 overflow-auto flex-grow-1">
                    @foreach (var mod in _modules)
                    {
                        bool isActive = string.Equals(_activeModuleKey, mod.Key, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="rail-module-btn w-100 d-flex flex-column align-items-center justify-content-center py-2 px-1 border-0 rounded-3 text-decoration-none @(isActive ? "active" : "")"
                                title="@mod.Name: @mod.Description"
                                @onclick="() => SelectModule(mod)">
                            <i class="bi @mod.Icon fs-4 mb-1"></i>
                            <span class="rail-module-label text-truncate w-100 text-center" style="font-size: 0.68rem; font-weight: 500;">
                                @mod.Name
                            </span>
                        </button>
                    }
                </nav>
            </aside>

            <!-- 2. SIDER WITH NAVMENU (Desktop & Laptop ≥ 768px, Filtered by Active Module + Favorites) -->
            <aside class="soft-sider d-none d-md-block h-100 @(_isSiderCollapsed ? "collapsed" : "")">
                <NavMenu ActiveModuleKey="@_activeModuleKey"
                         ActiveModuleTitle="@_activeModuleTitle"
                         ActiveModuleIcon="@_activeModuleIcon"
                         UserId="@(context.User.Identity?.Name ?? "system-user")"
                         IsCollapsed="@_isSiderCollapsed"
                         OnToggleCollapse="ToggleSider" />
            </aside>

            <!-- 2.1 MOBILE OFFCANVAS DRAWER (Slide-Over navigation on < 768px) -->
            @if (_isMobileDrawerOpen)
            {
                <div class="mobile-nav-backdrop d-md-none" @onclick="CloseMobileDrawer"></div>
            }
            <aside class="mobile-nav-drawer d-md-none @(_isMobileDrawerOpen ? "open" : "")" aria-hidden="@(!_isMobileDrawerOpen)">
                <!-- Mobile Drawer Header -->
                <div class="mobile-drawer-header p-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <div class="p-1 rounded-2 bg-white bg-opacity-10 border border-white border-opacity-25 d-flex align-items-center justify-content-center shadow-xs" style="width: 36px; height: 36px;">
                            <img src="@TenantContext.CurrentTenant.SymbolUrl" alt="@TenantContext.CurrentTenant.ShortName" style="width: 26px; height: 26px; object-fit: contain;" />
                        </div>
                        <div class="min-w-0">
                            <div class="fw-bold text-white text-truncate" style="font-family: 'Cinzel', Georgia, serif; font-size: 0.95rem; line-height: 1.15;">
                                @TenantContext.CurrentTenant.Name
                            </div>
                            <div class="text-white-50 text-truncate" style="font-size: 0.68rem; letter-spacing: 0.5px;">@TenantContext.CurrentTenant.ShortName &bull; Joyería & Relojería</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-light border-0 rounded-circle p-1 d-flex align-items-center justify-content-center ms-2"
                            style="width: 34px; height: 34px;" @onclick="CloseMobileDrawer" title="Cerrar menú">
                        <i class="bi bi-x-lg fs-6"></i>
                    </button>
                </div>

                <!-- Module Selector Pills (Quick switch between all modules) -->
                <div class="mobile-modules-bar p-2 border-bottom">
                    <div class="small fw-bold text-muted px-2 py-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">MÓDULO:</div>
                    <div class="d-flex gap-1.5 overflow-auto py-1 px-1 mobile-modules-scroll">
                        @foreach (var mod in _modules)
                        {
                            bool isActive = string.Equals(_activeModuleKey, mod.Key, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="mobile-module-pill @(isActive ? "active" : "")"
                                    @onclick="() => SelectMobileModule(mod)">
                                <i class="bi @mod.Icon"></i>
                                <span>@mod.Name</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- NavMenu Content inside Mobile Drawer -->
                <div class="mobile-nav-content flex-grow-1 overflow-auto">
                    <NavMenu ActiveModuleKey="@_activeModuleKey"
                             ActiveModuleTitle="@_activeModuleTitle"
                             ActiveModuleIcon="@_activeModuleIcon"
                             UserId="@(context.User.Identity?.Name ?? "system-user")"
                             IsCollapsed="false" />
                </div>

                <!-- Mobile Drawer Footer Actions -->
                <div class="mobile-drawer-footer p-3 border-top d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="small text-muted fw-semibold" style="font-size: 0.78rem;"><i class="bi bi-palette2 me-1"></i>Tema visual:</span>
                        <ThemeSelector />
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="small text-muted fw-semibold" style="font-size: 0.78rem;"><i class="bi bi-shop me-1"></i>Sede / Joyería:</span>
                        <TenantSelector />
                    </div>
                    <div class="d-flex gap-2 pt-2 border-top">
                        <a href="manual" class="btn btn-sm btn-light border flex-grow-1 d-flex align-items-center justify-content-center gap-1 py-1.5" @onclick="CloseMobileDrawer">
                            <i class="bi bi-book-half text-info"></i>
                            <span class="small fw-semibold">Manual</span>
                        </a>
                        <a href="profile" class="btn btn-sm btn-light border flex-grow-1 d-flex align-items-center justify-content-center gap-1 py-1.5" @onclick="CloseMobileDrawer">
                            <i class="bi bi-person text-primary"></i>
                            <span class="small fw-semibold">Mi Perfil</span>
                        </a>
                        <form method="post" action="/logout" class="m-0 p-0 flex-grow-1">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-1 py-1.5">
                                <i class="bi bi-box-arrow-right"></i>
                                <span class="small fw-semibold">Cerrar Sesión</span>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- 3. MAIN CONTENT WORKSPACE -->
            <div class="app-main-workspace flex-grow-1 d-flex flex-column h-100" style="overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch;">
                <!-- Header Topbar -->
                <header class="navbar app-header px-3 px-md-4 py-2 d-flex justify-content-between align-items-center sticky-top shadow-sm">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <!-- Desktop Sider Toggle Button (≥ 768px) -->
                        <button type="button"
                                class="btn btn-sm btn-light border rounded-2 d-none d-md-flex align-items-center justify-content-center p-2 text-secondary sider-toggle-btn"
                                @onclick="ToggleSider"
                                title="@(_isSiderCollapsed ? "Expandir menú de navegación" : "Ocultar menú lateral")">
                            <i class="bi @(_isSiderCollapsed ? "bi-layout-sidebar text-primary" : "bi-layout-sidebar-inset text-secondary") fs-5"></i>
                        </button>

                        <!-- Mobile Menu Hamburger Button (< 768px) -->
                        <button type="button"
                                class="btn btn-sm btn-light border rounded-2 d-flex d-md-none align-items-center justify-content-center p-2 text-secondary mobile-menu-toggle-btn"
                                @onclick="ToggleMobileDrawer"
                                title="Abrir menú de navegación">
                            <i class="bi bi-list fs-5"></i>
                        </button>

                        <!-- Mobile Tenant Brand (Visible only on mobile header) -->
                        <div class="d-flex align-items-center gap-2 d-md-none min-w-0">
                            <img src="@TenantContext.CurrentTenant.SymbolUrl" alt="" style="width: 22px; height: 22px; object-fit: contain;" />
                            <span class="fw-bold text-dark text-truncate" style="font-family: 'Cinzel', Georgia, serif; font-size: 0.88rem; max-width: 130px;">
                                @TenantContext.CurrentTenant.ShortName
                            </span>
                        </div>

                        <!-- Desktop Module Badge (≥ 768px) -->
                        <span class="text-muted small d-none d-xl-inline">Módulo actual:</span>
                        <span class="badge bg-primary px-2.5 py-1.5 fw-semibold d-none d-md-inline-flex align-items-center gap-1">
                            <i class="bi @_activeModuleIcon"></i> @_activeModuleTitle
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-1 gap-sm-2 ms-auto">
                        <!-- Botón Asistente de Operaciones por Voz con IA -->
                        <button type="button"
                                class="btn btn-sm d-flex align-items-center gap-1.5 px-2 px-sm-3 py-1 shadow-sm rounded-pill fw-semibold border-0 voice-header-btn"
                                @onclick="() => _showVoiceModal = true"
                                title="Dictar cualquier operación (Ventas, Contratos, Clientes, Gastos) de la forma más simple">
                            <i class="bi bi-stars text-warning fs-6"></i>
                            <i class="bi bi-mic-fill fs-6"></i>
                            <span class="small d-none d-sm-inline">Dictar con IA</span>
                        </button>

                        <!-- Botón de Ayuda Contextual en el Header -->
                        <HelpButton />

                        <!-- Selector de Joyerías (Multi-tenant) -->
                        <TenantSelector />

                        <!-- Selector de Temas Visuales (Ant Design Themes) -->
                        <div class="d-none d-sm-inline-flex">
                            <ThemeSelector />
                        </div>

                        <div class="vr my-1 text-muted opacity-25 d-none d-md-block"></div>

                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 d-none d-lg-inline-flex align-items-center">
                            <i class="bi bi-shield-check me-1"></i> MFA Activo
                        </span>

                        <div class="vr my-1 text-muted opacity-25 d-none d-md-block"></div>

                        <!-- Dropdown de Usuario (SI.SIOT Style - Alineado a la derecha con inicial y nombre) -->
                        <div class="position-relative d-inline-flex align-items-center user-dropdown-container">
                            <button type="button"
                                    class="btn btn-sm btn-light border d-flex align-items-center gap-1.5 px-2 py-1 rounded-2 shadow-2xs user-profile-toggle-btn"
                                    title="Opciones de cuenta de usuario"
                                    @onclick="ToggleUserDropdown">
                                <div class="avatar-small rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center shadow-xs"
                                     style="width: 28px; height: 28px; font-size: 0.78rem;">
                                    @(context.User.Identity?.Name?.Length > 0 ? context.User.Identity.Name[0].ToString().ToUpper() : "U")
                                </div>
                                <span class="small fw-semibold text-dark d-none d-sm-inline text-truncate" style="max-width: 130px;">
                                    @(context.User.Identity?.Name ?? "Usuario")
                                </span>
                                <i class="bi @(_isUserDropdownOpen ? "bi-chevron-up" : "bi-chevron-down") text-muted" style="font-size: 0.65rem;"></i>
                            </button>

                            @if (_isUserDropdownOpen)
                            {
                                <!-- Backdrop para cerrar al hacer clic afuera -->
                                <div class="user-dropdown-backdrop"
                                     style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040; background: transparent;"
                                     @onclick="CloseUserDropdown"></div>

                                <div class="dropdown-menu show dropdown-menu-end shadow-lg border p-1 rounded-3 user-dropdown-menu"
                                     style="position: absolute; right: 0; top: 100%; margin-top: 6px; z-index: 1050; min-width: 230px; max-width: calc(100vw - 20px);">
                                    <!-- Header con avatar y nombre -->
                                    <div class="px-3 py-2 border-bottom d-flex align-items-center gap-2 mb-1">
                                        <div class="avatar-small rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center shadow-xs"
                                             style="width: 36px; height: 36px; font-size: 0.95rem;">
                                            @(context.User.Identity?.Name?.Length > 0 ? context.User.Identity.Name[0].ToString().ToUpper() : "U")
                                        </div>
                                        <div class="d-flex flex-column min-w-0">
                                            <span class="small fw-bold text-dark text-truncate">
                                                @(context.User.Identity?.Name ?? "Usuario")
                                            </span>
                                            <span class="text-muted" style="font-size: 0.7rem;">
                                                <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.45rem;"></i>Sesión activa
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Opción: Mi Perfil -->
                                    <a href="profile"
                                       class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 rounded-2 text-secondary"
                                       style="cursor: pointer; transition: all 0.15s ease;"
                                       @onclick="CloseUserDropdown">
                                        <i class="bi bi-person-circle text-primary fs-6"></i>
                                        <span style="font-size: 0.85rem;">Mi Perfil</span>
                                    </a>

                                    <!-- Opción: Manual de Usuario & Ayuda -->
                                    <a href="manual"
                                       class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 rounded-2 text-secondary"
                                       style="cursor: pointer; transition: all 0.15s ease;"
                                       @onclick="CloseUserDropdown">
                                        <i class="bi bi-book-half text-info fs-6"></i>
                                        <span style="font-size: 0.85rem;">Manual de Usuario & Ayuda</span>
                                    </a>

                                    <!-- Opción: Seguridad & Passkeys -->
                                    <a href="auth/passkeys"
                                       class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 rounded-2 text-secondary"
                                       style="cursor: pointer; transition: all 0.15s ease;"
                                       @onclick="CloseUserDropdown">
                                        <i class="bi bi-shield-lock text-success fs-6"></i>
                                        <span style="font-size: 0.85rem;">Seguridad & Passkeys</span>
                                    </a>

                                    <hr class="dropdown-divider my-1 opacity-25" />

                                    <!-- Opción: Salir / Cerrar Sesión -->
                                    <form method="post" action="/logout" class="m-0 p-0">
                                        <AntiforgeryToken />
                                        <button type="submit"
                                                class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 rounded-2 text-danger w-100 border-0 bg-transparent text-start"
                                                style="cursor: pointer; transition: all 0.15s ease;"
                                                title="Cerrar sesión">
                                            <i class="bi bi-box-arrow-right fs-6"></i>
                                            <span style="font-size: 0.85rem; font-weight: 500;">Cerrar sesión</span>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </header>

                <!-- Page Body (Responsive padding for mobile and 13"+ laptops) -->
                <main class="app-main-content flex-grow-1">
                    @Body
                </main>
            </div>

            <!-- 4. MOBILE BOTTOM NAVIGATION BAR (< 768px - Thumb-zone ergonomía) -->
            <nav class="mobile-bottom-bar d-flex d-md-none justify-content-around align-items-center">
                @foreach (var mod in _modules.Take(4))
                {
                    bool isActive = string.Equals(_activeModuleKey, mod.Key, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="mobile-bottom-btn @(isActive ? "active" : "")"
                            @onclick="() => OnBottomNavClick(mod)"
                            title="@mod.Name">
                        <i class="bi @mod.Icon mobile-bottom-icon"></i>
                        <span class="mobile-bottom-label">@mod.Name</span>
                        @if (isActive)
                        {
                            <span class="mobile-bottom-dot"></span>
                        }
                    </button>
                }
                <button type="button"
                        class="mobile-bottom-btn @(_isMobileDrawerOpen ? "active" : "")"
                        @onclick="ToggleMobileDrawer"
                        title="Menú de navegación">
                    <i class="bi @(_isMobileDrawerOpen ? "bi-x-lg text-primary" : "bi-grid-fill") mobile-bottom-icon"></i>
                    <span class="mobile-bottom-label">Menú</span>
                </button>
            </nav>

            <AntContainer />
            <SoftVoiceAssistantModal @bind-Visible="_showVoiceModal" />

            <!-- Floating Action Button: Acceso Inmediato al Asistente de Voz IA -->
            <button type="button"
                    class="soft-voice-fab shadow-lg"
                    @onclick="() => _showVoiceModal = true"
                    title="Dictado Rápido con IA">
                <i class="bi bi-mic-fill fs-4 voice-fab-icon"></i>
                <span class="soft-voice-fab-badge">IA</span>
            </button>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Unauthenticated View: Fullscreen Centered Login, Zero Menu -->
        <div class="min-vh-100 d-flex flex-column bg-light align-items-center justify-content-center p-3">
            @Body
            <AntContainer />
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _showVoiceModal;
    private bool _isSiderCollapsed;
    private bool _isMobileDrawerOpen;
    private bool _isUserDropdownOpen;
    private List<AppModuleDto> _modules = [];
    private string _activeModuleKey = "CONTRACTS";
    private string _activeModuleTitle = "Contratos";
    private string _activeModuleIcon = "bi-file-earmark-text";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        PreferencesService.OnChange += HandlePreferencesChanged;

        try
        {
            string? currentUserName = null;
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                currentUserName = auth.User.Identity?.Name;
            }

            await PreferencesService.InitializeAsync(currentUserName);
            _modules = PreferencesService.Modules.ToList();

            if (_modules.Any())
            {
                var currentMod = _modules.FirstOrDefault(m => string.Equals(m.Key, PreferencesService.ActiveModuleKey, StringComparison.OrdinalIgnoreCase)) ?? _modules.First();
                _activeModuleKey = currentMod.Key;
                _activeModuleTitle = currentMod.Name;
                _activeModuleIcon = currentMod.Icon;
            }
        }
        catch
        {
            // fallback
        }
    }

    private void HandlePreferencesChanged()
    {
        _modules = PreferencesService.Modules.ToList();
        if (_modules.Any())
        {
            var currentMod = _modules.FirstOrDefault(m => string.Equals(m.Key, PreferencesService.ActiveModuleKey, StringComparison.OrdinalIgnoreCase));
            if (currentMod != null)
            {
                _activeModuleKey = currentMod.Key;
                _activeModuleTitle = currentMod.Name;
                _activeModuleIcon = currentMod.Icon;
            }
        }
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("updateBrowserBranding", TenantContext.CurrentTenant.Name, TenantContext.CurrentTenant.SymbolUrl);
            }
            catch
            {
                // JavaScript runtime not available yet during prerender
            }
        }
    }

    private void ToggleSider()
    {
        _isSiderCollapsed = !_isSiderCollapsed;
    }

    private void ToggleMobileDrawer()
    {
        _isMobileDrawerOpen = !_isMobileDrawerOpen;
    }

    private void CloseMobileDrawer()
    {
        _isMobileDrawerOpen = false;
    }

    private void SelectModule(AppModuleDto module)
    {
        if (string.Equals(_activeModuleKey, module.Key, StringComparison.OrdinalIgnoreCase) && !_isSiderCollapsed)
        {
            // Si hace clic en el mismo módulo ya abierto, colapsa el menú
            _isSiderCollapsed = true;
        }
        else
        {
            _activeModuleKey = module.Key;
            _activeModuleTitle = module.Name;
            _activeModuleIcon = module.Icon;
            _isSiderCollapsed = false; // Despliega siempre al cambiar de módulo
            PreferencesService.SetActiveModule(module.Key);
        }
    }

    private void SelectMobileModule(AppModuleDto module)
    {
        _activeModuleKey = module.Key;
        _activeModuleTitle = module.Name;
        _activeModuleIcon = module.Icon;
        PreferencesService.SetActiveModule(module.Key);
    }

    private void OnBottomNavClick(AppModuleDto module)
    {
        if (string.Equals(_activeModuleKey, module.Key, StringComparison.OrdinalIgnoreCase))
        {
            // Abre o cierra el drawer al pulsar el módulo actual
            _isMobileDrawerOpen = !_isMobileDrawerOpen;
        }
        else
        {
            SelectMobileModule(module);
            _isMobileDrawerOpen = true;
        }
    }

    private void ToggleUserDropdown()
    {
        _isUserDropdownOpen = !_isUserDropdownOpen;
    }

    private void CloseUserDropdown()
    {
        _isUserDropdownOpen = false;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _isMobileDrawerOpen = false;
        _isUserDropdownOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        PreferencesService.OnChange -= HandlePreferencesChanged;
    }
}

@page "/dashboard"
@attribute [Authorize]

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-4 bg-white rounded-3 shadow-sm border-0 d-flex align-items-center justify-content-between flex-wrap gap-3" style="border-left: 4px solid var(--brand-primary, #701C2C) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex p-2 rounded-3 shadow-xs" style="background: linear-gradient(135deg, #701C2C 0%, #4D0E1A 100%); border: 1.5px solid rgba(212, 175, 55, 0.45);">
                        <img src="images/pomona-symbol-white.png" alt="Pomona" style="width: 40px; height: 40px; object-fit: contain;" />
                    </div>
                    <div>
                        <h2 class="fw-bold text-dark m-0" style="font-family: 'Cinzel', 'Playfair Display', Georgia, serif; letter-spacing: 1px;">
                            POMONA <span style="font-size: 1.05rem; color: #D4AF37; font-family: sans-serif; font-weight: 600;">Joyería & Relojería</span>
                        </h2>
                        <p class="text-muted mb-0 small">Sistema Integral de Operaciones para Joyería, Empeños, Relojería, Caja y Facturación.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-file-earmark-text text-primary fs-3 me-2"></i>
                        <h5 class="card-title mb-0 fw-bold">Contratos</h5>
                    </div>
                    <p class="card-text text-muted">Gestión de contratos de compraventa, empeño, abonos y control de saldos.</p>
                    <a href="contracts" class="btn btn-outline-primary btn-sm">Ver Contratos</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-box-seam text-warning fs-3 me-2"></i>
                        <h5 class="card-title mb-0 fw-bold">Inventario</h5>
                    </div>
                    <p class="card-text text-muted">Control de stock de joyas de oro y relojería por marca y características.</p>
                    <a href="inventory" class="btn btn-outline-warning btn-sm">Ver Inventario</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-shield-lock text-success fs-3 me-2"></i>
                        <h5 class="card-title mb-0 fw-bold">Seguridad & Passkeys</h5>
                    </div>
                    <p class="card-text text-muted">Autenticación moderna biométrica FIDO2 / WebAuthn y doble factor (TOTP).</p>
                    <a href="auth/passkeys" class="btn btn-outline-success btn-sm">Configurar Passkeys</a>
                </div>
            </div>
        </div>
    </div>
</div>

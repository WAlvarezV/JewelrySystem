<!DOCTYPE html>
<html lang="es" data-theme="pomona-imperial">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pomona Joyería & Relojería</title>
    <base href="/" />

    <!-- Brand Favicons & Touch Icons (Dynamic per Tenant) -->
    <link id="app-favicon" rel="icon" type="image/svg+xml" href="images/pomona-symbol-white.png" />
    <link id="app-apple-icon" rel="apple-touch-icon" sizes="180x180" href="images/pomona-symbol-white.png" />

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Ant Design Blazor & Pomona Luxury Design System -->
    <link href="_content/AntDesign/css/ant-design-blazor.css" rel="stylesheet" />
    <link href="css/soft-ui.css" rel="stylesheet" />

    <!-- Immediate theme and favicon initializer before render to avoid FOUC -->
    <script>
        window.updateBrowserBranding = function(title, symbolUrl) {
            try {
                if (title) {
                    document.title = title;
                }
                if (symbolUrl) {
                    var links = document.querySelectorAll("link[rel*='icon'], link[rel='apple-touch-icon']");
                    links.forEach(function(link) {
                        link.href = symbolUrl;
                    });
                }
            } catch(e) {}
        };

        window.applyPomonaTheme = function(themeName) {
            themeName = themeName || localStorage.getItem('pomona_theme') || 'pomona-imperial';
            try {
                localStorage.setItem('pomona_theme', themeName);
            } catch(e) {}
            document.documentElement.setAttribute('data-theme', themeName);
            if (document.body) {
                document.body.setAttribute('data-theme', themeName);
            }
            window.dispatchEvent(new CustomEvent('pomona-theme-changed', { detail: { theme: themeName } }));
        };

        window.setPomonaTheme = function(themeName) {
            window.applyPomonaTheme(themeName);
        };

        window.switchTenant = function(tenantId, defaultTheme) {
            try {
                localStorage.setItem('active_tenant', tenantId);
                if (defaultTheme) {
                    localStorage.setItem('pomona_theme', defaultTheme);
                }
                document.cookie = "active_tenant=" + encodeURIComponent(tenantId) + "; path=/; max-age=31536000; SameSite=Lax";
                if (defaultTheme) {
                    document.cookie = "pomona_theme=" + encodeURIComponent(defaultTheme) + "; path=/; max-age=31536000; SameSite=Lax";
                }
            } catch(e) {}
            window.location.href = "/api/tenants/switch?tenantId=" + encodeURIComponent(tenantId) + "&returnUrl=" + encodeURIComponent(window.location.pathname);
        };

        // Run immediately on page load
        (function() {
            try {
                var tenant = localStorage.getItem('active_tenant') || 'pomona';
                var defaultTheme = (tenant === 'oro-plata') ? 'oroplata-classic' : 'pomona-imperial';
                var theme = localStorage.getItem('pomona_theme') || defaultTheme;
                document.documentElement.setAttribute('data-theme', theme);

                var isOroPlata = (tenant === 'oro-plata');
                var symbolUrl = isOroPlata ? 'images/tenants/oro-plata/oroplata-symbol.svg' : 'images/pomona-symbol-white.png';
                var title = isOroPlata ? 'Joyería Oro & Plata' : 'Pomona Joyería & Relojería';

                document.title = title;
                var links = document.querySelectorAll("link[rel*='icon'], link[rel='apple-touch-icon']");
                links.forEach(function(link) {
                    link.href = symbolUrl;
                });

                document.addEventListener('DOMContentLoaded', function() {
                    if (document.body) {
                        document.body.setAttribute('data-theme', theme);
                    }
                });
            } catch(e) {}
        })();
    </script>

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/AntDesign/js/ant-design-blazor.js"></script>
    <script src="js/webauthn-interop.js"></script>
    <script src="js/speech-recognition.js"></script>
</body>

</html>

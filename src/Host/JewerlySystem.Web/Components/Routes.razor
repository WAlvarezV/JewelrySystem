@using System.Reflection
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using JewerlySystem.Modules.Auth.Presentation.Pages

<Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="AdditionalAssemblies">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <div class="container text-center my-5 p-5 bg-white rounded-3 shadow-sm border" style="max-width: 600px;">
                        <i class="bi bi-shield-x text-danger display-2 mb-3 d-block"></i>
                        <h3 class="fw-bold text-dark">Acceso Restringido</h3>
                        <p class="text-muted">No cuenta con los permisos necesarios asignados a su rol para acceder a esta sección.</p>
                        <a href="/contracts" class="btn btn-primary px-4 py-2 mt-2">
                            <i class="bi bi-arrow-left me-2"></i>Ir al Módulo Principal
                        </a>
                    </div>
                }
                else
                {
                    <Login />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Lo sentimos, no hay nada en esta dirección.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static readonly Assembly[] AdditionalAssemblies = new[]
    {
        typeof(Modules.Auth.Presentation.Pages.Login).Assembly,
        typeof(Modules.Contracts.Presentation.Pages.ContractsList).Assembly,
        typeof(Modules.Inventory.Presentation.Pages.InventoryList).Assembly,
        typeof(Modules.Cash.Presentation.Pages.CashDaily).Assembly,
        typeof(Modules.Customers.Presentation.Pages.CustomersList).Assembly,
        typeof(Modules.Invoicing.Presentation.Pages.InvoicingList).Assembly,
    };
}

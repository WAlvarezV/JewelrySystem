@namespace JewerlySystem.Common.Presentation.Components.Organisms

<Drawer Visible="@Visible"
        Title="@Title"
        Width="@EffectiveWidth"
        Placement="@Placement"
        Closable="true"
        MaskClosable="@MaskClosable"
        Class="soft-drawer"
        OnClose="@OnClose">
    <div class="soft-drawer-body">
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <div class="soft-drawer-desc-banner">
                @Description
            </div>
        }
        @ChildContent
    </div>
    @if (EffectiveFooter != null)
    {
        <div class="soft-drawer-footer">
            @EffectiveFooter
        </div>
    }
</Drawer>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public object? Width { get; set; } = "720";
    [Parameter] public DrawerPlacement Placement { get; set; } = DrawerPlacement.Right;
    [Parameter] public bool MaskClosable { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private string EffectiveWidth => Width?.ToString() ?? "720";
    private RenderFragment? EffectiveFooter => Footer ?? FooterContent;
}

@namespace JewerlySystem.Common.Presentation.Components.Atoms

@if (!string.IsNullOrWhiteSpace(Tooltip))
{
    <Tooltip Title="@Tooltip">
        <Button Shape="@ButtonShape.Circle"
                Type="@Type"
                Icon="@Icon"
                Danger="@Danger"
                Disabled="@Disabled"
                Class="soft-action-btn"
                OnClick="@OnClick" />
    </Tooltip>
}
else
{
    <Button Shape="@ButtonShape.Circle"
            Type="@Type"
            Icon="@Icon"
            Danger="@Danger"
            Disabled="@Disabled"
            Class="soft-action-btn"
            OnClick="@OnClick" />
}

@code {
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public ButtonType Type { get; set; } = ButtonType.Default;
    [Parameter] public string Icon { get; set; } = "edit";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}

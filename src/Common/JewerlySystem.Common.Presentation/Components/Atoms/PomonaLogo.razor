@namespace JewerlySystem.Common.Presentation.Components.Atoms
@using JewerlySystem.Common.Application
@inject IServiceProvider ServiceProvider

<div class="pomona-logo-wrapper d-inline-flex align-items-center gap-2 @Class" style="@Style">
    @if (Variant == LogoVariant.SymbolOnly || Variant == LogoVariant.FullHorizontal || Variant == LogoVariant.FullVertical)
    {
        <div class="pomona-symbol-container d-inline-flex align-items-center justify-content-center"
             style="width: @(Size)px; height: @(Size)px; min-width: @(Size)px; @GetContainerStyle()">
            <img src="@GetImageSrc()"
                 alt="@GetTitle()"
                 style="width: 100%; height: 100%; object-fit: contain; @GetImgFilterStyle()" />
        </div>
    }

    @if (Variant == LogoVariant.FullHorizontal)
    {
        <div class="pomona-brand-text d-flex flex-column text-start">
            <span class="pomona-title fw-bold" style="font-family: 'Cinzel', 'Playfair Display', 'Times New Roman', Georgia, serif; font-size: @(Size * 0.45)px; line-height: 1.1; letter-spacing: 2px; color: @GetTextColor();">
                @GetTitle()
            </span>
            <span class="pomona-subtitle text-uppercase" style="font-size: @(Size * 0.22)px; letter-spacing: 1.5px; font-weight: 600; color: @GetSubtitleColor();">
                @GetSubtitle()
            </span>
        </div>
    }
    else if (Variant == LogoVariant.FullVertical)
    {
        <div class="pomona-brand-text d-flex flex-column text-center mt-1">
            <span class="pomona-title fw-bold" style="font-family: 'Cinzel', 'Playfair Display', 'Times New Roman', Georgia, serif; font-size: @(Size * 0.4)px; line-height: 1.1; letter-spacing: 2px; color: @GetTextColor();">
                @GetTitle()
            </span>
            <span class="pomona-subtitle text-uppercase" style="font-size: @(Size * 0.2)px; letter-spacing: 1.5px; font-weight: 600; color: @GetSubtitleColor();">
                @GetSubtitle()
            </span>
        </div>
    }
</div>

@code {
    public enum LogoVariant
    {
        SymbolOnly,
        FullHorizontal,
        FullVertical
    }

    public enum LogoColor
    {
        White,
        Burgundy,
        Gold,
        OriginalSquare
    }

    [Parameter] public int Size { get; set; } = 36;
    [Parameter] public LogoVariant Variant { get; set; } = LogoVariant.SymbolOnly;
    [Parameter] public LogoColor Color { get; set; } = LogoColor.White;
    [Parameter] public bool WithBox { get; set; } = false;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string Style { get; set; } = string.Empty;

    private ITenantContext? _tenantContext;

    protected override void OnInitialized()
    {
        _tenantContext = ServiceProvider.GetService(typeof(ITenantContext)) as ITenantContext;
    }

    private string GetTitle() =>
        _tenantContext?.CurrentTenant.ShortName ?? "POMONA";

    private string GetSubtitle() =>
        _tenantContext?.CurrentTenant.Name ?? "Joyería & Relojería";

    private string GetImageSrc()
    {
        if (_tenantContext?.CurrentTenant.Id == "oro-plata")
        {
            return _tenantContext.CurrentTenant.SymbolUrl;
        }

        return Color switch
        {
            LogoColor.Burgundy => "images/pomona-symbol-burgundy.png",
            LogoColor.Gold => "images/pomona-symbol-gold.png",
            LogoColor.OriginalSquare => "images/pomona-logo-square.png",
            _ => "images/pomona-symbol-white.png"
        };
    }

    private string GetContainerStyle()
    {
        if (!WithBox) return string.Empty;
        return "background: var(--brand-primary-gradient, linear-gradient(135deg, #701C2C 0%, #4D0E1A 100%)); border: 1px solid rgba(212, 175, 55, 0.4); border-radius: 8px; padding: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.25);";
    }

    private string GetImgFilterStyle() =>
        Color == LogoColor.Gold ? "filter: drop-shadow(0 0 4px rgba(212, 175, 55, 0.4));" : string.Empty;

    private string GetTextColor() =>
        Color == LogoColor.Burgundy ? "var(--brand-primary, #701C2C)" : (Color == LogoColor.Gold ? "#D4AF37" : "#FFFFFF");

    private string GetSubtitleColor() =>
        Color == LogoColor.Burgundy ? "#8B293C" : (Color == LogoColor.Gold ? "#E6CA65" : "rgba(254, 254, 246, 0.85)");
}

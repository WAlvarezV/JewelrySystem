@namespace JewerlySystem.Common.Presentation.Components.Atoms
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IMessageService MessageService

<div class="soft-voice-button-container d-inline-flex align-items-center flex-wrap gap-1">
    <button type="button"
            class="btn @(_isListening ? "btn-danger pulse-recording" : ButtonClass) btn-sm d-inline-flex align-items-center gap-1"
            title="@(_isListening ? "Detener dictado por voz" : TooltipText)"
            @onclick="ToggleListeningAsync">
        <i class="bi @(_isListening ? "bi-mic-fill" : "bi-mic")"></i>
        @if (!string.IsNullOrEmpty(Label))
        {
            <span>@(_isListening ? "Detener" : Label)</span>
        }
    </button>
    @if (_isListening && ShowBadge)
    {
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle small pulse-badge d-inline-flex align-items-center">
            <span class="recording-dot"></span> Escuchando...
        </span>
    }
</div>

<style>
    .pulse-recording {
        animation: softPulse 1.5s infinite;
        background-color: #dc3545 !important;
        border-color: #dc3545 !important;
        color: #ffffff !important;
    }

    @@keyframes softPulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 8px rgba(220, 53, 69, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }

    .recording-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        background-color: #dc3545;
        border-radius: 50%;
        margin-right: 4px;
        animation: blink 0.8s infinite alternate;
    }

    @@keyframes blink {
        from { opacity: 0.2; }
        to { opacity: 1; }
    }
</style>

@code {
    [Parameter] public string? TargetText { get; set; }
    [Parameter] public EventCallback<string> TargetTextChanged { get; set; }

    [Parameter] public EventCallback<string> OnTranscribed { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string TooltipText { get; set; } = "Dictar descripción por voz";
    [Parameter] public string ButtonClass { get; set; } = "btn-outline-secondary";
    [Parameter] public string Language { get; set; } = "es-CO";
    [Parameter] public bool Append { get; set; } = true;
    [Parameter] public bool ShowBadge { get; set; } = true;

    [Parameter] public bool IsListening { get; set; }
    [Parameter] public EventCallback<bool> IsListeningChanged { get; set; }
    [Parameter] public EventCallback<string> InterimTranscriptChanged { get; set; }

    private bool _isListening;
    private DotNetObjectReference<SoftVoiceButton>? _dotNetHelper;

    protected override void OnInitialized()
    {
        _dotNetHelper = DotNetObjectReference.Create(this);
    }

    [JSInvokable]
    public async Task OnSpeechStateChanged(bool isListening)
    {
        _isListening = isListening;
        if (!isListening)
        {
            await InterimTranscriptChanged.InvokeAsync(string.Empty);
        }
        await IsListeningChanged.InvokeAsync(_isListening);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSpeechResult(string finalTranscript, string interimTranscript)
    {
        await InterimTranscriptChanged.InvokeAsync(interimTranscript ?? string.Empty);

        if (!string.IsNullOrWhiteSpace(finalTranscript))
        {
            string newText = finalTranscript.Trim();
            if (Append && !string.IsNullOrWhiteSpace(TargetText))
            {
                TargetText = $"{TargetText.Trim()} {newText}";
            }
            else
            {
                TargetText = newText;
            }

            await TargetTextChanged.InvokeAsync(TargetText);
            await OnTranscribed.InvokeAsync(TargetText);
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSpeechError(string error)
    {
        MessageService.Warning(error);
        _isListening = false;
        await IsListeningChanged.InvokeAsync(false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleListeningAsync()
    {
        if (_isListening)
        {
            await JSRuntime.InvokeVoidAsync("jewelrySpeech.stop");
            _isListening = false;
            await IsListeningChanged.InvokeAsync(false);
        }
        else
        {
            if (_dotNetHelper == null)
            {
                _dotNetHelper = DotNetObjectReference.Create(this);
            }
            await JSRuntime.InvokeVoidAsync("jewelrySpeech.start", _dotNetHelper, Language);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_isListening)
            {
                await JSRuntime.InvokeVoidAsync("jewelrySpeech.stop");
            }
            _dotNetHelper?.Dispose();
        }
        catch
        {
            // Silent cleanup
        }
    }
}

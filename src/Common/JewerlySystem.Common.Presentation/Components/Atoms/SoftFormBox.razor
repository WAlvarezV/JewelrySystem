@namespace JewerlySystem.Common.Presentation.Components.Atoms

<div class="soft-form-box">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="soft-form-box-header">
            <div class="d-flex align-items-center gap-2">
                <h5 class="soft-form-box-title mb-0">@Title</h5>
                @if (!string.IsNullOrWhiteSpace(InfoTooltip))
                {
                    <Tooltip Title="@InfoTooltip">
                        <i class="bi bi-info-circle text-muted" style="cursor: pointer; font-size: 0.95rem;"></i>
                    </Tooltip>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <span class="soft-form-box-subtitle">@Subtitle</span>
            }
        </div>
    }
    <div class="soft-form-box-content">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? InfoTooltip { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

@using Microsoft.JSInterop
@using JewerlySystem.Common.Application.Inventory
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IInventoryImageService ImageService
@inject IMessageService Message

<Modal Visible="@Visible"
       VisibleChanged="@VisibleChanged"
       Title="@Title"
       Footer="@null"
       Width="720"
       Centered="true"
       DestroyOnClose="true"
       Class="soft-mobile-sheet-modal"
       OnCancel="@CloseModal">

    <div class="photo-studio-modal">
        <p class="studio-description text-muted mb-3">
            @Subtitle
        </p>

        <!-- Inputs para captura nativa del celular y explorador de archivos -->
        <input type="file"
               id="@_cameraInputId"
               accept="image/*"
               capture="environment"
               style="position: absolute; opacity: 0; width: 0.1px; height: 0.1px; overflow: hidden; z-index: -1;"
               @onchange="() => HandleFileChosenAsync(_cameraInputId)" />

        <input type="file"
               id="@_fileInputId"
               accept="image/png, image/jpeg, image/webp, image/*"
               style="position: absolute; opacity: 0; width: 0.1px; height: 0.1px; overflow: hidden; z-index: -1;"
               @onchange="() => HandleFileChosenAsync(_fileInputId)" />

        @if (!string.IsNullOrEmpty(_processedPreviewDataUrl))
        {
            <!-- 1. Vista Previa de la Imagen Procesada -->
            <div class="preview-container text-center">
                <div class="preview-frame shadow-sm border rounded">
                    <img src="@(_showRaw ? _rawPhotoUrl : _processedPreviewDataUrl)" alt="Previsualización de Joya / Reloj" class="img-fluid rounded" />
                </div>

                <div class="d-flex justify-content-center align-items-center gap-2 mt-3 flex-wrap">
                    @if (!_isFallback)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                            <i class="bi bi-check2-all me-1"></i> Fondo Blanco Vitrina (#FFFFFF)
                        </span>
                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1">
                            <i class="bi bi-shield-check me-1"></i> Sello Universal de Calidad
                        </span>
                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                            <i class="bi bi-file-earmark-image me-1"></i> WebP Optimizado
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                            <i class="bi bi-shield-fill-check me-1"></i> Foto Original Asegurada en Servidor
                        </span>
                    }

                    @if (!string.IsNullOrEmpty(_rawPhotoUrl) && _rawPhotoUrl != _processedPreviewDataUrl)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="() => _showRaw = !_showRaw">
                            <i class="bi @(_showRaw ? "bi-magic" : "bi-eye") me-1"></i>
                            @(_showRaw ? "Ver con Fondo Blanco y Sello" : "Ver Foto Original sin Editar")
                        </button>
                    }
                </div>

                <div class="d-flex justify-content-center align-items-center flex-wrap gap-2 gap-sm-3 mt-4">
                    <Button Type="@ButtonType.Default"
                            Size="@ButtonSize.Large"
                            Class="flex-grow-1 flex-sm-grow-0"
                            OnClick="@ResetProcessing"
                            Disabled="@_isSaving">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Repetir Fotografía
                    </Button>

                    <Button Type="@ButtonType.Primary"
                            Size="@ButtonSize.Large"
                            Class="flex-grow-1 flex-sm-grow-0"
                            Loading="@_isSaving"
                            OnClick="@ConfirmAndSaveAsync">
                        <i class="bi bi-check-circle me-1"></i> Guardar y Asignar al Artículo
                    </Button>
                </div>
            </div>
        }
        else if (_isLiveCameraActive)
        {
            <!-- 2. Visor de Cámara Web / Cámara en Vivo en Pantalla -->
            <div class="live-camera-wrapper">
                <video id="@_videoElementId" autoplay playsinline muted class="live-video-player"></video>
                
                <div class="live-viewfinder-reticle">
                    <div class="reticle-corner top-left"></div>
                    <div class="reticle-corner top-right"></div>
                    <div class="reticle-corner bottom-left"></div>
                    <div class="reticle-corner bottom-right"></div>
                    <div class="reticle-guide-text">Encuadre la pieza aquí</div>
                </div>

                <div class="live-camera-controls">
                    <button type="button"
                            class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm"
                            @onclick="CaptureLiveCameraAsync"
                            disabled="@_isProcessing">
                        <i class="bi bi-camera-fill me-1"></i> Capturar Foto
                    </button>

                    <button type="button"
                            class="btn btn-outline-light rounded-pill px-3"
                            @onclick="SwitchCameraFacingAsync"
                            title="Alternar entre cámara frontal y trasera">
                        <i class="bi bi-arrow-repeat me-1"></i> Cambiar
                    </button>

                    <button type="button"
                            class="btn btn-secondary rounded-pill px-3"
                            @onclick="StopLiveCameraAsync">
                        Volver
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- 3. Panel de Opciones de Captura -->
            <div class="capture-actions-grid">
                <!-- Tarjeta 1: Cámara Nativa del Celular (vía label HTML nativo, sin bloqueos de navegador) -->
                <label for="@_cameraInputId" class="capture-card primary-capture">
                    <div class="icon-circle gold-circle">
                        <i class="bi bi-phone-fill"></i>
                    </div>
                    <h4>Cámara del Celular</h4>
                    <p>Abre la cámara trasera de su celular con enfoque táctil y máxima resolución física.</p>
                    <span class="btn btn-sm btn-primary rounded-pill px-3 mt-2">
                        <i class="bi bi-camera me-1"></i> Abrir Cámara
                    </span>
                </label>

                <!-- Tarjeta 2: Cámara Web en Pantalla (para Laptop/PC o navegador con Webcam) -->
                <div class="capture-card webrtc-capture" @onclick="StartLiveCameraAsync">
                    <div class="icon-circle blue-circle">
                        <i class="bi bi-camera-video-fill"></i>
                    </div>
                    <h4>Cámara Web / Visor</h4>
                    <p>Activa la cámara web de su PC o visor en vivo con recuadro de encuadre en pantalla.</p>
                    <span class="btn btn-sm btn-outline-primary rounded-pill px-3 mt-2">
                        <i class="bi bi-play-circle me-1"></i> Iniciar Visor
                    </span>
                </div>

                <!-- Tarjeta 3: Carga de Archivo / Galería -->
                <label for="@_fileInputId" class="capture-card secondary-capture">
                    <div class="icon-circle neutral-circle">
                        <i class="bi bi-images"></i>
                    </div>
                    <h4>Galería / Archivos</h4>
                    <p>Seleccione una foto existente (JPG, PNG, WebP) desde su fototeca o computador.</p>
                    <span class="btn btn-sm btn-outline-secondary rounded-pill px-3 mt-2">
                        <i class="bi bi-folder2-open me-1"></i> Explorar
                    </span>
                </label>
            </div>

            <div class="studio-specs-notice mt-3 p-3 rounded border">
                <div class="d-flex align-items-center gap-2 mb-1 text-primary fw-bold small">
                    <i class="bi bi-shield-check text-warning"></i>
                    <span>Garantía de Respaldo y Estandarización en Segundo Plano:</span>
                </div>
                <ul class="specs-list mb-0 small text-muted">
                    <li><i class="bi bi-check-circle-fill text-success me-1"></i> <strong>Respaldo instantáneo</strong>: la foto original del teléfono se asegura de inmediato en el servidor para que nunca se pierda.</li>
                    <li><i class="bi bi-check-circle-fill text-success me-1"></i> <strong>Procesamiento en segundo plano</strong>: motor SkiaSharp de servidor normaliza a fondo blanco (#FFFFFF) y estampa el sello universal de lujo.</li>
                    <li><i class="bi bi-check-circle-fill text-success me-1"></i> <strong>WebP ultraligero (&lt; 80 KB)</strong>: entrega máxima resolución en vitrina con carga instantánea en cualquier celular.</li>
                </ul>
            </div>
        }

        @if (_isProcessing)
        {
            <div class="processing-overlay">
                <Spin Tip="@(_processingStage ?? "Asegurando foto original y estandarizando en segundo plano...")" />
            </div>
        }
    </div>
</Modal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Estudio Fotográfico de Joyería & Relojes";
    [Parameter] public string Subtitle { get; set; } = "Fotografíe la pieza o cargue una imagen. Se respaldará de inmediato y se estandarizará a fondo blanco de vitrina (#FFFFFF).";
    [Parameter] public string Prefix { get; set; } = "item";
    [Parameter] public EventCallback<string> OnImageSaved { get; set; }

    private readonly string _cameraInputId = "camera_input_" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _fileInputId = "file_input_" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _videoElementId = "live_video_" + Guid.NewGuid().ToString("N")[..8];

    private bool _isProcessing = false;
    private string? _processingStage;
    private bool _isSaving = false;
    private bool _isLiveCameraActive = false;
    private bool _showRaw = false;
    private bool _isFallback = false;

    private string? _processedPreviewDataUrl;
    private string? _rawPhotoUrl;

    public class PhotoProcessResult
    {
        public string StandardizedUrl { get; set; } = string.Empty;
        public string RawUrl { get; set; } = string.Empty;
        public bool IsFallback { get; set; }
    }

    private async Task StartLiveCameraAsync()
    {
        _isProcessing = true;
        _processingStage = "Iniciando visor de cámara...";
        StateHasChanged();

        try
        {
            _isLiveCameraActive = true;
            StateHasChanged();

            await Task.Delay(100);
            await JSRuntime.InvokeVoidAsync("photoStudio.startLiveCamera", _videoElementId, "environment");
        }
        catch (Exception ex)
        {
            _isLiveCameraActive = false;
            Message.Warning(ex.Message);
        }
        finally
        {
            _isProcessing = false;
            _processingStage = null;
            StateHasChanged();
        }
    }

    private async Task StopLiveCameraAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("photoStudio.stopLiveCamera");
        }
        catch { }
        finally
        {
            _isLiveCameraActive = false;
            StateHasChanged();
        }
    }

    private async Task SwitchCameraFacingAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("photoStudio.switchLiveCamera", _videoElementId);
        }
        catch (Exception ex)
        {
            Message.Warning($"No se pudo cambiar de cámara: {ex.Message}");
        }
    }

    private async Task CaptureLiveCameraAsync()
    {
        _isProcessing = true;
        _processingStage = "Asegurando captura y estandarizando en segundo plano...";
        StateHasChanged();

        try
        {
            var result = await JSRuntime.InvokeAsync<PhotoProcessResult>("photoStudio.captureLiveFrame", _videoElementId, Prefix);
            _processedPreviewDataUrl = result.StandardizedUrl;
            _rawPhotoUrl = result.RawUrl;
            _isFallback = result.IsFallback;
            _showRaw = false;
            _isLiveCameraActive = false;
        }
        catch (Exception ex)
        {
            Message.Error($"Error capturando foto: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
            _processingStage = null;
            StateHasChanged();
        }
    }

    private async Task HandleFileChosenAsync(string inputId)
    {
        _isProcessing = true;
        _processingStage = "Asegurando fotografía en servidor y procesando en segundo plano...";
        StateHasChanged();

        try
        {
            var result = await JSRuntime.InvokeAsync<PhotoProcessResult>("photoStudio.processPhotoFromInput", inputId, Prefix);
            _processedPreviewDataUrl = result.StandardizedUrl;
            _rawPhotoUrl = result.RawUrl;
            _isFallback = result.IsFallback;
            _showRaw = false;

            await JSRuntime.InvokeVoidAsync("photoStudio.resetFileInput", inputId);

            if (_isFallback)
            {
                Message.Info("La fotografía fue asegurada exitosamente en el servidor.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error asegurando y procesando fotografía: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
            _processingStage = null;
            StateHasChanged();
        }
    }

    private void ResetProcessing()
    {
        _processedPreviewDataUrl = null;
        _rawPhotoUrl = null;
        _showRaw = false;
        _isFallback = false;
        StateHasChanged();
    }

    private async Task ConfirmAndSaveAsync()
    {
        var targetUrl = _showRaw ? _rawPhotoUrl : _processedPreviewDataUrl;
        if (string.IsNullOrEmpty(targetUrl)) return;

        _isSaving = true;
        StateHasChanged();

        try
        {
            string finalUrl = targetUrl;

            // Si por alguna razón vino como DataURL Base64, persistirlo
            if (targetUrl.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            {
                finalUrl = await ImageService.SaveBase64ImageAsync(targetUrl, Prefix);
            }

            Message.Success("¡Fotografía asegurada y asignada al artículo exitosamente!");

            if (OnImageSaved.HasDelegate)
            {
                await OnImageSaved.InvokeAsync(finalUrl);
            }

            await CloseModal();
        }
        catch (Exception ex)
        {
            Message.Error($"Error al guardar la fotografía: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task CloseModal()
    {
        await StopLiveCameraAsync();
        _processedPreviewDataUrl = null;
        _rawPhotoUrl = null;
        _showRaw = false;
        Visible = false;
        if (VisibleChanged.HasDelegate)
        {
            await VisibleChanged.InvokeAsync(false);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("photoStudio.stopLiveCamera");
        }
        catch { }
    }
}

@namespace JewerlySystem.Common.Presentation.Components.Molecules

<div class="soft-selection-card @(IsSelected ? "selected" : "")" @onclick="OnClick">
    @if (!string.IsNullOrWhiteSpace(IconType))
    {
        <div class="soft-selection-card-icon">
            <Icon Type="@IconType" Theme="@IconThemeType.Outline" />
        </div>
    }
    <div class="soft-selection-card-content">
        <h6 class="soft-selection-card-title">@Title</h6>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="soft-selection-card-desc">@Description</p>
        }
    </div>
    <div class="soft-selection-card-check">
        @if (IsSelected)
        {
            <Icon Type="check-circle" Theme="@IconThemeType.Fill" />
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? IconType { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
